---
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/resource-page.css';
import '../styles/utility-page.css';
---

<BaseLayout
  title="页面未找到 | 国晁动力"
  description="您访问的页面不存在。"
  currentPath="/404"
  noindex
>
  <section class="blog-details-section utility-section">
    <div class="section-gap bottom">
      <div class="container">
        <article class="blog-details-content-block resource-page fade-in utility-card">
          <h1>404 — 页面未找到</h1>
          <p>您访问的页面不存在或已被移动。</p>

          <nav class="utility-pill-nav" aria-label="有用链接">
            <a href="/" class="utility-pill-link">首页</a>
            <a href="/products/" class="utility-pill-link">发动机零件</a>
            <a href="/part-products/" class="utility-pill-link">MTU 零件号</a>
            <a href="/part-products/" class="utility-pill-link">资源</a>
            <a href="/contact/" class="utility-pill-link">零件核查</a>
          </nav>

          <a href="/contact/?source=404" class="primary-button dark-hover">
            <div class="button-content-block">
              <div class="button-text">发送零件询价</div>
              <div class="button-text">发送零件询价</div>
            </div>
          </a>
        </article>
      </div>
    </div>
  </section>
</BaseLayout>
