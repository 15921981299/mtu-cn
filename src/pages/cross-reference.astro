---
import BaseLayout from '../layouts/BaseLayout.astro';
import BreadcrumbHero from '../components/BreadcrumbHero.astro';
import FunnelPageView from '../components/FunnelPageView.astro';
import DetailRfqStrip from '../components/DetailRfqStrip.astro';
import { mtuParts } from '../data/mtu-parts';
import { getPartReferences } from '../data/part-references';
import { breadcrumbSchema, faqSchema, site } from '../data/site';
import { zhPartName } from '../data/part-names-zh';
import '../styles/resource-page.css';

/**
 * Cross-reference index: OEM / superseded / aftermarket part numbers →
 * catalog records. References do not independently prove interchangeability.
 */

type XrefRow = {
  altNumber: string;
  altDisplay: string;
  partNumber: string;
  partName: string;
  slug: string;
  relationship: string;
};

const normalize = (value: string) => value.toUpperCase().replace(/[^A-Z0-9]/g, '');

const rows: XrefRow[] = [];
for (const part of mtuParts) {
  const refs = getPartReferences(part).map((ref) => ({ num: ref.number, rel: ref.label }));
  for (const { num, rel } of refs) {
    const cleaned = num.trim();
    if (!cleaned || normalize(cleaned) === normalize(part.partNumber)) continue;
    rows.push({
      altNumber: normalize(cleaned),
      altDisplay: cleaned,
      partNumber: part.partNumber,
      partName: zhPartName(part.name),
      slug: part.slug,
      relationship: rel,
    });
  }
}

// Group by normalized alt number; one row per (alt, our part) pair.
const seen = new Set<string>();
const grouped = new Map<string, { display: string; targets: XrefRow[] }>();
for (const row of rows) {
  const pairKey = `${row.altNumber}|${row.partNumber}`;
  if (seen.has(pairKey)) continue;
  seen.add(pairKey);
  const entry = grouped.get(row.altNumber) ?? { display: row.altDisplay, targets: [] };
  if (row.altDisplay.length > entry.display.length) entry.display = row.altDisplay;
  entry.targets.push(row);
  grouped.set(row.altNumber, entry);
}
const groups = [...grouped.entries()]
  .map(([key, value]) => ({ key, ...value }))
  .sort((a, b) => a.key.localeCompare(b.key));

const pageUrl = `${site.url}/cross-reference/`;
const faqItems = [
  {
    question: '如何使用这份交叉引用清单？',
    answer:
      '将您标注的编号与目录记录对应。较早与较晚的标签描述该参考号相对于所链接目录零件的关系。仅作参考的行没有确认的替代方向。请打开零件页进行识别核查，并在下单前发送发动机详情。',
  },
  {
    question: '我的零件号不在清单中，你们还能供应吗？',
    answer:
      '请发送完整编号、发动机型号与出厂编号，以便进行采购核查。未收入本索引并不说明有货或无货。',
  },
  {
    question: '互换参考号是否意味着零件完全相同？',
    answer:
      '不是。这些是目录历史与相关编号参考，包括导入的公开目录数据。它们不能证明尺寸、状态或应用完全相同。替换前请确认所供确切编号、发动机出厂编号区间以及任何配合件变更。',
  },
];
---

<BaseLayout
  title="零件号交叉引用 — MTU、Detroit Diesel 与 DEUTZ 替代号"
  description={`查询 ${groups.length} 个目录参考编号，以及较早与较晚的零件号历史。跟随所链接的零件记录，并申请针对具体应用的替代核验。`}
  currentPath="/cross-reference"
  jsonLd={[
    breadcrumbSchema([
      { name: '首页', url: site.url },
      { name: '零件号交叉引用', url: pageUrl },
    ]),
    faqSchema(faqItems),
  ]}
>
  <FunnelPageView stage="comparison" label="cross-reference-index" />
  <BreadcrumbHero
    title="零件号交叉引用"
    trail={[{ label: '首页', href: '/' }, { label: '零件号交叉引用' }]}
    variant="2"
  />

  <div class="resource-page">
    <section class="resource-page-section">
      <p>
        手头有 OEM 号、被替代号或其他供应商的零件号？本索引列出
        <strong>{groups.length} 个目录参考编号</strong>及其链接的零件记录。
        较早与较晚的标签描述公开的目录历史；无方向参考不构成互换性认定。导入的目录数据仅作识别辅助，不代表经供应商确认的适配。
      </p>
      <p>
        在下方输入任意零件号片段即可筛选列表，然后打开所链接的零件页查看适配、重量、HS 编码与供货情况。如果您的编号不在清单中，请连同发动机型号与出厂编号一并发来——我们报价前人工核验互换性。
      </p>
      <p>
        需要的是完整清单而非替代号？<a href="/part-number-index/">零件号索引</a>收录全部已索引编号，含英文与德文名称。对于按功率分组的发电机组发动机，请参阅<a href="/products/mtu-spare-parts/mtu-genset-parts-by-power/">按功率分组的 MTU 发电机组零件</a>。
      </p>
    </section>

    <section class="resource-page-section">
      <div class="xref-filter">
        <input
          type="search"
          id="xref-filter-input"
          placeholder="输入零件号片段，如 4570500127 或 A5410500227"
          aria-label="筛选交叉引用列表"
          autocomplete="off"
        />
        <span class="xref-filter__count" id="xref-count">{groups.length} 条引用</span>
      </div>
      <div class="xref-table-wrap">
        <table class="xref-table" id="xref-table">
          <thead>
            <tr>
              <th scope="col">您的零件号</th>
              <th scope="col">对应目录编号</th>
              <th scope="col">引用关系</th>
              <th scope="col">零件</th>
            </tr>
          </thead>
          <tbody>
            {groups.map((group) =>
              group.targets.map((target, i) => (
                <tr data-xref-key={`${group.key} ${target.partNumber}`}>
                  <td class="xref-alt">{i === 0 ? group.display : `↳ ${group.display}`}</td>
                  <td>
                    <a href={`/part-products/${target.slug}/`}>{target.partNumber}</a>
                  </td>
                  <td>{target.relationship}</td>
                  <td>{target.partName}</td>
                </tr>
              )),
            )}
          </tbody>
        </table>
        <p class="xref-empty" id="xref-empty" hidden>
          目录索引中无匹配项。<a href="/contact/?source=xref-not-found" data-rfq-modal data-rfq-source="xref-not-found" data-rfq-context="未收录零件号寻源核查">把编号发给我们</a>——
          我们人工核查互换性。
        </p>
      </div>
    </section>

    <section class="resource-page-section">
      <h2>交叉引用常见问题</h2>
      {faqItems.map((item) => (
        <details class="resource-faq-item">
          <summary>{item.question}</summary>
          <p>{item.answer}</p>
        </details>
      ))}
    </section>

    <DetailRfqStrip
      title="找不到您的编号？"
      text="发送零件号、发动机型号与出厂编号。我们会在报价前核验互换选项与供货情况。"
      quoteHref="/contact/?source=cross-reference"
      label="核查我的零件号"
      modalSource="cross-reference"
    />
  </div>
</BaseLayout>

<script>
  const input = document.getElementById('xref-filter-input') as HTMLInputElement | null;
  const table = document.getElementById('xref-table');
  const empty = document.getElementById('xref-empty');
  const count = document.getElementById('xref-count');
  const rows = table ? Array.from(table.querySelectorAll<HTMLTableRowElement>('tbody tr')) : [];

  input?.addEventListener('input', () => {
    const q = input.value.toUpperCase().replace(/[^A-Z0-9]/g, '');
    let visible = 0;
    for (const row of rows) {
      const key = (row as HTMLElement).dataset.xrefKey?.toUpperCase().replace(/[^A-Z0-9]/g, '') ?? '';
      const show = !q || key.includes(q);
      row.style.display = show ? '' : 'none';
      if (show) visible++;
    }
    if (empty) empty.hidden = visible > 0;
    if (count) count.textContent = q ? `${visible} 条匹配` : `${rows.length} 条引用`;
  });
</script>

<style>
  .xref-filter {
    display: flex;
    gap: 12px;
    align-items: center;
    margin-bottom: 16px;
  }

  .xref-filter input {
    flex: 1;
    border: 1px solid var(--color-stroke, #d7dee8);
    border-radius: 6px;
    padding: 12px 14px;
    font: inherit;
  }

  .xref-filter__count {
    color: #64748b;
    font-size: 14px;
    white-space: nowrap;
  }

  .xref-table-wrap {
    overflow-x: auto;
  }

  .xref-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 15px;
  }

  .xref-table th,
  .xref-table td {
    padding: 10px 12px;
    border-bottom: 1px solid #e2e8f0;
    text-align: left;
    vertical-align: top;
  }

  .xref-table th {
    background: #f8fafc;
    font-weight: 700;
  }

  .xref-alt {
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-weight: 600;
    white-space: nowrap;
  }

  .xref-table a {
    color: var(--color-primary, #146ef5);
    font-weight: 700;
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
  }

  .xref-empty {
    padding: 24px;
    text-align: center;
    color: #475569;
  }

  .resource-faq-item {
    border: 1px solid #e2e8f0;
    border-radius: 8px;
    padding: 14px 16px;
    margin-bottom: 10px;
  }

  .resource-faq-item summary {
    cursor: pointer;
    font-weight: 700;
  }

  .resource-faq-item p {
    margin: 10px 0 0;
    color: #475569;
    line-height: 1.6;
  }
</style>
