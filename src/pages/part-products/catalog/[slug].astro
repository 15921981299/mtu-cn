---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import BreadcrumbHero from '../../../components/BreadcrumbHero.astro';
import BlogCta from '../../../components/BlogCta.astro';
import FunnelPageView from '../../../components/FunnelPageView.astro';
import ProcurementBrief from '../../../components/ProcurementBrief.astro';
import QuotationExamples from '../../../components/QuotationExamples.astro';
import { allCatalogAssemblies } from '../../../data/part-assemblies';
import { catalogProcurement } from '../../../data/procurement-content';
import { isRealPartImage, mtuCatalogHubs, mtuParts, searchPriorityPartRank, type MtuCatalogHub } from '../../../data/mtu-parts';
import { zhCategoryName, zhEngineType, zhPartName, zhPartNameBilingual, zhSeriesLabel } from '../../../data/part-names-zh';
import { breadcrumbSchema, itemListSchema, site } from '../../../data/site';
import '../../../styles/resource-page.css';

export function getStaticPaths() {
  return mtuCatalogHubs.map((hub) => ({ params: { slug: hub.slug }, props: { hub } }));
}

const { hub } = Astro.props as { hub: MtuCatalogHub };
const parts = mtuParts.filter(hub.partFilter);
const drawingGroups = ['mtu-396-series', 'mtu-1163-series', 'mtu-956-series'].includes(hub.slug)
  ? allCatalogAssemblies.filter((assembly) => assembly.parts.some((item) => parts.some((part) => part.partNumber === item.partNumber))) : [];
const pageUrl = `${site.url}/part-products/catalog/${hub.slug}/`;
const quoteHref = `/contact/?source=catalog-${hub.slug}`;
const catalogHeading = /零件|目录/.test(hub.h1Title) ? hub.h1Title : `${hub.h1Title}零件目录`;
const seriesGuideLinks: Record<string, { href: string; label: string }> = {
  'mtu-2000-series': { href: '/series/mtu-2000/', label: 'MTU 2000 型号识别' },
  'mtu-396-series': { href: '/series/mtu-396/', label: 'MTU 396 型号识别' },
  'mtu-1163-series': { href: '/series/mtu-1163/', label: 'MTU 1163 型号识别' },
  'mtu-4000-series': { href: '/series/mtu-4000-variants/', label: 'MTU 4000 型号变型' },
};
const seriesGuide = seriesGuideLinks[hub.slug];

// For series hubs: group by category. For category hubs: group by engine series.
const categoryGroups = new Map<string, typeof parts>();
for (const part of parts) {
  const groupKeys = hub.type === 'series'
    ? [part.category]
    : part.series.length > 0
      ? part.series.map(zhSeriesLabel)
      : [part.engineType ?? '按发动机出厂编号核验'];

  for (const key of groupKeys) {
    if (!categoryGroups.has(key)) categoryGroups.set(key, []);
    categoryGroups.get(key)!.push(part);
  }
}

// 分组键展示层映射：类别键→中文类别名；核验哨兵→中文；机型标签→中文机型名
const zhGroupKey = (key: string) =>
  key === '按发动机出厂编号核验'
    ? '按出厂编号核验'
    : /ENGINES?$/i.test(key)
      ? zhEngineType(key)
      : zhCategoryName(key);

const groupLabel = hub.type === 'series' ? 'category' : 'series';
const featuredParts = [...parts]
  .sort((a, b) => {
    const rankDifference = (searchPriorityPartRank.get(a.partNumber.toUpperCase()) ?? Infinity) -
      (searchPriorityPartRank.get(b.partNumber.toUpperCase()) ?? Infinity);
    if (rankDifference && !Number.isNaN(rankDifference)) return rankDifference;
    const bScore =
      Number(isRealPartImage(b.image)) * 4 +
      Number(Boolean(b.engineType && b.dimensions && b.weightKg && b.hsCode)) * 3 +
      Number(Boolean(b.replacementFor?.length)) * 2 +
      Number(Boolean(b.applicableEngines));
    const aScore =
      Number(isRealPartImage(a.image)) * 4 +
      Number(Boolean(a.engineType && a.dimensions && a.weightKg && a.hsCode)) * 3 +
      Number(Boolean(a.replacementFor?.length)) * 2 +
      Number(Boolean(a.applicableEngines));
    return bScore - aScore || a.partNumber.localeCompare(b.partNumber);
  })
  .filter((part) => part.specificationChecks?.length)
  .slice(0, 8);
const hasPublishedSizes = featuredParts.some((part) => Boolean(part.dimensions));
const partSlugSet = new Set(parts.map((part) => part.slug));
const relatedCatalogHubs = mtuCatalogHubs
    .filter((h) => h.slug !== hub.slug)
  .map((h) => ({
    hub: h,
    overlap: mtuParts.filter(h.partFilter).filter((part) => partSlugSet.has(part.slug)).length,
    crossTypeBoost: h.type === hub.type ? 0 : 1,
  }))
  .filter(({ overlap }) => overlap > 0)
  .sort((a, b) => b.overlap - a.overlap || b.crossTypeBoost - a.crossTypeBoost || a.hub.h1Title.localeCompare(b.hub.h1Title))
  .slice(0, 12)
  .map(({ hub }) => hub);
const catalogSeries = Array.from(new Set(parts.flatMap((part) => part.series.length > 0 ? part.series.map(zhSeriesLabel) : [part.engineType ?? '按出厂编号核验']))).slice(0, 8);
const catalogCategories = Array.from(new Set(parts.map((part) => part.category))).slice(0, 8);
const catalogScope = hub.type === 'series'
  ? `${hub.h1Title} 覆盖 ${catalogCategories.map(zhCategoryName).join('、')} 及相关保养参考号。`
  : `${hub.h1Title} 收录的目录参考号见于 ${catalogSeries.join('、')}。发动机专属适配仍须核验。`;
// Authority concentration: series hubs link to the matching overhaul guide (hub-and-spoke).
const overhaulGuideLink = hub.slug === 'mtu-2000-series'
  ? { href: '/guides/mtu-2000-overhaul-parts/', label: 'MTU 2000 系列大修零件指南' }
  : hub.slug === 'mtu-4000-series'
    ? { href: '/guides/mtu-4000-overhaul-parts/', label: 'MTU 4000 系列大修零件指南' }
    : undefined;
const quoteChecklist = [
  '准确的零件号与数量',
  '发动机型号、功率标定与出厂编号',
  '标识不清时的铭牌照片或旧件照片',
  '目的国、交货期限与期望的运输方式',
];
const catalogUseCases = hub.type === 'series'
  ? ['按发动机出厂编号整理的预防性保养清单', '按类别报的大修询价', '单个已确认零件号的紧急停机替换', '同系列多台发动机的船队补库']
  : ['重复性保养件的批量补库', '跨系列零件号核验', '旧库存替换与替代关系核查', '服务公司或船厂发来的混合询价清单'];
---

<BaseLayout
  title={hub.title}
  description={hub.summary}
  currentPath="/products"
  jsonLd={[
    breadcrumbSchema([
      { name: '首页', url: site.url },
      { name: 'MTU 零件目录', url: `${site.url}/part-products/` },
      { name: hub.h1Title, url: pageUrl },
    ]),
    itemListSchema(
      parts.slice(0, 50).map((p) => ({
        name: `${p.partNumber} ${zhPartName(p.name)}`,
        url: `${site.url}/part-products/${p.slug}/`,
      })),
    ),
  ]}
>
  <FunnelPageView stage="selection" label={`catalog-${hub.slug}`} />
  <BreadcrumbHero
    title={catalogHeading}
    trail={[
      { label: '首页', href: '/' },
      { label: 'MTU 零件目录', href: '/part-products/' },
      { label: hub.h1Title },
    ]}
    variant="2"
  />

  <section class="blog-details-section resource-page-section">
    <div class="section-gap bottom">
      <div class="container">
        <article class="blog-details-content-block resource-page fade-in">
          <!-- ── Stat bar ── -->
          <div class="catalog-stat-bar">
            <div class="catalog-stat-item">
              <span class="catalog-stat-icon catalog-stat-icon--docs">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
              </span>
              <span class="catalog-stat-value">{parts.length}</span>
              <span class="catalog-stat-label">零件号</span>
            </div>
            <div class="catalog-stat-item">
              <span class="catalog-stat-icon catalog-stat-icon--grid">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/></svg>
              </span>
              <span class="catalog-stat-value">{categoryGroups.size}</span>
              <span class="catalog-stat-label">{groupLabel === 'series' ? '系列' : '类别'}</span>
            </div>
            <div class="catalog-stat-item">
              <span class="catalog-stat-icon catalog-stat-icon--moq">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/></svg>
              </span>
              <span class="catalog-stat-value">按询价</span>
              <span class="catalog-stat-label">数量</span>
            </div>
            <div class="catalog-stat-item">
              <span class="catalog-stat-icon catalog-stat-icon--globe">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>
              </span>
              <span class="catalog-stat-value">全球</span>
              <span class="catalog-stat-label">交付</span>
            </div>
          </div>

          <!-- ── RFQ strip ── -->
          <div class="detail-rfq-strip">
            <span class="catalog-rfq-strip-icon" aria-hidden="true">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><line x1="22" y1="2" x2="11" y2="13"/><polygon points="22 2 15 22 11 13 2 9 22 2"/></svg>
            </span>
            <p><strong>请发送零件号、发动机型号、出厂编号、数量与收货地。</strong> 我们核查适配性、库存与运输方案。</p>
            <a
              href={quoteHref}
              class="detail-rfq-link"
              data-rfq-modal
              data-rfq-context={`${hub.h1Title} 零件清单询价`}
              data-rfq-source={`catalog-${hub.slug}`}
            >
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"/><path d="M12 5l7 7-7 7"/></svg>
              发起零件询价
            </a>
          </div>

          <h2>{hub.type === 'series' ? '按类别浏览零件' : '按发动机系列浏览零件'}</h2>
          {seriesGuide && <p><a href={seriesGuide.href}>{seriesGuide.label}</a> · <a href={hub.slug === 'mtu-4000-series' ? '/products/mtu-4000-series-parts/' : hub.slug === 'mtu-2000-series' ? '/products/mtu-2000-series-parts/' : '/products/mtu-spare-parts/'}>零件供货与报价</a></p>}
          <p class="catalog-intro-text">{hub.description}</p>
          {catalogProcurement[hub.slug] && <ProcurementBrief brief={catalogProcurement[hub.slug]} source={`catalog-${hub.slug}-scope`} />}
          {drawingGroups.length > 0 && <section class="catalog-depth-section">
            <h2>目录图纸位置</h2>
            <p>以下为目录图纸中的对应关系，并非确认的套件。使用这些位置前请核对图纸版本与您的发动机出厂编号范围。</p>
            {drawingGroups.map((assembly) => <>
              <h3>{assembly.name}</h3>
              {assembly.kind === 'derived' && <p>{assembly.provenance}</p>}
              <ul>{assembly.parts.map((item) => {
                const linked = mtuParts.find((part) => part.partNumber === item.partNumber);
                const label = `${item.partNumber} ${zhPartNameBilingual(item.description)}`;
                return <li>{item.position ? `位置 ${item.position}：` : ''}{linked ? <a href={`/part-products/${linked.slug}/`}>{label}</a> : label}</li>;
              })}</ul>
            </>)}
          </section>}
          {hub.slug === 'mtu-filters' && <QuotationExamples ids={['generator-service-filters']} source="filters-real-rfq" />}
          {hub.slug === 'mtu-gasket-kits' && <QuotationExamples ids={['cylinder-head-components']} source="gaskets-real-rfq" />}

          {hub.longDescription && (
            <div class="catalog-long-description">
              {hub.longDescription.split('\n\n').map((p) => <p>{p.trim()}</p>)}
            </div>
          )}

          {hub.searchTopics && hub.searchTopics.length > 0 && (
            <section class="catalog-depth-section">
              <h2>{hub.type === 'series' ? '发动机型号覆盖' : '部件覆盖'}</h2>
              <p>
                先用这些专题收窄目录范围，再发送零件号清单。最终适配性对照完整的发动机或部件参考号确认。
              </p>
              <div class="catalog-info-grid">
                {hub.searchTopics.map((topic) => (
                  <article class="catalog-info-card">
                    <h3>
                      {topic.href ? <a href={topic.href}>{topic.title}</a> : topic.title}
                    </h3>
                    <p>{topic.description}</p>
                  </article>
                ))}
              </div>
            </section>
          )}

          <!-- ── Scope + coverage ── -->
          <section class="catalog-depth-section">
            <h2>目录范围与适配方法</h2>
            <p>{catalogScope} 在核对发动机出厂编号、安装位置与任何被替代参考号之前，我们不会把某个零件号当作可互换件。</p>
            <div class="catalog-info-grid">
              <article class="catalog-info-card">
                <span class="catalog-info-card-icon" aria-hidden="true">
                  <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M8.45 2.09A10 10 0 0 0 2.05 8.5"/><path d="M12 2a10 10 0 0 1 10 10"/><circle cx="12" cy="12" r="10"/></svg>
                </span>
                <h3>覆盖的发动机</h3>
                <p>{catalogSeries.join('、')}</p>
              </article>
              <article class="catalog-info-card">
                <span class="catalog-info-card-icon" aria-hidden="true">
                  <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/></svg>
                </span>
                <h3>收录的零件类别</h3>
                <p>{catalogCategories.map(zhCategoryName).join('、')}</p>
              </article>
            </div>
          </section>

          <!-- ── Part-number checks ── -->
          {featuredParts.length > 0 && <section class="catalog-depth-section">
            <h2>零件号与选用核查</h2>
            <p>这些零件号带有针对具体物件的识别核查项。此处列出的目录测量值，对所报物件与发动机仍需进一步确认。</p>
            <div class:list={['catalog-spec-table', { 'catalog-spec-table--no-size': !hasPublishedSizes }]} role="table" aria-label={`${hub.h1Title} 零件号选用核查`}>
              <div class="catalog-spec-head" role="row">
                <span role="columnheader">零件号</span>
                <span role="columnheader">部件</span>
                <span role="columnheader">发动机系列</span>
                {hasPublishedSizes && <span role="columnheader">已发布尺寸</span>}
                <span role="columnheader">报价前核查</span>
              </div>
              {featuredParts.map((part) => (
                <a class="catalog-spec-row" role="row" href={`/part-products/${part.slug}/`}>
                  <span role="cell" class="catalog-spec-cell-pn" data-label="零件号">{part.partNumber}</span>
                  <span role="cell" data-label="部件">{zhPartName(part.name)}</span>
                  <span role="cell" data-label="发动机系列">{part.series.map(zhSeriesLabel).join(', ') || '按出厂编号核查'}</span>
                  {hasPublishedSizes && <span role="cell" data-label="已发布尺寸">{part.dimensions || '未发布'}</span>}
                  <span role="cell" data-label="报价前核查">{part.specificationChecks?.[0] ?? '确认零件标识与发动机出厂编号。'}</span>
                </a>
              ))}
            </div>
          </section>}

          <!-- ── Verification checklist ── -->
          <section class="catalog-depth-section">
            <h2>报价前我们核验什么</h2>
            <div class="catalog-checklist-grid">
              {quoteChecklist.map((item, i) => (
                <article class="catalog-checklist-card">
                  <span class="catalog-checklist-step">{String(i + 1).padStart(2, '0')}</span>
                  <div class="catalog-checklist-body">
                    <h3>{item}</h3>
                  </div>
                </article>
              ))}
            </div>
          </section>

          <!-- ── RFQ scenarios ── -->
          <section class="catalog-depth-section">
            <h2>常见询价场景</h2>
            <ul class="catalog-scenarios-list">
              {catalogUseCases.map((item) => (
                <li>
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
                  <span>{item}</span>
                </li>
              ))}
            </ul>
            <p class="catalog-scenarios-note">混合清单请按原样发送表格。我们逐行返回供货情况、替换说明与实用运输方案，而不是一封通用的目录式回复。</p>
          </section>

          <!-- ── Not listed? Just ask ── -->
          <section class="catalog-depth-section catalog-just-ask">
            <h2>这里没有您的零件号？直接问我们。</h2>
            <p>
              本页仅列出 {hub.h1Title.toLowerCase()} 已收录的参考号——并非 MTU 备件全系列，
              某个号未列出也完全不能说明有无供货。请把完整零件号连同发动机型号与出厂编号一并发来：
              我们核验参考号、追溯替代关系、明确供货等级，并在报价前确认库存。
              若某个号无法核验，我们会如实告知，而不是猜一个发货。
            </p>
            <a
              href={quoteHref}
              class="detail-rfq-link"
              data-rfq-modal
              data-rfq-context="未收录零件号寻源核查"
              data-rfq-source={`catalog-${hub.slug}-just-ask`}
            >
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"/><path d="M12 5l7 7-7 7"/></svg>
              发送我的零件号
            </a>
          </section>

          <!-- ── Grouped part cards ── -->
          {
            Array.from(categoryGroups.entries()).map(([groupKey, groupParts]) => (
              <section class="catalog-group-section">
                <h3 class="catalog-group-title">
                  <span>{zhGroupKey(groupKey)}</span>
                  <span class="catalog-group-count">{groupParts.length} 个零件</span>
                </h3>
                <div class="hub-grid">
                  {groupParts.slice(0, 12).map((part) => (
                    <a href={`/part-products/${part.slug}/`} class="hub-card catalog-part-card">
                      <div class="hub-card-image">
                        <img
                          src={part.image}
                          alt={part.imageAlt ?? `${part.partNumber} ${zhPartName(part.name)}`}
                          width="320"
                          height="200"
                          loading="lazy"
                          decoding="async"
                        />
                      </div>
                      <div class="hub-card-body">
                        <p class="hub-card-meta">{part.partNumber}</p>
                        <h4 class="hub-card-title">{zhPartName(part.name)}</h4>
                        <dl class="catalog-part-specs">
                          <div>
                            <dt>发动机</dt>
                            <dd>{part.engineType ? zhEngineType(part.engineType) : (part.series.length > 0 ? part.series.map(zhSeriesLabel).join(', ') : '按出厂编号核验')}</dd>
                          </div>
                          <div>
                            <dt>类别</dt>
                            <dd>{zhCategoryName(part.category)}</dd>
                          </div>
                          <div>
                            <dt>目录重量</dt>
                            <dd>{part.weightKg ?? '报价核查'}</dd>
                          </div>
                          <div>
                            <dt>HS 编码（参考）</dt>
                            <dd>{part.hsCode ?? '报价核查'}</dd>
                          </div>
                          <div>
                            <dt>其他参考号</dt>
                            <dd>{part.replacementFor?.slice(0, 2).join(', ') || '待核验'}</dd>
                          </div>
                          <div>
                            <dt>图片</dt>
                            <dd>{isRealPartImage(part.image) ? '目录照片' : '类别图片'}</dd>
                          </div>
                        </dl>
                        <p class="hub-card-summary">所询零件号与数量的供货情况经询价后确认。</p>
                      </div>
                    </a>
                  ))}
                </div>
                {groupParts.length > 12 && (
                  <p class="catalog-group-more">
                    <span class="catalog-group-more-count">+{groupParts.length - 12}</span> 另有 {groupParts.length - 12} 个{zhGroupKey(groupKey)}零件——
                    <a
                      href={quoteHref}
                      data-rfq-modal
                      data-rfq-context={`${hub.h1Title} 完整目录清单询价`}
                      data-rfq-source={`catalog-${hub.slug}`}
                    >发送零件清单以获取完整目录</a>
                  </p>
                )}
              </section>
            ))
          }

          <!-- Related catalog hubs -->
          <hr class="catalog-divider" />
