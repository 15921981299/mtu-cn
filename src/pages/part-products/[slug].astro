---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BreadcrumbHero from '../../components/BreadcrumbHero.astro';
import DetailPageShell from '../../components/DetailPageShell.astro';
import DetailRfqStrip from '../../components/DetailRfqStrip.astro';
import FunnelPageView from '../../components/FunnelPageView.astro';
import { getSameSeriesServiceParts, getRelatedMtuParts, isPartPageIndexable, isRealPartImage, mtuCatalogHubs, mtuParts } from '../../data/mtu-parts';
import { partSupply, supplyAvailabilitySchema } from '../../data/part-supply';
import { priorityPartScopes } from '../../data/procurement-content';
import { getPartReferences } from '../../data/part-references';
import QuotationExamples from '../../components/QuotationExamples.astro';
import { getQuotationExamplesForPart } from '../../data/quotation-examples';
import PartBuyerEvidence from '../../components/PartBuyerEvidence.astro';
import { partBuyerEvidence } from '../../data/part-buyer-evidence';
import { getCatalogAssemblies } from '../../data/part-assemblies';
import { getPartGuidance } from '../../data/part-category-guidance';
import { standardPartName } from '../../data/part-names';
import { germanPartName } from '../../data/part-names-de';
import { describeModel, getModelGroupsForPart, modelApplication, modelBuildLabel, parseModels } from '../../data/engine-models';
import { getCompanionParts } from '../../data/part-companions';
import { isMeasurementLike, isMissingSpec } from '../../data/spec-fields';
import { breadcrumbSchema, faqSchema, productSchema, site } from '../../data/site';
import '../../styles/resource-page.css';

export function getStaticPaths() {
  return mtuParts.map((part) => ({ params: { slug: part.slug }, props: { part } }));
}

const { part } = Astro.props;
const supply = partSupply[part.partNumber];
const procurement = priorityPartScopes[part.partNumber];
const buyerEvidence = partBuyerEvidence[part.partNumber];
const quotationIds = getQuotationExamplesForPart(part.partNumber).slice(0, 1).map((example) => example.id);
const guidance = getPartGuidance(part.category, part.series);
const heroImageAlt =
  buyerEvidence?.imageAlt ?? part.imageAlt ??
  (isRealPartImage(part.image)
    ? `${part.partNumber} ${part.name} - MTU ${part.category} spare part`
    : `Representative ${part.category.toLowerCase()} image for ${part.partNumber} ${part.name} sourcing`);
const supplyBadgeLabel =
  supply?.stockStatus === 'in-stock'
    ? 'In stock'
    : supply?.stockStatus === 'fast-order'
      ? 'Fast order'
      : 'Availability check';
const pageUrl = `${site.url}/part-products/${part.slug}/`;
const quoteHref = `/contact/?source=part-${part.slug}`;
const relatedParts = getRelatedMtuParts(part, 4);
const pairedParts = getSameSeriesServiceParts(part, 4);
const assemblyReferences = getCatalogAssemblies(part.partNumber).map((assembly) => ({
  ...assembly,
  parts: assembly.parts.filter((item) => item.partNumber !== part.partNumber).map((item) => ({
    ...item,
    linkedPart: mtuParts.find((candidate) => candidate.partNumber.toUpperCase() === item.partNumber.toUpperCase()),
  })),
}));
const hasSpecificEngineType = part.engineType && !/^Verify by engine serial number$/i.test(part.engineType);
const hasSpecificApplicableEngines = part.applicableEngines && !/^Verify by engine serial number$/i.test(part.applicableEngines);
const shortApplicableEngines = hasSpecificApplicableEngines
  ? part.applicableEngines!.split(';')[0].replace(/\.$/, '')
  : undefined;
const seriesText = part.series.length > 0
  ? part.series.join(', ')
  : hasSpecificEngineType
    ? part.engineType!
    : hasSpecificApplicableEngines
      ? shortApplicableEngines!
      : 'MTU engine serial-number verified applications';
// Authority concentration: link MTU 2000/4000 series part pages back to the
// matching overhaul guide (hub-and-spoke). The guide already links out to the
// series catalog, so this closes the loop and pushes weight onto the strongest asset.
const overhaulGuide = (() => {
  const joined = part.series.join(' ');
  if (/MTU 2000/.test(joined)) return { href: '/guides/mtu-2000-overhaul-parts/', label: 'MTU 2000 Series Overhaul Parts Guide' };
  if (/MTU 4000/.test(joined)) return { href: '/guides/mtu-4000-overhaul-parts/', label: 'MTU 4000 Series Overhaul Parts Guide' };
  return undefined;
})();
// Title 专用短系列名：去掉冗余的 ENGINE(S) 后缀，无系列时回退为 "MTU"，避免 99 字符超长标题
const isVagueSeriesText = (v?: string) =>
  !v || /^Verify by engine serial number$/i.test(v) || /^MTU engine serial-number verified applications$/i.test(v);
const seriesShort = part.series.length > 0
  ? part.series.join(', ')
  : hasSpecificEngineType
    ? part.engineType!.replace(/\s+ENGINES?$/i, '').trim() || 'MTU'
    : !isVagueSeriesText(shortApplicableEngines)
      ? shortApplicableEngines!
      : 'MTU';
const earlierNumbers = (part.crossReferences ?? []).filter((ref) => ref.relationship === 'replaces').map((ref) => ref.partNumber);
const laterNumber = (part.crossReferences ?? []).find((ref) => ref.relationship === 'replaced-by')?.partNumber;
const baseTitle = `${part.partNumber} ${part.name} - ${seriesShort} Part`;
const supersessionTitle = earlierNumbers.length > 0 ? `${part.partNumber} ${part.name} (Replaces ${earlierNumbers[0]}) - ${seriesShort}` : undefined;
const title = buyerEvidence?.title ?? (supersessionTitle && supersessionTitle.length <= 65 ? supersessionTitle : baseTitle);
const engineModels = parseModels(part.applicableEngines);
const modelGroups = getModelGroupsForPart(part);
const companions = getCompanionParts(part);
const stockText = supply?.stockNote ?? 'Availability confirmed after inquiry';
const replacementRefs = Array.from(new Set([...(part.replacementFor ?? []), ...(part.crossReferences ?? []).map((ref) => ref.partNumber)]))
  .filter((ref) => ref.trim() !== '' && ref.toUpperCase() !== part.partNumber.toUpperCase());
// Meta description：按优先级拼装分段，整段取舍而不是硬截断，保证 SERP 里句子完整
const metaDesc = buyerEvidence?.metaDescription ?? (() => {
  const rawSummary = (part.summary ?? '').trim();
  // 自动生成的双句 summary 常达 177 字符（>155 会被整段丢弃 → 134 页曾只剩 CTA）：
  // 超限时只取首句；meta 场景把冗长模糊串压缩为 "MTU engines"（正文保留完整核验语言）
  const firstSentence = rawSummary.includes('. ')
    ? rawSummary.slice(0, rawSummary.indexOf('. ') + 1)
    : rawSummary;
  const summaryText = (rawSummary.length <= 155 ? rawSummary : firstSentence)
    .replace(/MTU engine serial-number verified applications/g, 'MTU engines');
  // 空 summary 兜底：料号+品名+适配+供应链表述，避免 SERP 只剩一句 CTA
  const fallbackSummary = `${part.partNumber} ${part.name} — replacement part for ${seriesShort} engines. ${site.quality.iso9001Label}.`;
  const segments: string[] = [summaryText || fallbackSummary];
  if (supply?.stockStatus === 'in-stock') segments.push('In stock.');
  else if (supply?.stockStatus === 'fast-order') segments.push('Fast-order supply route.');
  const specBits: string[] = [];
  if (part.weightKg && !/^n\/a$/i.test(part.weightKg.trim()) && !summaryText.includes(part.weightKg)) specBits.push(`weight ${part.weightKg}`);
  if (part.hsCode && !summaryText.includes(part.hsCode)) specBits.push(`HS ${part.hsCode}`);
  if (part.natoNumber && !/^n\/a$/i.test(part.natoNumber.trim()) && !summaryText.includes(part.natoNumber)) specBits.push(`NATO ${part.natoNumber}`);
  if (specBits.length > 0) segments.push(specBits.join(' · ') + '.');
  const freshRefs = replacementRefs.filter((ref) => !summaryText.includes(ref));
  if (freshRefs.length > 0) segments.push(`Catalog refs: ${freshRefs.slice(0, 3).join(', ')}.`);
  const cta = `Request price and availability for ${part.partNumber}.`;
  let out = '';
  for (const seg of segments) {
    const candidate = out ? `${out} ${seg}` : seg;
    if (candidate.length > 155) continue; // 超长段跳过而不是终止，给后续规格段留机会
    out = candidate;
  }
  const withCta = out ? `${out} ${cta}` : cta;
  if (withCta.length <= 160) return withCta;
  if (out) return out;
  const raw = `${summaryText} ${cta}`;
  return raw.length <= 160 ? raw : raw.slice(0, 157).replace(/\s+\S*$/, '') + '...';
})();
const supersessionFaqs = [
  ...(earlierNumbers.length > 0
    ? [{
        question: `Is ${earlierNumbers[0]} replaced by ${part.partNumber}?`,
        answer: buyerEvidence
          ? `Imported catalog history lists ${part.partNumber} as a later reference for ${earlierNumbers.join(', ')}. This does not establish universal interchangeability or the number currently available. Confirm the offered component, specifications and engine installation before accepting a substitution.`
          : `Catalog history lists ${part.partNumber} as the later number for ${earlierNumbers.join(', ')}. Orders quoting ${earlierNumbers.length === 1 ? 'that number' : 'those numbers'} are normally supplied as ${part.partNumber}; we confirm the change against the engine serial number, because a later number can come with related changes to mating parts.`,
      }]
    : []),
  ...(laterNumber
    ? [{
        question: `What replaces ${part.partNumber}?`,
        answer: `Catalog history lists ${laterNumber} as the later number. We check whether ${laterNumber} can be fitted on its own or needs related parts changed, and quote ${part.partNumber} where it is still available and preferred.`,
      }]
    : []),
];
const partFaqs = [...(part.faqs ?? []), ...supersessionFaqs.filter((faq) => !(part.faqs ?? []).some((existing) => existing.question === faq.question))];
const hasReplacementRefs = replacementRefs.length > 0;
const replacementReviewText = hasReplacementRefs
  ? 'Catalog history distinguishes earlier and later numbers where documented. Reference-only entries do not establish replacement direction or interchangeability. Confirm the offered number against the engine serial number and installation.'
  : `${part.partNumber} has no public alternative number listed in our current data. We still check old-part photos, engine serial number, and catalog position for supersession before quotation.`;
const quoteChecklist = part.quoteChecklist ?? [
  `Part number: ${part.partNumber}`,
  'Engine model, rating, and serial number',
  'Nameplate photo and old part photo when available',
  'Quantity, destination country, and required delivery date',
];
const referenceRows = getPartReferences(part).map((ref) => {
  const number = ref.number;
  const linkedPart = mtuParts.find((candidate) => candidate.partNumber.toUpperCase() === number.toUpperCase());
  return {
    number,
    label: ref.label,
    href: linkedPart ? `/part-products/${linkedPart.slug}/` : undefined,
  };
});

// German designation (catalog usage). Only shown when the translation is
// substantive — identical output would mean an untranslated name, and labelling
// that "DE" would be false.
const partNameDe = germanPartName(part.name);
const specRows = [
  ['Part No.', part.partNumber],
  ['Name', part.name],
  ...(partNameDe && partNameDe !== part.name ? [['Designation (DE)', partNameDe]] : []),
  ['Category', part.category],
  ['Engine Type', hasSpecificEngineType ? part.engineType : seriesText],
  ['Series', seriesText],
  // Only measurement-like values are shown: the source column also carries
  // designation codes, ratings and description text that must not be
  // published under a Dimensions label.
  ...(isMeasurementLike(part.dimensions) ? [['Dimensions', part.dimensions]] : []),
  ['Catalog Weight', part.weightKg],
  ['HS Code (reference)', part.hsCode],
  ['NATO No.', part.natoNumber],
  ['Lead Time', supply?.leadTime ?? 'Confirmed with quotation'],
].filter(([, value]) => !isMissingSpec(value as string | undefined));
const browseCatalogLinks = Array.from(
  new Map(
    [
      ...mtuCatalogHubs.filter((hub) => hub.partFilter(part)),
      ...mtuCatalogHubs,
    ].map((hub) => [hub.slug, hub]),
  ).values(),
).slice(0, 6);
const productJsonLd = productSchema({
  name: `${part.partNumber} ${part.name}`,
  description: part.summary,
  url: pageUrl,
  image: `${site.url}${part.image}`,
  sku: part.partNumber,
  model: seriesText,
  brandName: 'MTU',
  category: part.category,
  ...(supply ? { availability: supplyAvailabilitySchema[supply.stockStatus] } : {}),
});
---

<BaseLayout
  title={title}
  noTitleSuffix
  description={metaDesc}
  currentPath="/products"
  image={part.image}
  noindex={!isPartPageIndexable(part)}
  jsonLd={[
    breadcrumbSchema([
      { name: 'Home', url: site.url },
      { name: 'MTU Parts Catalog', url: `${site.url}/part-products/` },
      { name: `${part.partNumber} ${part.name}`, url: pageUrl },
    ]),
    ...(productJsonLd ? [productJsonLd] : []),
    ...(partFaqs.length > 0 ? [faqSchema(partFaqs)] : []),
  ]}
>
  <FunnelPageView stage="selection" label={`mtu-part-${part.slug}`} />
  <BreadcrumbHero
    title={`${part.partNumber}<br>${part.name}`}
    trail={[
      { label: 'Home', href: '/' },
      { label: 'MTU Parts Catalog', href: '/part-products/' },
      { label: part.partNumber },
    ]}
    variant="2"
  />

  <DetailPageShell intro={part.summary}>
    <img
      slot="hero"
      src={part.image}
      alt={heroImageAlt}
      width={buyerEvidence ? 640 : 1400}
      height={buyerEvidence ? 468 : 692}
      loading="eager"
      fetchpriority="high"
      decoding="async"
      class:list={{ 'buyer-reference-image': Boolean(buyerEvidence) }}
    />
    {buyerEvidence && <p class="buyer-image-caption">{buyerEvidence.imageCaption}</p>}

    <div class="resource-meta" aria-label="Part specifications" data-part-number={part.partNumber}>
      {specRows.slice(0, 8).map(([label, value]) => (
        <span><strong>{label}</strong> {value}</span>
      ))}
      <span><strong>Delivery</strong> Global shipping</span>
    </div>

    <div class="stock-status-bar">
      <span class="stock-indicator"></span>
      <span>{stockText}</span>
    </div>

    <DetailRfqStrip
      quoteHref={quoteHref}
      title={`Check ${part.partNumber} availability`}
      text={`Start with ${part.partNumber} and the quantity. Add an engine serial number or a photo of the old ${part.name} if available; we will follow up on any missing details.`}
      modalContext={buyerEvidence?.rfqContext ?? `${part.partNumber} ${part.name} - ${seriesText}`}
      modalSource={`part-${part.slug}`}
      secondaryHref="/part-products/"
      secondaryLabel="All MTU part numbers"
    />

    {buyerEvidence && <PartBuyerEvidence number={part.partNumber} evidence={buyerEvidence} />}

    <h2>{part.partNumber} Specification</h2>
    <div class="part-spec-table">
      {specRows.map(([label, value]) => (
        <div>
          <dt>{label}</dt>
          <dd>{value}</dd>
        </div>
      ))}
      <div>
        <dt>Availability</dt>
        <dd>{part.availability}</dd>
      </div>
    </div>

    {supply && (
      <>
        <h2>Supply &amp; Availability</h2>
        <div class="part-supply-card">
          <div class="part-supply-head">
            <span class={`part-supply-badge part-supply-badge--${supply.stockStatus}`}>{supplyBadgeLabel}</span>
            {supply.lastReviewed && <span class="part-supply-verified">Supply information reviewed: {supply.lastReviewed}</span>}
          </div>
          <dl class="part-supply-grid">
            <div>
              <dt>Stock</dt>
              <dd>{supply.stockNote}</dd>
            </div>
            <div>
              <dt>Lead time</dt>
              <dd>{supply.leadTime}</dd>
            </div>
          </dl>
          {supply.realPhotos && supply.realPhotos.length > 0 && (
            <div class="part-supply-photos">
              {supply.realPhotos.map((photo) => (
                <img
                  src={photo}
                  alt={`${part.partNumber} ${part.name} - real stock photo`}
                  width="320"
                  height="240"
                  loading="lazy"
                  decoding="async"
                />
              ))}
            </div>
          )}
          <p class="part-supply-note">Availability is confirmed for each quotation and may change before order release.</p>
        </div>
      </>
    )}

    {procurement && <section data-procurement-part={part.partNumber}>
      <h2>{part.partNumber} Quotation Scope</h2>
      <dl class="part-spec-table">
        <div><dt>Requested contents</dt><dd>{procurement.scope}</dd></div>
        <div><dt>Evidence to request</dt><dd>{procurement.evidence}</dd></div>
        <div><dt>Supplier confirmation</dt><dd>Current stock, exact supplied condition and unit-specific documents are not confirmed by this catalog record. Request them with the quotation.</dd></div>
        <div><dt>Quote acceptance</dt><dd>Offered number, quantity, included items, condition, price, lead time and delivery terms must be agreed before order release.</dd></div>
      </dl>
    </section>}

    <h2>About {part.partNumber} - {part.name}</h2>
    {part.hasCatalogDetails && <p>Published catalog details are identification references. They do not establish current stock, supplied condition, or confirmed fitment for your engine.</p>}
    <p>{part.description ?? part.summary}</p>
    {quotationIds.length > 0 && <QuotationExamples ids={quotationIds} source={`part-${part.slug}-quote-example`} />}

    {guidance && !buyerEvidence && (
      <>
        <h2>Technical Notes: {part.category}</h2>
        <p>{guidance.role}</p>
        {guidance.seriesNote && <p>{guidance.seriesNote}</p>}
        <h3>When This Type of Part Is Usually Replaced</h3>
        <ul>{guidance.replaceWhen.map((item) => <li>{item}</li>)}</ul>
        <h3>Checks Before Ordering</h3>
        <ul>{guidance.checks.map((item) => <li>{item}</li>)}</ul>
      </>
    )}

    {part.specificationChecks && part.specificationChecks.length > 0 && (
      <>
        <h2>Technical Data Status</h2>
        <p>Published catalog details help identify this part, but they are not a controlled drawing for the item offered. Measurements that are not shown here still need confirmation before substitution or order.</p>
        <ul>{part.specificationChecks.map((check) => <li>{check}</li>)}</ul>
        <p><a href={quoteHref} data-rfq-modal data-rfq-context={`${part.partNumber} technical data and document request`} data-rfq-source={`part-${part.slug}-documents`}>Request a datasheet or measurement check</a></p>
      </>
    )}

    {part.applicableEngines && (
      <>
        <h2>Engine Catalog References</h2>
        {engineModels.length > 1 ? (
          <>
            <p>{part.partNumber} is listed for {engineModels.length} engine models in the catalog references. The specification table decodes each model code from the fitment list; it does not confirm every installation.</p>
            <div class="part-reference-scroll" tabindex="0" role="region" aria-label={`Engine models listed for ${part.partNumber}`}>
              <table class="part-reference-table">
                <caption>Engine models listed for {part.partNumber}</caption>
                <thead><tr><th scope="col">Model</th><th scope="col">Cylinders</th><th scope="col">Arrangement</th><th scope="col">Application</th><th scope="col">Group / build</th></tr></thead>
                <tbody>{engineModels.map((model) => (
                  <tr>
                    <th scope="row">{model.code}</th>
                    <td>{model.cylinders}</td>
                    <td>{model.arrangement === 'V' ? 'V' : 'In-line'}</td>
                    <td>{modelApplication(model) ?? '—'}</td>
                    <td>{modelBuildLabel(model)}</td>
                  </tr>
                ))}</tbody>
              </table>
            </div>
            <h3>How Each Model Code Reads</h3>
            <ul class="part-model-list">
              {engineModels.map((model) => <li><strong>{model.code}</strong>: {describeModel(model)}</li>)}
            </ul>
          </>
        ) : engineModels.length === 1 ? (
          <p>{part.partNumber} is listed for {engineModels[0].code} ({describeModel(engineModels[0])}).</p>
        ) : (
          <p>{part.applicableEngines}</p>
        )}
        {modelGroups.length > 0 && (
          <p>
            Full parts list for {modelGroups.length > 1 ? 'these engines' : 'this model family'}:{' '}
            {modelGroups.map((group, index) => (
              <>{index > 0 && ', '}<a href={`/engine-models/${group.slug}/`}>{group.title}</a></>
            ))}
          </p>
        )}
        <p>Engine-series references do not confirm every installation. Final fitment of {part.partNumber} depends on the full engine serial number and assembly position.</p>
      </>
    )}

    {part.commonFailureScenarios && part.commonFailureScenarios.length > 0 && (
      <>
        <h2>Common Replacement Scenarios</h2>
        <p>This part is commonly replaced when:</p>
        <ul>
          {part.commonFailureScenarios.map((s) => <li>{s}</li>)}
        </ul>
      </>
    )}

    {companions && (
      <>
        <h2>Usually Ordered with {part.name}</h2>
        <p>{companions.reason} These {seriesShort} references are commonly checked in the same job; each still needs its own fitment check.</p>
        <ul>
          {companions.parts.map((item) => (
            <li><a href={`/part-products/${item.slug}/`}>{item.partNumber} {item.name}</a></li>
          ))}
        </ul>
      </>
    )}

    <h2>Cross-Reference and Superseded Part Numbers</h2>
    <p>{replacementReviewText}</p>
    {hasReplacementRefs ? (
      <div class="part-reference-scroll" tabindex="0" role="region" aria-label="Part-number cross-reference table">
      <table class="part-reference-table">
        <caption>References relative to {part.partNumber}</caption>
        <thead><tr><th scope="col">Part number</th><th scope="col">Catalog relationship</th></tr></thead>
        <tbody>{referenceRows.map((ref) => (
          <tr><th scope="row">{ref.href ? <a href={ref.href}>{ref.number}</a> : ref.number}</th><td>{ref.label}</td></tr>
        ))}</tbody>
      </table>
      </div>
    ) : (
      <div class="part-verification-card">
        <strong>Replacement status to verify:</strong>
        <span>Send the old part marking, engine model, engine serial number, and installation photo. We check whether a newer, reman, or OEM-alternative route applies before quoting.</span>
      </div>
    )}

    {assemblyReferences.map((assembly) => (
      <section class="hub-section">
        {assembly.kind === 'derived' ? (
          <>
            <h2>Other Parts in the Same Assembly Group</h2>
            <p>{assembly.provenance} Parts in the same group are often renewed together, but each reference still needs its own fitment check against the engine serial number.</p>
          </>
        ) : (
          <>
            <h2>Parts in the Same Catalog Drawing</h2>
            <p>{assembly.name}. Drawing positions are identification references, not a confirmed kit or a list of items included with this part. Check the engine serial number and drawing revision before ordering.</p>
          </>
        )}
        <div class="part-reference-scroll" tabindex="0" role="region" aria-label="Assembly drawing references">
        <table class="part-reference-table">
          <caption>{assembly.kind === 'derived' ? 'Other catalog references in the same assembly group' : 'Other references in this assembly drawing'}</caption>
          <thead><tr>{assembly.kind === 'derived' ? null : <th scope="col">Position</th>}<th scope="col">Part number</th><th scope="col">Description</th></tr></thead>
          <tbody>{assembly.parts.map((item) => (
            <tr>
              {assembly.kind === 'derived' ? null : <td>{item.position}</td>}
              <th scope="row">{item.linkedPart ? <a href={`/part-products/${item.linkedPart.slug}/`}>{item.partNumber}</a> : item.partNumber}</th>
              <td>{standardPartName(item.description)}</td>
            </tr>
          ))}</tbody>
        </table>
        </div>
      </section>
    ))}

    <h2>Common Applications</h2>
    <ul>
      {part.applications.map((application) => <li>{application}</li>)}
    </ul>

    <h2>Information to Send for Quotation</h2>
    <ul>
      {quoteChecklist.map((item) => <li>{item}</li>)}
    </ul>
    <p>The quotation confirms the offered part number, supply condition, price, lead time, and shipping options.</p>

    {part.orderingNotes && (
      <>
        <h2>Ordering Notes</h2>
        <p>{part.orderingNotes}</p>
      </>
    )}

    {partFaqs.length > 0 && (
      <>
        <h2>{part.partNumber} FAQ</h2>
        <div class="part-faq-list">
          {partFaqs.map((faq) => (
            <article>
              <h3>{faq.question}</h3>
              <p>{faq.answer}</p>
            </article>
          ))}
        </div>
      </>
    )}

    <h2>Verification Notes</h2>
    <ul>
      {part.notes.map((note) => <li>{note}</li>)}
    </ul>

    {relatedParts.length > 0 && (
      <section class="hub-section">
        <header class="hub-section-header">
          <h2>Related MTU Parts</h2>
          <p>Similar to {part.name} by engine series or category.</p>
        </header>
        <div class="hub-grid part-related-grid">
          {relatedParts.map((related) => (
            <article class="hub-card">
              <div class="hub-card-body">
                <p class="hub-card-meta">{related.category}</p>
                <h3 class="hub-card-title">
                  <a href={`/part-products/${related.slug}/`}>{related.partNumber} {related.name}</a>
                </h3>
                <p class="hub-card-summary">{related.summary}</p>
              </div>
            </article>
          ))}
        </div>
      </section>
    )}

    {pairedParts.length > 0 && (
      <section class="hub-section">
        <header class="hub-section-header">
          <h2>Other Service Parts in This Engine Series</h2>
          <p>Related {seriesShort} service categories. Each item requires its own fitment check.</p>
        </header>
        <div class="hub-grid part-related-grid">
          {pairedParts.map((p) => (
            <article class="hub-card">
              <div class="hub-card-body">
                <p class="hub-card-meta">{p.category} / {p.series.join(', ')}</p>
                <h3 class="hub-card-title">
                  <a href={`/part-products/${p.slug}/`}>{p.partNumber} {p.name}</a>
                </h3>
                <p class="hub-card-summary">{p.summary}</p>
              </div>
            </article>
          ))}
        </div>
      </section>
    )}

    {/* Browse more catalogs */}
    <section style="margin-top: 32px; padding-top: 24px; border-top: 1px solid var(--color-stroke);">
      <h2 style="font-size: 18px; margin-bottom: 12px;">Browse More MTU Parts</h2>
      <div style="display: flex; flex-wrap: wrap; gap: 8px 16px; font-size: 14px;">
        {browseCatalogLinks.map((hub) => (
          <a href={`/part-products/catalog/${hub.slug}/`} style="color: var(--color-primary); text-decoration: none;">{hub.h1Title}</a>
        ))}
        <a href="/part-products/" style="color: var(--color-primary); text-decoration: none; font-weight: 600;">All catalogs →</a>
      </div>
    </section>

    <p class="resource-note detail-page-back">
      <a href="/part-products/">All MTU part numbers</a>
      /
      <a href="/products/mtu-spare-parts/">MTU spare parts</a>
      {overhaulGuide && (
        <>
          /
          <a href={overhaulGuide.href}>{overhaulGuide.label}</a>
        </>
      )}
      /
      <a
        href={quoteHref}
        data-rfq-modal
        data-rfq-context={`${part.partNumber} ${part.name} - ${seriesText}`}
        data-rfq-source={`part-${part.slug}`}
      >Check this part</a>
    </p>
  </DetailPageShell>
</BaseLayout>

