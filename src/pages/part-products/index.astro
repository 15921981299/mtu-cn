---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BreadcrumbHero from '../../components/BreadcrumbHero.astro';
import FunnelPageView from '../../components/FunnelPageView.astro';
import {
  isRealPartImage,
  mtuPartCategories,
  mtuParts,
  mtuPartSeries,
  mtuCatalogHubs,
  searchPriorityPartRank,
} from '../../data/mtu-parts';
import { zhCategoryName, zhEngineType, zhPartName, zhSeriesLabel } from '../../data/part-names-zh';

const seriesHubs = mtuCatalogHubs.filter((h) => h.type === 'series');
const categoryHubs = mtuCatalogHubs.filter((h) => h.type === 'category');
import { breadcrumbSchema, itemListSchema, site } from '../../data/site';
import '../../styles/resource-page.css';

const pageUrl = `${site.url}/part-products/`;
const priorityModelPages = [
  {
    href: '/products/mtu-2000-series-parts/16v-2000-engine-parts/',
    title: 'MTU 16V 2000 发动机零件',
    summary: '船用、发电、轨交与工业用件——经完整型号与出厂编号核验。',
  },
  {
    href: '/products/mtu-2000-series-parts/mtu-m96l-engine-parts/',
    title: 'MTU 16V 2000 M96L 发动机零件',
    summary: '船用推进与游艇发动机用件——对照完整 M96L 序列与部件参考号核验。',
  },
  {
    href: '/products/mtu-4000-series-parts/12v-4000-engine-parts/',
    title: 'MTU 12V 4000 发动机零件',
    summary: '12V 4000 各变型的燃油、冷却、滤清、传感器、增压器与大修零件。',
  },
  {
    href: '/products/mtu-4000-series-parts/16v-4000-engine-parts/',
    title: 'MTU 16V 4000 发动机零件',
    summary: '面向船舶推进、机车、发电与重工业服务的零件支持。',
  },
];
const priorityParts = [...mtuParts]
  .filter(
    (part) =>
      searchPriorityPartRank.has(part.partNumber.toUpperCase()) ||
      (isRealPartImage(part.image) && Boolean(part.weightKg) && Boolean(part.hsCode)),
  )
  .sort((a, b) => {
    const aSearchRank = searchPriorityPartRank.get(a.partNumber.toUpperCase());
    const bSearchRank = searchPriorityPartRank.get(b.partNumber.toUpperCase());
    if (aSearchRank != null || bSearchRank != null) {
      if (aSearchRank == null) return 1;
      if (bSearchRank == null) return -1;
      return aSearchRank - bSearchRank;
    }
    const bScore =
      Number(Boolean(b.replacementFor?.length)) +
      Number(Boolean(b.applicableEngines)) +
      Number(Boolean(b.commonFailureScenarios?.length));
    const aScore =
      Number(Boolean(a.replacementFor?.length)) +
      Number(Boolean(a.applicableEngines)) +
      Number(Boolean(a.commonFailureScenarios?.length));
    return bScore - aScore || a.partNumber.localeCompare(b.partNumber);
  })
  .slice(0, 60);
---

<BaseLayout
  title="MTU 发动机零件在线目录"
  description="按零件号、发动机系列或零件类别检索 MTU 发动机零件在线目录。查看可用替换参考号、适配说明、重量、HS 编码与询价支持。"
  currentPath="/products"
  jsonLd={[
    breadcrumbSchema([
      { name: '首页', url: site.url },
      { name: 'MTU 零件目录', url: pageUrl },
    ]),
    itemListSchema(mtuParts.map((part) => ({ name: `${part.partNumber} ${zhPartName(part.name)}`, url: `${site.url}/part-products/${part.slug}/` }))),
  ]}
>
  <FunnelPageView stage="selection" label="mtu-part-products-index" />
  <BreadcrumbHero
    title="MTU 发动机零件<br>目录"
    trail={[
      { label: '首页', href: '/' },
      { label: 'MTU 零件目录' },
    ]}
    variant="2"
  />

  <section class="blog-details-section resource-page-section">
    <div class="section-gap bottom">
      <div class="container">
        <article class="blog-details-content-block resource-page fade-in">
          <nav class="resource-nav" aria-label="零件目录导航">
            <a href="/part-products/" class="resource-nav-link active" aria-current="page">全部零件号</a>
            <a href="/products/mtu-spare-parts/" class="resource-nav-link">MTU 备件</a>
            <a
              href="/contact/?source=part-products-nav"
              class="resource-nav-link resource-nav-all"
              data-rfq-modal
              data-rfq-context="MTU 零件目录供货核查"
              data-rfq-source="part-products-nav"
            >核查供货 →</a>
          </nav>

          <p class="resource-intro">
            按发动机系列、零件类别或准确零件号检索本站 MTU 发动机零件目录。每个 MTU 备件页包含可用的交叉参考号、适用发动机信息、供货路线与订购须知。发送您的 Excel 或 PDF 零件清单，我们将逐项核查供货情况并报价。
          </p>

          <div class="resource-meta">
            <span><strong>{mtuParts.length}</strong> 个零件号</span>
            <span><strong>{seriesHubs.length}</strong> 个发动机系列</span>
            <span><strong>{categoryHubs.length}</strong> 个零件类别</span>
          </div>

          <h2 style="margin-top: 36px;">高需求 MTU 发动机型号</h2>
          <div class="hub-grid part-products-grid">
            {priorityModelPages.map((model) => (
              <article class="hub-card">
                <div class="hub-card-body">
                  <h3 class="hub-card-title"><a href={model.href}>{model.title}</a></h3>
                  <p class="hub-card-summary">{model.summary}</p>
                  <a href={model.href} class="hub-card-link">查看该型号零件 →</a>
                </div>
              </article>
            ))}
          </div>

          <!-- Browse by Engine Series -->
          <h2 style="margin-top: 36px;">按发动机系列浏览</h2>
          <div class="hub-grid part-products-grid">
            {seriesHubs.map((hub) => (
              <article class="hub-card">
                <div class="hub-card-body">
                  <h3 class="hub-card-title">
                    <a href={`/part-products/catalog/${hub.slug}/`}>{hub.h1Title}</a>
                  </h3>
                  <p class="hub-card-summary">{hub.summary}</p>
                  <a href={`/part-products/catalog/${hub.slug}/`} class="hub-card-link">浏览零件 →</a>
                </div>
              </article>
            ))}
          </div>

          <!-- Browse by Category -->
          <h2 style="margin-top: 36px;">按零件类别浏览</h2>
          <div class="hub-grid part-products-grid">
            {categoryHubs.map((hub) => (
              <article class="hub-card">
                <div class="hub-card-body">
                  <h3 class="hub-card-title">
                    <a href={`/part-products/catalog/${hub.slug}/`}>{hub.h1Title}</a>
                  </h3>
                  <p class="hub-card-summary">{hub.summary}</p>
                  <a href={`/part-products/catalog/${hub.slug}/`} class="hub-card-link">浏览零件 →</a>
                </div>
              </article>
            ))}
          </div>

          <div class="detail-rfq-strip" style="margin-top: 36px;">
            <p>手头有 Excel 清单？请把所有零件号一并发来。我们逐项核查供货情况，并报从上海出发的实用运输方案。</p>
            <a
              href="/contact/?source=part-products"
              class="detail-rfq-link"
              data-rfq-modal
              data-rfq-context="MTU Excel 零件清单询价"
              data-rfq-source="part-products"
            >发送零件清单</a>
          </div>

          <section class="hub-section priority-parts-section" style="margin-top: 36px;">
            <header class="hub-section-header">
              <h2>搜索需求较高的 MTU 零件</h2>
              <p>经常被检索到的零件号排在前面；在有数据的情况下同时给出真实零件图片、单件重量、HS 编码、替换参考号与适配说明。</p>
            </header>
            <div class="priority-parts-grid">
              {priorityParts.map((part) => (
                <a href={`/part-products/${part.slug}/`} class="priority-part-card">
                  <div class="priority-part-media">
                    <img
                      src={part.image}
                      alt={part.imageAlt ?? `${part.partNumber} ${zhPartName(part.name)}`}
                      width="220"
                      height="160"
                      loading="lazy"
                      decoding="async"
                    />
                  </div>
                  <div class="priority-part-body">
                    <span class="priority-part-number">{part.partNumber}</span>
                    <strong>{zhPartName(part.name)}</strong>
                    <dl>
                      <div><dt>发动机</dt><dd>{part.engineType ? zhEngineType(part.engineType) : (part.series.length > 0 ? part.series.map((s) => zhSeriesLabel(s)).join('、') : '按出厂编号核验')}</dd></div>
                      <div><dt>重量</dt><dd>{part.weightKg}</dd></div>
                      <div><dt>HS</dt><dd>{part.hsCode}</dd></div>
                      <div><dt>替代号</dt><dd>{part.replacementFor?.slice(0, 2).join(', ') || '按出厂编号核查'}</dd></div>
                    </dl>
                  </div>
                </a>
              ))}
            </div>
          </section>

          <!-- All Part Numbers -->
          <section class="hub-section" style="margin-top: 36px;">
            <header class="hub-section-header">
              <h2>全部 MTU 零件号（A-Z）</h2>
              <p>{mtuParts.length} 个零件号页面的完整索引，覆盖 {mtuPartCategories.length} 个类别与 {mtuPartSeries.length} 个发动机系列。</p>
            </header>
            <div class="hub-grid part-products-grid">
              {mtuParts.map((part) => (
                <article class="hub-card">
                  <div class="hub-card-body">
                    <p class="hub-card-meta">{zhCategoryName(part.category)} · {part.series.map((s) => zhSeriesLabel(s)).join('、')}</p>
                    <h3 class="hub-card-title">
                      <a href={`/part-products/${part.slug}/`}>{part.partNumber} {zhPartName(part.name)}</a>
                    </h3>
                    <p class="hub-card-summary">{part.summary}</p>
                    <a href={`/part-products/${part.slug}/`} class="hub-card-link">查看零件 →</a>
                  </div>
                </article>
              ))}
            </div>
          </section>

          <div class="resource-note">
            购买 MTU 替换件前，请结合出厂编号与旧件照片确认。
          </div>
        </article>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .part-products-grid {
    grid-template-columns: repeat(3, 1fr);
  }

  .priority-parts-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 12px;
  }

  .priority-part-card {
    display: grid;
    grid-template-columns: 96px minmax(0, 1fr);
    gap: 12px;
    padding: 12px;
    border: 1px solid var(--color-stroke);
    border-radius: 8px;
    background: #fff;
    color: inherit;
    text-decoration: none;
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }

  .priority-part-card:hover {
    border-color: var(--color-primary);
    box-shadow: 0 10px 24px rgba(15, 23, 42, 0.08);
  }

  .priority-part-card:focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: 3px;
  }

  .priority-part-media {
    aspect-ratio: 1 / 1;
    border: 1px solid #e2e8f0;
    border-radius: 6px;
    overflow: hidden;
    background: #f8fafc;
  }

  .priority-part-media img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    display: block;
  }

  .priority-part-body {
    min-width: 0;
    display: grid;
    gap: 5px;
  }

  .priority-part-number {
    font-family: var(--font-title);
    font-size: 13px;
    font-weight: 800;
    color: var(--color-primary);
    overflow-wrap: anywhere;
  }

  .priority-part-body strong {
    font-size: 13px;
    line-height: 1.3;
    color: #0f172a;
  }

  .priority-part-body dl {
    display: grid;
    gap: 3px;
    margin: 0;
  }

  .priority-part-body dl div {
    display: grid;
    grid-template-columns: 46px minmax(0, 1fr);
    gap: 4px;
  }

  .priority-part-body dt,
  .priority-part-body dd {
    margin: 0;
    font-size: 11px;
    line-height: 1.35;
    overflow-wrap: anywhere;
  }

  .priority-part-body dt {
    color: #64748b;
    font-weight: 800;
    text-transform: uppercase;
  }

  .priority-part-body dd {
    color: #334155;
  }

  @media (max-width: 991px) {
    .part-products-grid,
    .priority-parts-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 640px) {
    .part-products-grid,
    .priority-parts-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 480px) {
    .priority-part-card {
      grid-template-columns: 82px minmax(0, 1fr);
    }
  }
</style>
