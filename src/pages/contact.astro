---
import BaseLayout from '../layouts/BaseLayout.astro';
import BreadcrumbHero from '../components/BreadcrumbHero.astro';
import CustomerFeedback from '../components/CustomerFeedback.astro';
import FaqSection from '../components/FaqSection.astro';
import FunnelPageView from '../components/FunnelPageView.astro';
import { faqs } from '../data/faqs';
import { salesContact } from '../data/testimonials';
import {
  breadcrumbSchema,
  contactPageSchema,
  faqSchema,
  howToSchema,
  site,
} from '../data/site';

const checkIcon = `<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M20 6L9 17l-5-5" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/></svg>`;

const pageUrl = `${site.url}/contact/`;
const pageTitle = 'MTU 发动机零件询价 | 联系柴油零件源';
const pageDescription =
  '从上海采购 MTU、Detroit Diesel、Cummins 与 DEUTZ 发动机零件。发送零件号、发动机出厂编号、数量与目的地，获取经核验的报价与全球运输方案。';

/** Inquiry-focused FAQs — keep FAQPage schema aligned with visible Q&A. */
const contactFaqs = faqs.filter((faq) =>
  [
    '你们供应 OEM 或经核验的发动机零件吗？',
    '询价时应包含哪些信息？',
    '如果我不知道确切的零件号，你们能帮忙识别 MTU 零件吗？',
    '你们发货有多快？',
    '你们可以国际发货吗？',
    '可以整份备件清单报价吗？',
  ].includes(faq.question),
);

const inquirySteps = [
  {
    name: '发送零件信息',
    text: '发送零件号、照片或零件清单，并尽可能附上发动机型号与出厂编号。',
  },
  {
    name: '零件核验',
    text: '报价前，我们核验零件号、替代选项、适配性与供货情况。',
  },
  {
    name: '接收报价',
    text: '您将收到价格、交货期、库存状态以及针对您目的地的实用运输方案。',
  },
  {
    name: '确认并发货',
    text: '确认报价后，我们进行出口包装，并从上海发往您的目的地。',
  },
];

const quoteResponseFields = [
  '待核验的已确认零件号或替代参考号',
  '供货路线：OEM、OEM 替代件、再制造件、维修件或采购核查',
  '单价、最小起订量（如有）、库存路线与交货期依据',
  '大致重量、HS 编码、包装说明与可选运输方案（数据可得时）',
  '放单前的待确认事项，如出厂编号、旧件照片或目的地详情',
];

const shipmentChecks = [
  '包装前核查数量与零件可见标记',
  '按零件尺寸、重量与出口路线选择包装方式',
  '可应要求提供包装照片、标签照片或运输跟踪信息',
  '按确认后的订单准备商业发票与装箱单',
];

const whatsappDigits = site.whatsapp.replace(/\D/g, '');
const whatsappHref = `https://wa.me/${whatsappDigits}`;
const phoneHref = `tel:${site.phone.replace(/\s/g, '')}`;
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  currentPath="/contact"
  image="/images/mtu-part-number-verification.webp"
  hideFloatingCta
  jsonLd={[
    breadcrumbSchema([
      { name: '首页', url: site.url },
      { name: '零件询价', url: pageUrl },
    ]),
    contactPageSchema({
      name: 'MTU 发动机零件询价 — 联系 柴油零件源',
      description: pageDescription,
      url: pageUrl,
    }),
    howToSchema({
      name: '如何向 柴油零件源 询价柴油发动机零件',
      description:
        '发送您的 MTU 或柴油发动机零件清单，获得核验与报价，然后确认从上海发货。',
      steps: inquirySteps,
    }),
    faqSchema(contactFaqs.map((f) => ({ question: f.question, answer: f.answer }))),
  ]}
>
  <FunnelPageView stage="quote" label="contact-rfq" />
  <BreadcrumbHero
    title="MTU 与柴油发动机零件询价"
    trail={[
      { label: '首页', href: '/' },
      { label: '联系我们' },
    ]}
    variant="5"
    image="/images/mtu-part-number-verification.webp"
  />

  <section class="contact-seo-intro fade-in" aria-labelledby="contact-seo-intro-heading">
    <div class="container contact-seo-intro-inner">
      <p class="contact-seo-kicker">上海 · 全球发货</p>
      <h2 id="contact-seo-intro-heading" class="contact-seo-intro-title">
        经核验的 MTU 与柴油发动机零件询价
      </h2>
      <p class="contact-seo-intro-text">
        柴油零件源为船用、工业、轨交与发电团队供应
        <a href="/products/mtu-spare-parts/">MTU 备件</a>、
        <a href="/products/detroit-diesel-parts/">Detroit Diesel</a>、
        <a href="/products/cummins-parts/">Cummins</a> 与
        <a href="/products/deutz-parts/">DEUTZ</a> 零件。
        发送零件号、发动机出厂编号、数量与目的地——我们在报价前核验适配性。
      </p>
      <p class="contact-seo-intro-meta">
        <a href="#rfq-form">询价表单</a>
        <span aria-hidden="true">·</span>
        <a href="/part-products/">零件号</a>
        <span aria-hidden="true">·</span>
        <a href="/part-products/catalog/mtu-4000-series/">MTU 4000 零件目录</a>
        <span aria-hidden="true">·</span>
        <a href="/industries/marine/">船用支持</a>
      </p>
    </div>
  </section>

  <nav class="contact-resource-links fade-in" aria-label="询价前有用的资源">
    <a href="/products/mtu-spare-parts/?source=contact">MTU 备件</a>
    <a href="/part-products/?source=contact">MTU 零件号</a>
    <a href="/part-products/catalog/mtu-filters/?source=contact">MTU 滤清器</a>
    <a href="/products/?source=contact">全部发动机品牌</a>
    <a href="/certifications/?source=contact">质量政策</a>
    <a href="/industries/marine/?source=contact">船用应用</a>
  </nav>

  <section class="contact-form-section">
    <div class="section-gap">
      <div class="container">
        <div class="contact-form-wrapper fade-in">
          <div class="contact-leftside-block">
            <div class="contact-form-block">
              <div class="contact-form-title-block">
                <h2 class="contact-form-title" id="inquiry-form-heading">发送 MTU 或柴油发动机零件询价</h2>
                <p class="contact-form-lead">发送零件号、旧件照片或零件清单。如具体编号不明，请附上发动机型号或出厂编号，我们将协助核验正确的 MTU、Detroit Diesel、Cummins 或 DEUTZ 替换件。</p>
                <ul class="contact-trust-badges" aria-label="报价保障">
                  <li><span class="contact-trust-check" set:html={checkIcon} />询价快速响应</li>
                  <li><span class="contact-trust-check" set:html={checkIcon} />零件号核验</li>
                  <li><span class="contact-trust-check" set:html={checkIcon} />标明 OEM / 替代供货路线</li>
                  <li><span class="contact-trust-check" set:html={checkIcon} />全球交付支持</li>
                </ul>
                <div class="quote-package-card">
                  <p class="quote-package-kicker">我们的零件回复包含</p>
                  <ul>
                    {quoteResponseFields.slice(0, 4).map((item) => <li>{item}。</li>)}
                  </ul>
                </div>
              </div>
              <form class="contact-form" id="rfq-form" aria-labelledby="inquiry-form-heading" data-endpoint="/api/rfq/" data-fallback-email={site.email}>
                <div class="contact-form-column">
                  <label class="contact-field-label" for="rfq-name">您的姓名</label>
                  <input class="contact-form-input-field" type="text" id="rfq-name" name="name" placeholder="张三" autocomplete="name" />
                </div>
                <div class="contact-form-column">
                  <label class="contact-field-label" for="rfq-email">您的邮箱 *</label>
                  <input class="contact-form-input-field" type="email" id="rfq-email" name="email" placeholder="name@company.com" autocomplete="email" required />
                </div>
                <div class="contact-form-column">
                  <label class="contact-field-label" for="rfq-phone">WhatsApp / 电话</label>
                  <input class="contact-form-input-field" type="tel" id="rfq-phone" name="phone" placeholder="+86 138 0000 0000" autocomplete="tel" />
                </div>
                <div class="contact-form-column">
                  <label class="contact-field-label" for="rfq-country">目的国</label>
                  <input class="contact-form-input-field" type="text" id="rfq-country" name="country" placeholder="例如：美国、德国、澳大利亚" autocomplete="country-name" />
                </div>
                <div class="contact-form-column">
                  <label class="contact-field-label" for="rfq-engine-model">发动机型号</label>
                  <input class="contact-form-input-field" type="text" id="rfq-engine-model" name="engine_model" placeholder="例如：MTU 12V4000、16V2000" />
                </div>
                <div class="contact-form-column">
                  <label class="contact-field-label" for="rfq-engine-serial">发动机出厂编号</label>
                  <input class="contact-form-input-field" type="text" id="rfq-engine-serial" name="engine_serial" placeholder="见发动机铭牌" />
                </div>
                <div class="contact-form-column contact-form-column--full">
                  <label class="contact-field-label" for="rfq-message">零件号 / 询价详情 *</label>
                  <textarea id="rfq-message" placeholder="请粘贴零件号、发动机型号或出厂编号、数量、目的地，或描述旧件情况。" name="message" class="contact-form-input-field large" required></textarea>
                </div>
                <div class="contact-form-column file-upload-column">
                  <span class="contact-field-label" id="rfq-drawing-label">上传照片 / 零件清单</span>
                  <label class="file-upload-label" for="drawing-upload" aria-labelledby="rfq-drawing-label">
                    <input
                      type="file"
                      id="drawing-upload"
                      name="drawing"
                      accept=".pdf,.xls,.xlsx,.csv,.jpg,.jpeg,.png"
                      class="file-upload-input"
                    />
                    <span class="file-upload-icon" aria-hidden="true">
                      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <path d="M12 16V4M12 4L8 8M12 4L16 8" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"></path>
                        <path d="M4 14V18C4 19.1046 4.89543 20 6 20H18C19.1046 20 20 19.1046 20 18V14" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"></path>
                      </svg>
                    </span>
                    <span class="file-upload-content">
                      <span class="file-upload-title">上传照片 / 零件清单（选填）</span>
                      <span class="file-upload-hint">JPG、PNG、PDF、Excel 或 CSV · 最大 50MB</span>
                      <span class="file-upload-filename" data-placeholder="未选择文件">未选择文件</span>
                    </span>
                  </label>
                </div>
                <input type="hidden" name="source" id="rfq-source" value="联系表单" />
                <div class="hp-field" aria-hidden="true">
                  <label for="rfq-website">此项留空</label>
                  <input type="text" id="rfq-website" name="website" tabindex="-1" autocomplete="off" />
                </div>
                <div class="contact-form-button-block">
                  <button type="submit" class="contact-form-button">发送零件询价 →</button>
                  <p class="contact-form-submit-note">仅需填写邮箱与零件详情。如有需要，我们会进一步询问。</p>
                </div>
                <div class="form-result" aria-live="polite"></div>
              </form>
            </div>
          </div>
          <div class="contact-rightside-block">
            <div class="contact-image-block">
              <img src="/images/mtu-part-number-verification.webp" alt="MTU 柴油发动机零件询价与零件号核验" class="contact-form-image" width="1200" height="1114" loading="lazy" decoding="async" />
            </div>
            <div class="contact-form-image-overlay"></div>
            <div class="contact-image-contect-block">
              <div class="contact-text-contect-block">
                <h2 class="contact-form-title text-color-white">询价之后会发生什么</h2>
                <ol class="process-steps">
                  {inquirySteps.map((step, i) => (
                    <li class="process-step">
                      <span class="step-number" aria-hidden="true">{i + 1}</span>
                      <p class="contact-form-summary"><strong>{step.name}:</strong> {step.text}</p>
                    </li>
                  ))}
                </ol>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Contact Info / NAP -->
  <section class="contact-info-section" aria-labelledby="contact-nap-heading">
    <div class="section-gap bottom">
      <div class="container">
        <h2 id="contact-nap-heading" class="contact-nap-heading">柴油零件源联系方式</h2>
        <p class="contact-nap-lead">
          柴油零件源（Shanghai Diesel Part Source Co., Ltd.）为全球提供经核验的柴油发动机零件采购支持。请通过邮件、电话或 WhatsApp 联系销售台，获取 MTU 与多品牌零件支持。
        </p>
        <p class="contact-nap-lead contact-sales-contact">
          您的询价由 <strong>{salesContact.name}</strong>（{salesContact.role}）处理，回复语言：{salesContact.languages}，一个工作日内答复。
        </p>
        <div class="contact-info-wrapper">
          <div class="contact-info-single-block fade-in">
            <div class="contact-info-icon-block"><img src="/images/contact-email-message-icon.svg" alt="" aria-hidden="true" class="contact-info-icon" width="24" height="24" loading="lazy" decoding="async" /></div>
            <div class="contact-info-content-block">
              <h3 class="contact-info-title">邮箱</h3>
              <p class="contact-info-summary">
                <a href={`mailto:${site.email}`} class="contact-info-link">{site.email}</a>
              </p>
            </div>
          </div>
          <div class="contact-info-single-block fade-in">
            <div class="contact-info-icon-block"><img src="/images/contact-phone-call-icon.svg" alt="" aria-hidden="true" class="contact-info-icon" width="24" height="24" loading="lazy" decoding="async" /></div>
            <div class="contact-info-content-block">
              <h3 class="contact-info-title">电话与 WhatsApp</h3>
              <p class="contact-info-summary">
                <a href={phoneHref} class="contact-info-link">{site.phone}</a>
                <span class="contact-info-sep" aria-hidden="true">·</span>
                <a href={whatsappHref} class="contact-info-link" rel="noopener noreferrer" target="_blank">WhatsApp</a>
              </p>
              <p class="contact-info-note">船舶或发电机组紧急停机？请在留言中注明，以便优先处理。</p>
            </div>
          </div>
          <div class="contact-info-single-block fade-in">
            <div class="contact-info-icon-block"><img src="/images/contact-location-pin-icon.svg" alt="" aria-hidden="true" class="contact-info-icon" width="24" height="24" loading="lazy" decoding="async" /></div>
            <div class="contact-info-content-block">
              <h3 class="contact-info-title">上海办公室</h3>
              <p class="contact-info-summary">
                <address class="contact-address">
                  {site.company.legalNameEn}<br />
                  {site.company.address.singleLine}
                </address>
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <CustomerFeedback id="contact-feedback" />

  <section class="contact-standard-section" aria-labelledby="contact-standard-heading">
    <div class="section-gap bottom">
      <div class="container">
        <h2 id="contact-standard-heading" class="contact-nap-heading">询价与发货放行标准</h2>
        <p class="contact-nap-lead">
          一份专业的零件报价应在付款前降低错发零件的风险。以下是我们会在放单前与采购方讨论的核查项。
        </p>
        <div class="contact-standard-grid fade-in">
          <article class="contact-standard-card">
            <h3>报价回复内容</h3>
            <ul>
              {quoteResponseFields.map((item) => <li>{item}</li>)}
            </ul>
          </article>
          <article class="contact-standard-card">
            <h3>发货前检查</h3>
            <ul>
              {shipmentChecks.map((item) => <li>{item}</li>)}
            </ul>
          </article>
        </div>
      </div>
    </div>
  </section>

  <FaqSection
    items={contactFaqs}
    title="零件询价常见问题"
    subtitle="报价前必读"
  />
</BaseLayout>

<style>
  /* SEO intro */
  .contact-seo-intro {
    margin-bottom: 0.25rem;
    margin-top: 4rem;
  }

  .contact-seo-intro-inner {
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 20px 1.1rem;
    text-align: center;
  }

  .contact-seo-kicker {
    margin: 0 0 0.45rem;
    color: var(--color-primary);
    font-family: var(--font-title);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .contact-seo-intro-title {
    margin: 0 0 0.55rem;
    font-size: clamp(1.3rem, 2.2vw, 1.65rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.25;
    text-transform: none;
  }

  .contact-seo-intro-text {
    margin: 0 auto;
    max-width: 96ch;
    color: #475569;
    font-size: 15px;
    line-height: 1.7;
  }

  .contact-seo-intro-text a {
    color: var(--color-title);
    font-weight: 600;
    text-decoration: underline;
    text-decoration-color: rgba(20, 110, 245, 0.35);
    text-underline-offset: 0.15em;
    transition: color 0.2s ease, text-decoration-color 0.2s ease;
  }

  .contact-seo-intro-text a:hover {
    color: var(--color-primary);
    text-decoration-color: var(--color-primary);
  }

  .contact-seo-intro-meta {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 6px 10px;
    margin: 14px 0 0;
    color: #94a3b8;
    font-size: 13px;
    font-weight: 600;
  }

  .contact-seo-intro-meta a {
    color: #334155;
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .contact-seo-intro-meta a:hover {
    color: var(--color-primary);
  }

  .contact-seo-intro-text a:focus-visible,
  .contact-seo-intro-meta a:focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: 2px;
    border-radius: 2px;
  }

  /* Resource chips */
  .contact-resource-links {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    justify-content: center;
    max-width: 1220px;
    margin: 0 auto 0px;
    padding: 0 20px;
  }

  .contact-resource-links a {
    display: inline-flex;
    align-items: center;
    min-height: 40px;
    padding: 8px 14px;
    border-radius: 999px;
    border: 1px solid rgba(20, 110, 245, 0.2);
    background: #fff;
    font-size: 13px;
    font-weight: 600;
    color: #1e293b;
    text-decoration: none;
    cursor: pointer;
    transition: background 0.2s ease, border-color 0.2s ease, color 0.2s ease, box-shadow 0.2s ease;
  }

  .contact-resource-links a:hover {
    background: rgba(20, 110, 245, 0.07);
    border-color: rgba(20, 110, 245, 0.4);
    color: var(--color-primary);
    box-shadow: 0 2px 8px rgba(20, 110, 245, 0.08);
  }

  .contact-resource-links a:focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: 2px;
  }

  /* Form header */
  .contact-form-lead {
    margin: 12px 0 0;
    font-size: 15px;
    line-height: 1.65;
    color: #475569;
  }

  .contact-trust-badges {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 14px 0 0;
    padding: 0;
    list-style: none;
  }

  .contact-trust-badges li {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-height: 30px;
    padding: 4px 10px 4px 6px;
    border: 1px solid rgba(20, 110, 245, 0.14);
    border-radius: 999px;
    background: rgba(20, 110, 245, 0.05);
    font-size: 12px;
    font-weight: 600;
    line-height: 1.3;
    color: #334155;
  }

  .contact-trust-check {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 18px;
    height: 18px;
    border-radius: 50%;
    background: rgba(20, 110, 245, 0.12);
    color: var(--color-primary);
    flex-shrink: 0;
  }

  .quote-package-card {
    margin-top: 16px;
    padding: 14px 16px;
    border: 1px solid rgba(20, 110, 245, 0.16);
    border-radius: 10px;
    background: rgba(20, 110, 245, 0.04);
  }

  .quote-package-kicker {
    margin: 0 0 8px;
    font-family: var(--font-title);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-primary);
  }

  .quote-package-card ul {
    display: flex;
    flex-direction: column;
    gap: 6px;
    margin: 0;
    padding-left: 18px;
  }

  .quote-package-card li {
    font-size: 13px;
    line-height: 1.5;
    color: #334155;
  }

  .contact-standard-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 18px;
