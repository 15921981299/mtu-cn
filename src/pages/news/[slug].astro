---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BreadcrumbHero from '../../components/BreadcrumbHero.astro';
import FunnelPageView from '../../components/FunnelPageView.astro';
import DetailRfqStrip from '../../components/DetailRfqStrip.astro';
import { newsArticles } from '../../data/news';
import { articleSchema, breadcrumbSchema, faqSchema, site } from '../../data/site';
import '../../styles/resource-page.css';

export function getStaticPaths() {
  return newsArticles.map((article) => ({ params: { slug: article.slug }, props: { article } }));
}

const { article } = Astro.props;
const pageUrl = `${site.url}/news/${article.slug}/`;
const hasPersonAuthor = Boolean(site.author.name);
---

<BaseLayout
  title={article.seoTitle}
  description={article.description}
  currentPath="/news"
  jsonLd={[
    breadcrumbSchema([
      { name: '首页', url: site.url },
      { name: '行业札记', url: `${site.url}/news/` },
      { name: article.h1, url: pageUrl },
    ]),
    articleSchema({
      title: article.h1,
      description: article.description,
      url: pageUrl,
      image: `${site.url}${article.image}`,
      datePublished: article.datePublished,
      dateModified: article.dateModified,
      authorName: hasPersonAuthor ? site.author.name : site.name,
      authorType: hasPersonAuthor ? 'Person' : 'Organization',
      authorJobTitle: hasPersonAuthor && site.author.jobTitle ? site.author.jobTitle : undefined,
      authorSameAs: hasPersonAuthor && site.author.linkedin ? [site.author.linkedin] : undefined,
    }),
    faqSchema(article.faqs),
  ]}
>
  <FunnelPageView stage="service" label={`news-${article.slug}`} />
  <BreadcrumbHero
    title={article.h1}
    trail={[{ label: '首页', href: '/' }, { label: '行业札记', href: '/news/' }, { label: article.title }]}
    variant="3"
  />

  <div class="resource-page">
    <section class="resource-page-section">
      <p class="news-lede">{article.description}</p>
      <div class="resource-meta">
        <span><strong>发布于</strong> {article.datePublished}</span>
        <span><strong>类别</strong> {article.category}</span>
        {hasPersonAuthor ? (
          <span><strong>作者</strong> {site.author.name}{site.author.jobTitle ? `，${site.author.jobTitle}` : ''}</span>
        ) : (
          <span><strong>维护</strong> {site.name} 零件部</span>
        )}
      </div>
    </section>

    <section class="resource-page-section">
      <h2>核心要点</h2>
      <ul class="resource-checklist">
        {article.keyFacts.map((fact) => <li>{fact}</li>)}
      </ul>
      <h3>来源</h3>
      <ul class="resource-olist">
        {article.sources.map((source) => (
          <li><a href={source.url} rel="nofollow noopener" target="_blank">{source.label}</a></li>
        ))}
      </ul>
      <p class="news-note">
        本札记中的事实均取自上文所列来源。凡制造商未公布的数据，我们不予陈述。
      </p>
    </section>

    {article.sections.map((section) => (
      <section class="resource-page-section">
        <h2>{section.heading}</h2>
        {section.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
      </section>
    ))}

    <section class="resource-page-section">
      <h2>相关页面</h2>
      <ul class="resource-olist">
        {article.related.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
        <li><a href="/news/">全部行业札记</a></li>
      </ul>
    </section>

    <section class="resource-page-section">
      <h2>常见问题（FAQ）</h2>
      {article.faqs.map((item) => (
        <details class="news-faq-item">
          <summary>{item.question}</summary>
          <p>{item.answer}</p>
        </details>
      ))}
    </section>

    <DetailRfqStrip
      title="提供您的发动机信息"
      text="请提供型号、出厂编号与所需部位——我们核验适配与替换关系后按行报价，并注明每行供货情况。"
      quoteHref={`/contact/?source=news-${article.slug}`}
      label="申请零件报价"
      modalSource={`news-${article.slug}`}
    />
  </div>
</BaseLayout>

<style>
  .news-lede {
    font-size: 17px;
    line-height: 1.65;
  }

  .news-note {
    margin-top: 10px;
    font-size: 14px;
    color: #64748b;
  }

  .news-faq-item {
    border: 1px solid #e2e8f0;
    border-radius: 8px;
    padding: 14px 16px;
    margin-bottom: 10px;
  }

  .news-faq-item summary {
    cursor: pointer;
    font-weight: 700;
  }

  .news-faq-item p {
    margin: 10px 0 0;
    color: #475569;
    line-height: 1.6;
  }
</style>
