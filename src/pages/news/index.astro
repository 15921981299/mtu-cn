---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BreadcrumbHero from '../../components/BreadcrumbHero.astro';
import FunnelPageView from '../../components/FunnelPageView.astro';
import DetailRfqStrip from '../../components/DetailRfqStrip.astro';
import { newsArticles } from '../../data/news';
import { breadcrumbSchema, site } from '../../data/site';
import '../../styles/resource-page.css';

const pageUrl = `${site.url}/news/`;
const articles = [...newsArticles].sort((a, b) => b.datePublished.localeCompare(a.datePublished));
---

<BaseLayout
  title="发动机零件行业札记 — MTU 系列与排放系统"
  description="按日期记录的 MTU 发动机项目、排放系统与采购实务札记。所有事实陈述均注明制造商或原始出处。"
  currentPath="/news"
  jsonLd={[
    breadcrumbSchema([
      { name: '首页', url: site.url },
      { name: '行业札记', url: pageUrl },
    ]),
  ]}
>
  <FunnelPageView stage="service" label="news-index" />
  <BreadcrumbHero
    title="行业札记"
    trail={[{ label: '首页', href: '/' }, { label: '行业札记' }]}
    variant="3"
  />

  <div class="resource-page">
    <section class="resource-page-section">
      <p>
        简短、注明日期的札记，记录客户实际运行的发动机项目与排放系统。这里的规则与我们报价时遵循的规则相同：<strong>所有事实陈述均注明出处</strong>，引自制造商或原始出版物；无法溯源的内容不予陈述。不转发新闻稿，不编造规格参数。
      </p>
      <p>
        这些札记不是库存报告，也不是价目表。供货情况、交货期与供货状态，将在核对零件号与发动机出厂编号后按询价逐一确认。
      </p>
    </section>

    <section class="resource-page-section">
      <h2>最新札记</h2>
      <div class="news-grid">
        {articles.map((article) => (
          <a class="news-card" href={`/news/${article.slug}/`}>
            <span class="news-card__meta">{article.category} · {article.datePublished}</span>
            <h3>{article.h1}</h3>
            <p>{article.description}</p>
            <span class="news-card__more">阅读全文 →</span>
          </a>
        ))}
      </div>
    </section>

    <section class="resource-page-section">
      <h2>相关资源</h2>
      <ul class="resource-olist">
        <li><a href="/insights/">故障排查与备件采购</a> — 24 篇分类表、决策图与零件询价清单</li>
        <li><a href="/part-number-index/">搜索全部零件号（EN · DE）</a></li>
        <li><a href="/products/mtu-spare-parts/regularly-sourced-parts/">常采购的 MTU 零件</a> — 类别与系列覆盖</li>
        <li><a href="/guides/">发动机零件指南</a> — 大修规划与系列识别</li>
        <li><a href="/genuine-oem-parts/">原厂件、OEM 品质件与副厂件渠道</a></li>
      </ul>
    </section>

    <DetailRfqStrip
      title="提供您的发动机信息"
      text="请提供型号、出厂编号与所需部位——我们核验适配与替换关系后按行报价，并注明每行供货情况。"
      quoteHref="/contact/?source=news-index"
      label="申请零件报价"
      modalSource="news-index"
    />
  </div>
</BaseLayout>

<style>
  .news-grid {
    display: grid;
    gap: 18px;
    grid-template-columns: repeat(auto-fit, minmax(290px, 1fr));
  }

  .news-card {
    display: block;
    border: 1px solid #e2e8f0;
    border-radius: 10px;
    padding: 18px 20px;
    text-decoration: none;
    color: inherit;
    transition: border-color 0.15s ease, box-shadow 0.15s ease;
  }

  .news-card:hover {
    border-color: var(--color-primary, #146ef5);
    box-shadow: 0 4px 14px rgba(15, 23, 42, 0.08);
  }

  .news-card__meta {
    display: block;
    font-size: 12px;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: #64748b;
    margin-bottom: 8px;
  }

  .news-card h3 {
    margin: 0 0 10px;
    font-size: 19px;
    line-height: 1.35;
  }

  .news-card p {
    margin: 0;
    color: #475569;
    font-size: 15px;
    line-height: 1.6;
  }

  .news-card__more {
    display: inline-block;
    margin-top: 12px;
    font-size: 14px;
    font-weight: 700;
    color: var(--color-primary, #146ef5);
  }
</style>
