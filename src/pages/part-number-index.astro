---
import BaseLayout from '../layouts/BaseLayout.astro';
import BreadcrumbHero from '../components/BreadcrumbHero.astro';
import FunnelPageView from '../components/FunnelPageView.astro';
import DetailRfqStrip from '../components/DetailRfqStrip.astro';
import { mtuParts } from '../data/mtu-parts';
import { zhCategoryName, zhPartNameBilingual, zhSeriesLabel } from '../data/part-names-zh';
import { breadcrumbSchema, faqSchema, site } from '../data/site';
import '../styles/resource-page.css';

/**
 * Flat index of every indexed MTU part number, one row per part.
 *
 * 中文站索引：每行给出中文品名与英文原名（中英混排）、零件类别与发动机系列。
 * 品名中文译名由 part-names-zh 词典生成，英文原名保留以便对照旧零件清单。
 */

type Row = {
  partNumber: string;
  name: string;
  nameZh: string;
  category: string;
  categoryZh: string;
  series: string;
  seriesZh: string;
  slug: string;
};

const rows: Row[] = mtuParts.map((part) => {
  const series = part.series.join(', ');
  return {
    partNumber: part.partNumber,
    name: part.name,
    nameZh: zhPartNameBilingual(part.name),
    category: part.category,
    categoryZh: zhCategoryName(part.category),
    series,
    seriesZh: series ? part.series.map((s) => zhSeriesLabel(s)).join('、') : '',
    slug: part.slug,
  };
});

const seriesCounts = new Map<string, number>();
for (const row of rows) {
  for (const s of row.series.split(', ')) {
    if (s) seriesCounts.set(s, (seriesCounts.get(s) ?? 0) + 1);
  }
}
const seriesFilters = [...seriesCounts.entries()]
  .map(([label, count]) => ({ label, count }))
  .sort((a, b) => b.count - a.count || a.label.localeCompare(b.label));

const zhCount = rows.filter((r) => r.nameZh && r.nameZh !== r.name).length;

// URL-query support for ?q= — the header search form submits here (it is also
// the SearchAction target). NOTE: the build is static, so at build time there is
// no query string and this branch is inert; it only produces pre-filtered HTML
// under an SSR/hybrid output. On the static build the client script below reads
// ?q= on load and applies the same filter, so the URL works either way.
const rawQuery = Astro.url.searchParams.get('q')?.trim() ?? '';
const normQuery = rawQuery.toUpperCase().replace(/[^A-Z0-9]/g, '');
const hasServerQuery = normQuery.length >= 2;
const rowMatchesQuery = (row: Row): boolean => {
  if (!hasServerQuery) return true;
  const key = `${row.partNumber} ${row.name} ${row.nameZh} ${row.category} ${row.categoryZh} ${row.series} ${row.seriesZh}`
    .toUpperCase();
  if (key.includes(rawQuery.toUpperCase())) return true;
  return key.replace(/[^A-Z0-9]/g, '').includes(normQuery);
};
// All rows stay in the DOM; non-matching ones are hidden with inline CSS so the
// client filter can still reveal them when the query is cleared.
const visibleRowCount = rows.filter(rowMatchesQuery).length;

const pageUrl = `${site.url}/part-number-index/`;
const faqItems = [
  {
    question: '这个零件号索引是什么？',
    answer:
      '本站已收录的全部 MTU 零件号平面列表，每行包含中文品名与英文原名、零件类别和发动机系列。可按任意片段筛选——零件号、品名、类别或系列——然后打开对应零件页查看适配说明、重量、HS 编码与供货情况。',
  },
  {
    question: '为什么同时列出中文品名和英文原名？',
    answer:
      'MTU 零件清单与行业资料以英文为主，中文品名用于本站检索与识别参考，英文原名便于您对照现有零件清单与旧件标识。品名译名仅作识别支持；订购时以零件上的编号与发动机铭牌为准。',
  },
  {
    question: '索引里没有我的零件号，你们还能供吗？',
    answer:
      '请发送完整零件号、发动机型号与出厂编号，我们做寻源核查。未列入本索引不代表有货或无货——索引仅覆盖本站已发布的目录数据，并非 MTU 全部备件范围。',
  },
  {
    question: '品名看起来与我的零件不符，怎么办？',
    answer:
      '请以零件上的编号和发动机铭牌为准，不要以文字标签为准。发送零件标识、铭牌与安装位置照片，我们将在报价前核验该参考号。',
  },
];
---

<BaseLayout
  title={hasServerQuery ? `“${rawQuery}”——MTU 零件号索引搜索结果` : 'MTU 零件号索引——全系列零件号与中英文品名'}
  description={hasServerQuery
    ? `零件号索引中匹配“${rawQuery}”的 ${visibleRowCount} 个 MTU 零件号，含中文品名、英文原名、零件类别与发动机系列。`
    : `收录 ${rows.length} 个 MTU 零件号的平面索引，含中文品名、英文原名、零件类别与发动机系列。可按零件号、品名或系列筛选，再打开零件页查看适配与供货情况。`}
  currentPath="/part-number-index"
  noindex={hasServerQuery}
  jsonLd={[
    breadcrumbSchema([
      { name: '首页', url: site.url },
      { name: '零件号索引', url: pageUrl },
    ]),
    faqSchema(faqItems),
  ]}
>
  <FunnelPageView stage="comparison" label="part-number-index" />
  <BreadcrumbHero
    title="MTU 零件号索引"
    trail={[{ label: '首页', href: '/' }, { label: '零件号索引' }]}
    variant="2"
  />

  <div class="resource-page">
    <section class="resource-page-section">
      <p>
        本站已收录的全部 MTU 零件号汇总为一张可筛选的列表——
        <strong>{rows.length} 个零件号</strong>，覆盖 {seriesFilters.length} 个发动机系列标签，
        从 183 系列到 8000 系列。每行包含中文品名与英文原名（其中 {zhCount} 条与英文原名不同）、
        零件类别与发动机系列。
      </p>
      <p>
        在下方输入任意片段即可筛选——零件号、中文或英文品名、类别、系列——然后打开链接的零件页查看
        适配说明、重量、HS 编码与供货情况。中文品名仅作识别支持；零件上的编号与发动机铭牌始终是最终依据。
      </p>
    </section>

    <section class="resource-page-section">
      <div class="xref-filter">
        <input
          type="search"
          id="pn-filter-input"
          placeholder="输入零件号、品名或类别，如 52407500064、曲轴、喷油器"
          aria-label="筛选零件号索引"
          autocomplete="off"
          value={rawQuery}
        />
        <span class="xref-filter__count" id="pn-count">
          {hasServerQuery ? `${visibleRowCount} / ${rows.length} 个零件号` : `${rows.length} 个零件号`}
        </span>
      </div>
      {hasServerQuery && (
        <p class="pn-server-query">
          匹配 <strong>“{rawQuery}”</strong> 的 <strong>{visibleRowCount}</strong> 个零件号——打开任意行查看适配说明、重量、HS 编码与供货情况。
        </p>
      )}
      <div class="pn-series-chips" id="pn-series-chips" role="group" aria-label="按发动机系列筛选">
        <button type="button" class="pn-chip is-active" data-series="">全部系列</button>
        {seriesFilters.map((s) => (
          <button type="button" class="pn-chip" data-series={s.label} title={zhSeriesLabel(s.label)}>
            {zhSeriesLabel(s.label)} <span class="pn-chip__count">{s.count}</span>
          </button>
        ))}
      </div>
      <div class="xref-table-wrap">
        <table class="xref-table pn-table" id="pn-table">
          <thead>
            <tr>
              <th scope="col">零件号</th>
              <th scope="col">品名（中文）</th>
              <th scope="col">品名（English）</th>
              <th scope="col">类别</th>
              <th scope="col">发动机系列</th>
            </tr>
          </thead>
          <tbody>
            {rows.map((row) => {
              const show = rowMatchesQuery(row);
              return (
              <tr
                data-pn-key={`${row.partNumber} ${row.name} ${row.nameZh} ${row.category} ${row.categoryZh} ${row.series} ${row.seriesZh}`}
                data-pn-series={row.series}
                style={show ? undefined : 'display:none'}
              >
                <td>
                  <a href={`/part-products/${row.slug}/`}>{row.partNumber}</a>
                </td>
                <td>{row.nameZh}</td>
                <td class="pn-de">{row.name}</td>
                <td>
                  {row.categoryZh}
                </td>
                <td>
                  {row.seriesZh || row.series || '按出厂编号核验'}
                </td>
              </tr>
              );
            })}
          </tbody>
        </table>
        <p class="xref-empty" id="pn-empty" hidden={visibleRowCount > 0}>
          零件号索引中未找到匹配项。<a href="/contact/?source=pn-index-not-found" data-rfq-modal data-rfq-source="pn-index-not-found" data-rfq-context="未收录零件号寻源核查">把零件号发给我们</a>——
          我们将在报价前人工核查供货情况。
        </p>
      </div>
    </section>

    <section class="resource-page-section">
      <h2>零件号索引常见问题</h2>
      {faqItems.map((item) => (
        <details class="resource-faq-item">
          <summary>{item.question}</summary>
          <p>{item.answer}</p>
        </details>
      ))}
    </section>

    <DetailRfqStrip
      title="这里没有找到您的零件号？直接问我们。"
      text="发送完整零件号、发动机型号与出厂编号。我们将在报价前核验参考号与供货情况——未列入本索引不代表该件无货。"
      quoteHref="/contact/?source=part-number-index"
      label="发送我的零件号"
      modalSource="part-number-index"
    />
  </div>
</BaseLayout>

<script>
  const input = document.getElementById('pn-filter-input') as HTMLInputElement | null;
  const table = document.getElementById('pn-table');
  const empty = document.getElementById('pn-empty');
  const count = document.getElementById('pn-count');
  const chips = Array.from(document.querySelectorAll<HTMLButtonElement>('.pn-chip'));
  const rows = table ? Array.from(table.querySelectorAll<HTMLTableRowElement>('tbody tr')) : [];
  let activeSeries = '';

  const norm = (value: string) => value.toUpperCase().replace(/[^A-Z0-9]/g, '');

  function applyFilters() {
    const raw = (input?.value ?? '').trim();
    const q = norm(raw);
    const qUpper = raw.toUpperCase();
    let visible = 0;
    for (const row of rows) {
      const key = ((row as HTMLElement).dataset.pnKey ?? '').toUpperCase();
      // 中文子串匹配（品名检索）+ 字母数字归一化匹配（零件号片段检索）
      const matchesText = !raw || key.includes(qUpper) || (q.length > 0 && norm(key).includes(q));
      const series = (row as HTMLElement).dataset.pnSeries ?? '';
      const matchesSeries = !activeSeries || series.split(', ').includes(activeSeries);
      const show = matchesText && matchesSeries;
      row.style.display = show ? '' : 'none';
      if (show) visible++;
    }
    if (empty) empty.hidden = visible > 0;
    if (count) {
      count.textContent = raw || activeSeries
        ? `${visible} / ${rows.length} 个零件号`
        : `${rows.length} 个零件号`;
    }
  }

  input?.addEventListener('input', applyFilters);
  chips.forEach((chip) => {
    chip.addEventListener('click', () => {
      chips.forEach((c) => c.classList.remove('is-active'));
      chip.classList.add('is-active');
      activeSeries = chip.dataset.series ?? '';
      applyFilters();
    });
  });

  // The header search form submits to /part-number-index/?q=… (also the
  // SearchAction target). The build is static, so the frontmatter filter only
  // activates under SSR — on the static build the filter is applied here on
  // load from the URL, which keeps the query URL directly usable.
  const urlQuery = new URLSearchParams(window.location.search).get('q');
  if (urlQuery && input) {
    input.value = urlQuery;
    applyFilters();
  }
</script>

<style>
  .pn-server-query {
    margin: 0 0 16px;
    color: #475569;
  }

  .xref-filter {
    display: flex;
    gap: 12px;
    align-items: center;
    margin-bottom: 16px;
  }

  .xref-filter input {
    flex: 1;
    border: 1px solid var(--color-stroke, #d7dee8);
    border-radius: 6px;
    padding: 12px 14px;
    font: inherit;
  }

  .xref-filter__count {
    color: #64748b;
    font-size: 14px;
    white-space: nowrap;
  }

  .pn-series-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 16px;
  }

  .pn-chip {
    border: 1px solid var(--color-stroke, #d7dee8);
    background: #fff;
    border-radius: 999px;
    padding: 6px 14px;
    font: inherit;
    font-size: 14px;
    color: #334155;
    cursor: pointer;
  }

  .pn-chip:hover {
    border-color: var(--color-primary, #146ef5);
    color: var(--color-primary, #146ef5);
  }

  .pn-chip.is-active {
    background: var(--color-primary, #146ef5);
    border-color: var(--color-primary, #146ef5);
    color: #fff;
  }

  .pn-chip__count {
    opacity: 0.7;
    font-size: 12px;
    margin-left: 2px;
  }

  .xref-table-wrap {
    overflow-x: auto;
  }

  .xref-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 15px;
  }

  .xref-table th,
  .xref-table td {
    padding: 10px 12px;
    border-bottom: 1px solid #e2e8f0;
    text-align: left;
    vertical-align: top;
  }

  .xref-table th {
    background: #f8fafc;
    font-weight: 700;
    position: sticky;
    top: 0;
  }

  .xref-table a {
    color: var(--color-primary, #146ef5);
    font-weight: 700;
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    white-space: nowrap;
  }

  .pn-de {
    color: #475569;
  }

  .xref-empty {
    padding: 24px;
    text-align: center;
    color: #475569;
  }

  .resource-faq-item {
    border: 1px solid #e2e8f0;
    border-radius: 8px;
    padding: 14px 16px;
    margin-bottom: 10px;
  }

  .resource-faq-item summary {
    cursor: pointer;
    font-weight: 700;
  }

  .resource-faq-item p {
    margin: 10px 0 0;
    color: #475569;
    line-height: 1.6;
  }
</style>
