---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BreadcrumbHero from '../../components/BreadcrumbHero.astro';
import BlogCta from '../../components/BlogCta.astro';
import FunnelPageView from '../../components/FunnelPageView.astro';
import TermsNav from '../../components/TermsNav.astro';
import { breadcrumbSchema, site } from '../../data/site';
import '../../styles/terms-page.css';
---

<BaseLayout
  title="运输与物流 — 发动机零件全球配送 | 柴油零件源"
  description="柴油发动机零件运输选项：DHL/FedEx 快递、空运与海运，EXW、FOB、DDP 贸易术语说明。"
  currentPath="/terms/shipping"
  jsonLd={breadcrumbSchema([
    { name: '首页', url: site.url },
    { name: '运输条款', url: `${site.url}/terms/shipping/` },
  ])}
>
  <FunnelPageView stage="signing" label="shipping-terms" />
  <BreadcrumbHero
    title="运输与物流"
    trail={[
      { label: '首页', href: '/' },
      { label: '运输条款' },
    ]}
    variant="5"
  />

  <section class="blog-details-section terms-page-section">
    <div class="section-gap bottom">
      <div class="container">
        <article class="blog-details-content-block terms-page fade-in">
          <TermsNav active="shipping" />

          <p class="terms-intro">
            我们从上海向全球发运柴油发动机零件。急件与小订单选快递，重货与大订单选货运——贸易术语（Incoterm）与承运商以您的报价单为准。
          </p>

          <div class="terms-meta" aria-label="运输概览">
            <span><strong>DHL / FedEx / UPS</strong> 快递</span>
            <span>大宗货件走空运与海运</span>
            <span><strong>EXW · FOB · DDP</strong> 贸易术语</span>
            <span>运输时效 <strong>3–45</strong> 天（视方式而定）</span>
          </div>

          <div class="terms-rfq-strip">
            <p>请在询价单（RFQ）中注明目的地、贸易术语与紧急程度——我们将在报价中确认承运商、运输时效与运费。</p>
            <a href="/contact/?source=shipping-terms" class="terms-rfq-link">在询价单中确认</a>
          </div>

          <div class="terms-table-wrap">
            <table class="terms-table">
              <caption class="terms-table-caption">运输方式、时效与典型适用场景</caption>
              <thead>
                <tr>
                  <th scope="col">方式</th>
                  <th scope="col">运输时效</th>
                  <th scope="col">典型适用</th>
                </tr>
              </thead>
              <tbody>
                <tr>
                  <td><strong>国际快递</strong>（DHL / FedEx / UPS）</td>
                  <td>至北美与欧洲 3–7 个工作日</td>
                  <td>紧急故障件与 50 kg 以下订单</td>
                </tr>
                <tr>
                  <td><strong>空运</strong></td>
                  <td>7–14 天</td>
                  <td>保养清单与中型大修订单</td>
                </tr>
                <tr>
                  <td><strong>海运</strong>（FCL / LCL）</td>
                  <td>25–45 天</td>
                  <td>大型大修清单、气缸盖及其他重型零件</td>
                </tr>
              </tbody>
            </table>
          </div>

          <nav class="terms-jump-nav" aria-label="本页导航">
            <a href="#express-courier" class="terms-jump-link">国际快递</a>
            <a href="#air-sea-freight" class="terms-jump-link">空运与海运</a>
            <a href="#incoterms" class="terms-jump-link">贸易术语</a>
          </nav>

          <h2 id="express-courier">国际快递（急件与小订单）</h2>
          <ul class="terms-list">
            <li>门到门派送追踪；备妥商业发票与 HS 编码</li>
            <li>如需要，对机加工面与密封面采取防潮包装</li>
            <li>尾款须于发货前付清，详见<a href="/terms/payment/">付款条款 →</a></li>
          </ul>

          <h2 id="air-sea-freight">空运与海运（大额与重型订单）</h2>
          <ul class="terms-list">
            <li>采用托盘或木箱包装，随附装箱单；如需，提供原产地证书</li>
            <li>进口关税与清关按下方约定的贸易术语执行</li>
            <li>按单采购（sourced-to-order）行项的寻源交货期与运输时效分开报价</li>
          </ul>

          <h2 id="incoterms">我们支持的贸易术语</h2>
          <div class="terms-table-wrap">
            <table class="terms-table">
              <caption class="terms-table-caption">支持的贸易术语及买卖双方责任划分</caption>
              <thead>
                <tr>
                  <th scope="col">术语</th>
                  <th scope="col">含义</th>
                </tr>
              </thead>
              <tbody>
                <tr>
                  <td><strong>EXW</strong></td>
                  <td>买方安排到我方场地提货，并承担全部运费</td>
                </tr>
                <tr>
                  <td><strong>FOB</strong></td>
                  <td>我们负责交货至港口；买方负责海运/空运及进口事宜</td>
                </tr>
                <tr>
                  <td><strong>DDP</strong></td>
                  <td>完税后交货至您门口（报价含运费与进口费用）</td>
                </tr>
              </tbody>
            </table>
          </div>

          <div class="terms-note">
            <strong>物流提示：</strong>请在询价单（RFQ）中注明您倾向的贸易术语与目的地——DDP 报价需要您提前提供送货地址及进口合规要求。术语定义可参阅我们的<a href="/terms/shipping/">贸易术语表</a>。
          </div>

          <p class="terms-related">
            <a href="/terms/shipping/">贸易术语表</a>
            <span aria-hidden="true">·</span>
            <a href="/terms/payment/">付款条款</a>
            <span aria-hidden="true">·</span>
            <a href="/terms/samples/">样品政策</a>
            <span aria-hidden="true">·</span>
            <a href="/about/">项目实绩</a>
            <span aria-hidden="true">·</span>
            <a href="/contact/?source=shipping-terms">申请运输报价 →</a>
          </p>
        </article>
      </div>
    </div>
  </section>

  <BlogCta
    stage="signing"
    topic="shipping"
    title="在报价中确认运输安排"
    text="发送您的零件号，并注明目的地、贸易术语与紧急程度——我们将在报价回复中确认承运商、运输时效与运费。"
    primaryLabel="获取报价"
    primaryHref="/contact/?source=shipping-terms"
    primaryEvent="shipping_terms_rfq"
    secondaryLabel="付款条款"
    secondaryHref="/terms/payment/"
    secondaryEvent="shipping_terms_payment"
  />
</BaseLayout>
