---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BreadcrumbHero from '../../components/BreadcrumbHero.astro';
import BlogCta from '../../components/BlogCta.astro';
import FunnelPageView from '../../components/FunnelPageView.astro';
import TermsNav from '../../components/TermsNav.astro';
import { breadcrumbSchema, site } from '../../data/site';
import '../../styles/terms-page.css';
---

<BaseLayout
  title="样品与试订单政策 — 发动机零件 | 国晁动力"
  description="如何以 MTU 与柴油发动机零件的小额试订单起步：试订单内容、到货核验、发货前照片，以及如何转入重复订单或框架订单。"
  currentPath="/terms/samples"
  jsonLd={breadcrumbSchema([
    { name: '首页', url: site.url },
    { name: '样品政策', url: `${site.url}/terms/samples/` },
  ])}
>
  <FunnelPageView stage="signing" label="sample-policy" />
  <BreadcrumbHero
    title="样品与试订单政策"
    trail={[
      { label: '首页', href: '/' },
      { label: '样品政策' },
    ]}
    variant="5"
  />

  <section class="blog-details-section terms-page-section">
    <div class="section-gap bottom">
      <div class="container">
        <article class="blog-details-content-block terms-page fade-in">
          <TermsNav active="samples" />

          <p class="terms-intro">
            许多买方在与新供应商合作前，会先下一笔小额试订单（trial order），再提交完整的保养或大修清单。本页说明试订单与我们的合作方式，以及在加购前您可以核验的内容。
          </p>

          <div class="terms-meta" aria-label="试订单概览">
            <span><strong>付费试订单</strong></span>
            <span>发货<strong>前照片</strong></span>
            <span>单据与正式订单一致</span>
            <span>可发国际快递</span>
          </div>

          <div class="terms-rfq-strip">
            <p>发送您想试单的零件号——我们在一份报价中确认供货情况、供货路线与运费。</p>
            <a href="/contact/?source=sample" class="terms-rfq-link">申请试单报价</a>
          </div>

          <div class="terms-table-wrap">
            <table class="terms-table">
              <caption class="terms-table-caption">从试订单到重复供货</caption>
              <thead>
                <tr>
                  <th scope="col">阶段</th>
                  <th scope="col">包含内容</th>
                  <th scope="col">您需核验</th>
                </tr>
              </thead>
              <tbody>
                <tr>
                  <td><strong>试订单</strong></td>
                  <td>取自您实际保养清单的少量行项，报价含供货路线与发货预估</td>
                  <td>报价清晰度与响应速度</td>
                </tr>
                <tr>
                  <td><strong>发货前</strong></td>
                  <td>应要求提供零件、标签与包装照片；装箱单与发票草稿</td>
                  <td>零件标记与您旧件的比对</td>
                </tr>
                <tr>
                  <td><strong>到货时</strong></td>
                  <td>商业发票、装箱单与 HS 编码，与正式订单相同</td>
                  <td>适配、标签、包装与单据</td>
                </tr>
                <tr>
                  <td><strong>重复供货</strong></td>
                  <td>后续订单沿用相同的编号、包装形式与标记</td>
                  <td>各订单间的一致性</td>
                </tr>
              </tbody>
            </table>
          </div>

          <nav class="terms-jump-nav" aria-label="本页导航">
            <a href="#trial-order" class="terms-jump-link">试订单</a>
            <a href="#arrival-check" class="terms-jump-link">到货核验</a>
            <a href="#repeat-supply" class="terms-jump-link">重复供货</a>
          </nav>

          <h2 id="trial-order">试订单零件挑选</h2>
          <ul class="terms-list">
            <li>挑选您经常使用的零件，如滤清器、密封件或传感器，以便与现供应商的对比更有意义</li>
            <li>至少纳入一件较难采购的物品，以观察我们的寻源与货期处理能力</li>
            <li>试订单需预付——详见<a href="/terms/payment/">付款条款 →</a></li>
            <li>对于小额试订单，国际快递通常是最实际的运输方式</li>
          </ul>

          <h2 id="arrival-check">试订单到货核验</h2>
          <ul class="terms-list">
            <li>将零件号、标签与包装同报价单及您的旧件比对</li>
            <li>逐行核对发票、装箱单与外箱标签一致</li>
            <li>可配合使用我们的采购方清单：<a href="/genuine-oem-parts/">如何辨别 MTU 原厂件</a></li>
            <li>如发现任何不符，请在安装前拍照反馈</li>
          </ul>

          <h2 id="repeat-supply">转入重复订单或框架订单</h2>
          <ul class="terms-list">
            <li>试订单核验通过后，即可提交更大的保养与大修清单</li>
            <li>对于常规订单，我们将您偏好的编号、包装与箱唛存档</li>
            <li>重复客户的付款选项详见<a href="/terms/payment/">付款条款</a>页</li>
          </ul>

          <div class="terms-note">
            <strong>采购方提示：</strong>将同一份简短清单发送给您比对中的每一家供应商，并附上发动机出厂编号与目的地，这样报价即可按零件编号、供货路线与到岸成本比较，而不只比较单价。
          </div>

          <p class="terms-related">
            <a href="/certifications/">质量流程</a>
            <span aria-hidden="true">·</span>
            <a href="/about/">关于我们</a>
            <span aria-hidden="true">·</span>
            <a href="/terms/payment/">付款条款</a>
            <span aria-hidden="true">·</span>
            <a href="/terms/shipping/">运输条款</a>
            <span aria-hidden="true">·</span>
            <a href="/contact/?source=sample">申请试单报价 →</a>
          </p>
        </article>
      </div>
    </div>
  </section>

  <BlogCta
    stage="signing"
    topic="samples"
    title="从小额试订单开始"
    text="从您的保养清单中挑选几个零件号发来——我们在一份报价中确认供货情况、供货路线与运费。"
    primaryLabel="申请试单报价"
    primaryHref="/contact/?source=sample"
    primaryEvent="sample_terms_rfq"
    secondaryLabel="质量流程"
    secondaryHref="/certifications/"
    secondaryEvent="sample_terms_inspection"
  />
</BaseLayout>
