---
import BaseLayout from '../layouts/BaseLayout.astro';
import BreadcrumbHero from '../components/BreadcrumbHero.astro';
import DetailPageShell from '../components/DetailPageShell.astro';
import DetailRfqStrip from '../components/DetailRfqStrip.astro';
import { importedPages } from '../data/imported-pages';
import { importedPageContent } from '../data/imported-page-content';
import { breadcrumbSchema, site } from '../data/site';
import '../styles/resource-page.css';

export function getStaticPaths() {
  return importedPages.map((page) => ({
    params: { importedPage: page.slug },
    props: { page },
  }));
}

const { page: basePage } = Astro.props;
const content = importedPageContent[basePage.slug];
const page = content
  ? {
      ...basePage,
      title: content.title ?? basePage.title,
      seoTitle: content.seoTitle ?? basePage.seoTitle,
      summary: content.summary,
    }
  : basePage;
const pageUrl = `${site.url}/${page.slug}/`;
const quoteHref = `/contact/?source=${page.slug.replace(/[^a-z0-9]+/gi, '-')}`;
const slugText = page.slug.toLowerCase();
const pageText = `${page.slug} ${page.title} ${page.section} ${page.summary}`.toLowerCase();
const isCategoryPage = slugText.startsWith('categories/');
const isPartPage = slugText.startsWith('part/');
const isNewsPage = slugText.startsWith('news/') || slugText.startsWith('news-category/');
const isStrategicImportedPage =
  /^(part\/mtu-(183-parts|538-parts|1800-parts|specialized-tools)$|stock$|support-services$|genuine-oem-parts$|mtu-oils$|mtu-coolants$|series-4000|rail-drive-solutions$)/i.test(page.slug);
const shouldNoindex = !isStrategicImportedPage;

const pageKind = isPartPage
  ? '零件族'
  : isCategoryPage
    ? '发动机类别'
    : isNewsPage
      ? '资料更新'
      : '支持主题';
const applicationContext = pageText.includes('marine')
  ? '船舶推进、船用辅助发动机与船厂服务'
  : pageText.includes('generator') || pageText.includes('power')
    ? '发电机组、备用电源与电站维护'
    : pageText.includes('rail')
      ? '轨交发动机服务与机群计划维护'
      : pageText.includes('cummins')
        ? 'Cummins 工业、发电与设备发动机服务'
        : pageText.includes('deutz')
          ? 'DEUTZ 工业设备、泵与压缩机发动机服务'
          : '柴油发动机维护、更换与出口采购';
const sourcingChecklist = isPartPage
  ? ['比较选项前，先确认发动机系列与确切零件号', '原编号较旧时，核查替代或替换参考号', '发送数量、目的地与紧急程度，以便库存与运输一并报价']
  : isCategoryPage
    ? ['用类别缩小发动机系列、功率与应用范围', '维护清单涉及多台发动机时，将相关型号合并为一次询价', '发送询价前，先链接到确切的产品或零件号页面']
    : isNewsPage
      ? ['将该更新作为背景信息，下单前再核验确切发动机型号', '不要仅凭文章文本假设兼容性', '发货前发送零件号与照片以供确认']
      : ['说明服务情况与要求的交付窗口', '零件号不明时，附上发动机铭牌与旧件照片', '放行前确认包装、单证与国际运输路线'];
const uniqueAngle = isPartPage
  ? `${page.title} 页面应帮助采购方从宽泛的 MTU 零件族走向逐项的准确询价。`
  : isCategoryPage
    ? `${page.title} 作为类别中心页很有用，能将采购方引向正确的发动机系列与相关零件页面。`
    : isNewsPage
      ? `${page.title} 视为背景信息，而非独立的适配保证。`
      : `${page.title} 在解释采购流程中某一具体支持步骤时很有用。`;
---

<BaseLayout
  title={page.seoTitle}
  description={content ? page.summary : `${page.summary} 请询价确认供货情况、替代核验与从上海出发的全球运输支持。`}
  currentPath="/products"
  image="/images/mtu-engine-parts-hero.webp"
  noindex={shouldNoindex}
  jsonLd={[
    breadcrumbSchema([
      { name: '首页', url: site.url },
      { name: page.section, url: pageUrl },
      { name: page.title, url: pageUrl },
    ]),
  ]}
>
  <BreadcrumbHero
    title={page.title}
    trail={[
      { label: '首页', href: '/' },
      { label: page.section },
      { label: page.title },
    ]}
    variant="3"
  />

  <DetailPageShell intro={page.summary}>
    <img
      slot="hero"
      src="/images/mtu-engine-parts-hero.webp"
      alt={`${page.title} 零件询价`}
      width="1400"
      height="692"
      loading="eager"
      fetchpriority="high"
      decoding="async"
    />

    <div class="resource-meta">
      <span><strong>栏目</strong> {page.section}</span>
      <span><strong>支持</strong> 零件询价</span>
      <span><strong>核验</strong> 型号与出厂编号</span>
      <span><strong>交付</strong> 全球运输</span>
    </div>

    <DetailRfqStrip
      quoteHref={quoteHref}
      title={`请求 ${page.title} 相关支持`}
      text="请发送发动机型号、出厂编号、零件号、数量、目的地与要求交付日期。"
      secondaryHref="/part-products/"
      secondaryLabel="浏览 MTU 零件号"
    />

    {content ? (
      <Fragment set:html={content.body} />
    ) : (
      <>
        <h2>{page.title} 采购支持</h2>
        <p>
          本{pageKind}页面帮助采购方整理与 {page.title} 相关的询价。柴油零件源 在报价前核查零件参考号、发动机详情、替代状态、库存路线与运输选项。
        </p>
        <p>{uniqueAngle}</p>

        <h2>{page.title} 应用场景</h2>
        <p>
          采购方通常在处理{applicationContext}时使用本页面。最关键的是发动机应用与随询价一并发送的确切零件详情之间的联系。
        </p>

        <h2>我们可以为 {page.title} 核验什么</h2>
        <ul>
          <li>发动机型号、功率、出厂编号与应用详情</li>
          <li>零件号、替代参考号、照片与数量</li>
          <li>库存供货情况、交货期、包装与国际运输路线</li>
        </ul>

        <h2>如何使用本页</h2>
        <ul>
          {sourcingChecklist.map((item) => <li>{item}</li>)}
        </ul>
      </>
    )}

    <h2>有用链接</h2>
    <ul>
      <li><a href="/part-products/">MTU 零件号</a></li>
      <li><a href="/part-products/catalog/mtu-2000-series/">MTU 2000 系列目录</a></li>
      <li><a href="/part-products/catalog/mtu-4000-series/">MTU 4000 系列目录</a></li>
      <li><a href="/contact/">发送零件询价</a></li>
    </ul>
  </DetailPageShell>
</BaseLayout>
