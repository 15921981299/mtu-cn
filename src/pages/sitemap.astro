---
import BaseLayout from '../layouts/BaseLayout.astro';
import BreadcrumbHero from '../components/BreadcrumbHero.astro';
import { services } from '../data/services';
import { products, isProductPageNoindex } from '../data/products';
import { productSubpages } from '../data/product-subpages';
import { industries } from '../data/industries';
import { applications } from '../data/applications';
import { mtuCatalogHubs } from '../data/mtu-parts';
import { serviceArticles } from '../data/service-content';
import { isSubpageNoindex } from '../data/subpage-quality';
import { breadcrumbSchema, site } from '../data/site';
import '../styles/resource-page.css';

const corePages = [
  { href: '/', label: '首页' },
  { href: '/products/', label: '产品' },
  { href: '/capabilities/', label: '服务与支持' },
  { href: '/industries/', label: '行业' },
  { href: '/applications/', label: '应用' },
  { href: '/part-products/', label: '零件指南' },
  { href: '/certifications/', label: '质量与认证' },
  { href: '/about/', label: '关于我们' },
  { href: '/contact/', label: '发送零件询价' },
];

const toolPages = [
  { href: '/products/mtu-spare-parts/mtu-part-number-lookup/', label: 'MTU 零件号查询' },
  { href: '/products/mtu-spare-parts/mtu-engine-series-guide/', label: 'MTU 发动机系列指南' },
  { href: '/products/mtu-2000-series-parts/marine-generator-service-parts/', label: 'MTU 2000 船用与发电零件' },
  { href: '/products/mtu-2000-series-parts/16v-2000-engine-parts/', label: 'MTU 16V 2000 发动机零件' },
  { href: '/products/mtu-2000-series-parts/mtu-m96l-engine-parts/', label: 'MTU 16V 2000 M96L 发动机零件' },
  { href: '/series/mtu-396/', label: 'MTU 396 系列中心页' },
  { href: '/series/mtu-2000/', label: 'MTU 2000 系列中心页' },
  { href: '/series/mtu-396-variants/', label: 'MTU 396 变型解码' },
  { href: '/series/mtu-2000-variants/', label: 'MTU 2000 变型解码' },
  { href: '/series/mtu-1163/', label: 'MTU 1163 系列中心页' },
  { href: '/series/mtu-1163-variants/', label: 'MTU 1163 变型解码' },
  { href: '/series/mtu-4000-variants/', label: 'MTU 4000 变型解码' },
  { href: '/series/16v2000m96/', label: 'MTU 16V 2000 M96 备件' },
  { href: '/series/12v396te94/', label: 'MTU 12V 396 TE94 备件' },
  { href: '/products/mtu-4000-series-parts/overhaul-parts/', label: 'MTU 4000 大修零件' },
  { href: '/products/mtu-4000-series-parts/12v-4000-engine-parts/', label: 'MTU 12V 4000 发动机零件' },
  { href: '/products/mtu-4000-series-parts/16v-4000-engine-parts/', label: 'MTU 16V 4000 发动机零件' },
  { href: '/products/mtu-series-8000-engines/', label: 'MTU 8000 系列发动机零件' },
  { href: '/products/cummins-parts/service-kits-and-overhaul-parts/', label: 'Cummins 维修包与大修零件' },
  { href: '/products/deutz-parts/industrial-equipment-parts/', label: 'DEUTZ 工业设备零件' },
  { href: '/llm-instructions/', label: 'LLM / AI 说明' },
  { href: '/guides/', label: '发动机零件指南' },
  { href: '/insights/', label: '故障排查与备件采购' },
  { href: '/guides/how-to-read-mtu-parts-diagram/', label: '如何阅读 MTU 零件图' },
  { href: '/catalog/', label: 'MTU 零件目录 PDF 下载' },
  { href: '/cross-reference/', label: '零件号交叉引用' },
  { href: '/part-number-index/', label: '零件号索引（EN · DE）' },
  { href: '/products/mtu-spare-parts/mtu-genset-parts-by-power/', label: '按功率分组的 MTU 发电机组零件' },
  { href: '/products/mtu-spare-parts/mtu-overhaul-kits/', label: 'MTU 大修包（顶部 / 在架 / 全套）' },
  { href: '/products/mtu-spare-parts/mtu-1600-series-parts/', label: 'MTU 1600 系列与 F 构型型号' },
  { href: '/products/mtu-spare-parts/mtu-legacy-gas-engine-parts/', label: 'MTU 经典系列与气体发动机' },
  { href: '/engine-models/', label: '按发动机型号列出的零件清单' },
  { href: '/how-to-source-mtu-parts/', label: '分销商还是独立供应商？' },
];

const termsPages = [
  { href: '/terms/payment/', label: '付款条款' },
  { href: '/terms/shipping/', label: '运输条款' },
  { href: '/terms/samples/', label: '样品条款' },
  { href: '/privacy/', label: '隐私政策' },
];

const capabilityLinks = services.map((s) => ({ href: `/capabilities/${s.slug}/`, label: s.title }));
const productLinks = products
  .filter((product) => product.slug !== 'mtu-2000-series' && !isProductPageNoindex(product))
  .map((product) => ({ href: `/products/${product.slug}/`, label: product.title }));
const productSubLinks = productSubpages
  .filter((sp) => !isSubpageNoindex(sp.productSlug, sp.slug))
  .map((sp) => ({ href: `/products/${sp.productSlug}/${sp.slug}/`, label: sp.title }));
const industryLinks = industries.map((i) => ({ href: `/industries/${i.slug}/`, label: i.title }));
const applicationLinks = applications.map((a) => ({ href: `/applications/${a.slug}/`, label: a.title }));
const catalogLinks = mtuCatalogHubs.map((hub) => ({
  href: `/part-products/catalog/${hub.slug}/`,
  label: hub.h1Title,
}));

const sections = [
  { title: '主要页面', items: corePages },
  { title: '服务与支持', items: capabilityLinks },
  { title: '发动机零件', items: productLinks },
  { title: '零件指南', items: productSubLinks },
  { title: 'MTU 零件目录', items: catalogLinks },
  { title: '行业', items: industryLinks },
  { title: '应用', items: applicationLinks },
  { title: '资源', items: toolPages },
  { title: '故障与采购文章', items: serviceArticles.map((article) => ({ href: `/insights/${article.slug}/`, label: article.title })) },
  { title: '条款与政策', items: termsPages },
];

const totalLinks = sections.reduce((sum, s) => sum + s.items.length, 0);
---

<BaseLayout
  title="网站地图 — 国晁动力"
  description="国晁动力完整 HTML 网站地图——浏览柴油发动机零件、MTU 零件指南、服务支持、行业、应用与联系页面。"
  currentPath="/sitemap"
  jsonLd={breadcrumbSchema([
    { name: '首页', url: site.url },
    { name: '网站地图', url: `${site.url}/sitemap/` },
  ])}
>
  <BreadcrumbHero
    title="网站地图"
    trail={[
      { label: '首页', href: '/' },
      { label: '网站地图' },
    ]}
    variant="1"
  />

  <section class="blog-details-section resource-page-section">
    <div class="section-gap bottom">
      <div class="container">
        <article class="blog-details-content-block resource-page fade-in">
          <p class="resource-intro">
            国晁动力的全部重点页面汇集一处——共 {totalLinks} 个链接，涵盖发动机零件、服务支持、行业、应用、资源与条款。
          </p>

          {sections.map((section) => (
            section.items.length > 0 && (
              <section class="sitemap-section">
                <h2 class="sitemap-section-title">{section.title} <span class="sitemap-count">({section.items.length})</span></h2>
                <ul class="sitemap-list">
                  {section.items.map((item) => (
                    <li><a href={item.href}>{item.label}</a></li>
                  ))}
                </ul>
              </section>
            )
          ))}
        </article>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .sitemap-section {
    margin: 0 0 28px;
  }
  .sitemap-section-title {
    margin: 0 0 12px;
    padding-bottom: 8px;
    border-bottom: 1px solid var(--color-stroke);
    font-size: 18px;
    font-weight: 600;
    color: var(--color-title);
    text-transform: none;
  }
  .sitemap-count {
    font-size: 13px;
    font-weight: 500;
    color: var(--color-body-text);
    opacity: 0.7;
  }
  .sitemap-list {
    list-style: none;
    margin: 0;
    padding: 0;
    columns: 3;
    column-gap: 28px;
  }
  .sitemap-list li {
    margin: 0 0 8px;
    break-inside: avoid;
    font-size: 14px;
    line-height: 1.5;
  }
  .sitemap-list a {
    color: var(--color-body-text);
    text-decoration: none;
  }
  .sitemap-list a:hover {
    color: var(--color-primary);
    text-decoration: underline;
  }
  .sitemap-list a:focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: 2px;
    border-radius: 2px;
  }
  @media (max-width: 767px) {
    .sitemap-list {
      columns: 2;
    }
  }
  @media (max-width: 479px) {
    .sitemap-list {
      columns: 1;
    }
  }
</style>
