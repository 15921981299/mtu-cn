---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import BreadcrumbHero from '../../../components/BreadcrumbHero.astro';
import FunnelPageView from '../../../components/FunnelPageView.astro';
import DetailRfqStrip from '../../../components/DetailRfqStrip.astro';
import { isPartPageIndexable, mtuParts, type MtuPart } from '../../../data/mtu-parts';
import { modelApplication, parseModels } from '../../../data/engine-models';
import { breadcrumbSchema, faqSchema, site } from '../../../data/site';
import '../../../styles/resource-page.css';

/**
 * MTU genset parts by power rating.
 *
 * The angle competitors do not cover: buyers arrive with a power rating
 * ("I need parts for a 1,600 kW set"), not a model code. The power band
 * points at the engine model, the model code points at the parts list.
 *
 * Power figures are typical 50 Hz prime ratings published by genset
 * packagers for these engine models (multiple independent packager tables
 * agree). Ratings vary by set configuration, site conditions, and
 * frequency — the rating plate and engine nameplate always govern.
 */

type Band = {
  engine: string;
  cylinders: string;
  primeKw: string;
  note: string;
};

const bands2000: Band[] = [
  { engine: '12V 2000 G25', cylinders: '12 V', primeKw: '520–580', note: '入门功率段；单体泵喷射' },
  { engine: '12V 2000 G65', cylinders: '12 V', primeKw: '630–640', note: '' },
  { engine: '12V 2000 G45', cylinders: '12 V', primeKw: '640', note: '' },
  { engine: '12V 2000 G85', cylinders: '12 V', primeKw: '720–744', note: '' },
  { engine: '16V 2000 G25', cylinders: '16 V', primeKw: '720–740', note: '' },
  { engine: '16V 2000 G65', cylinders: '16 V', primeKw: '800', note: '' },
  { engine: '16V 2000 G45', cylinders: '16 V', primeKw: '800–840', note: '' },
  { engine: '16V 2000 G85', cylinders: '16 V', primeKw: '900–920', note: '' },
  { engine: '18V 2000 G65', cylinders: '18 V', primeKw: '900', note: '' },
  { engine: '18V 2000 G26F', cylinders: '18 V', primeKw: '1,000', note: '' },
  { engine: '18V 2000 G85', cylinders: '18 V', primeKw: '1,000–1,092', note: '2000 系列最高功率段' },
];

const bands4000: Band[] = [
  { engine: '12V 4000 G23', cylinders: '12 V', primeKw: '1,100–1,200', note: '' },
  { engine: '12V 4000 G43', cylinders: '12 V', primeKw: '1,360–1,400', note: '' },
  { engine: '12V 4000 G63', cylinders: '12 V', primeKw: '1,400–1,440', note: '' },
  { engine: '12V 4000 G83', cylinders: '12 V', primeKw: '1,600', note: '' },
  { engine: '16V 4000 G23', cylinders: '16 V', primeKw: '1,600–1,650', note: '' },
  { engine: '16V 4000 G43', cylinders: '16 V', primeKw: '1,800–1,850', note: '' },
  { engine: '16V 4000 G63', cylinders: '16 V', primeKw: '1,760–1,800', note: '' },
  { engine: '16V 4000 G83', cylinders: '16 V', primeKw: '2,000–2,100', note: '' },
  { engine: '20V 4000 G23', cylinders: '20 V', primeKw: '2,000', note: '' },
  { engine: '20V 4000 G43', cylinders: '20 V', primeKw: '2,250–2,300', note: '' },
  { engine: '20V 4000 G63', cylinders: '20 V', primeKw: '2,200–2,250', note: '' },
  { engine: '20V 4000 G83', cylinders: '20 V', primeKw: '2,500–2,550', note: '' },
  { engine: '20V 4000 G83L', cylinders: '20 V', primeKw: '2,800', note: '4000 系列最高功率段' },
];

/** Parts the catalog data actually references for genset (G/L-rated) models. */
function gensetPartsForSeries(series: string, limit = 8): MtuPart[] {
  return mtuParts
    .filter((part) => {
      if (!isPartPageIndexable(part)) return false;
      const models = parseModels(part.applicableEngines);
      return models.some((model) => {
        const app = modelApplication(model);
        return app?.includes('generator') && `MTU ${model.series}` === series;
      });
    })
    .sort((a, b) => a.partNumber.localeCompare(b.partNumber))
    .slice(0, limit);
}

/** Every indexed part referenced against any genset-rated model. */
const gensetPartTotal = mtuParts.filter((part) => {
  if (!isPartPageIndexable(part)) return false;
  return parseModels(part.applicableEngines).some((model) => modelApplication(model)?.includes('generator'));
}).length;

const seriesBlocks = [
  {
    series: 'MTU 2000',
    heading: '2000 系列发电机组 — 主用功率约 520–1,100 kW',
    text: '建筑、医院、数据中心与工业场所备用与主用电源的主力功率段。2000 系列发电发动机采用电控单体泵喷射而非共轨系统，因此喷油器与油泵参考同 4000 系列不同。',
    bands: bands2000,
    hubHref: '/part-products/catalog/mtu-2000-series/',
    hubLabel: 'MTU 2000 配件目录',
  },
  {
    series: 'MTU 4000',
    heading: '4000 系列发电机组 — 主用功率约 1,100–2,800 kW',
    text: '面向公用事业、重工业与数据中心的大型备用与主用电源机组。4000 系列发电发动机采用高压共轨；同一发动机家族还有 M 代码的船用推进型号，其涡轮增压、冷却与控制零件均有不同。',
    bands: bands4000,
    hubHref: '/part-products/catalog/mtu-4000-series/',
    hubLabel: 'MTU 4000 配件目录',
  },
];

const legacyNote =
  '老款发电用途同样见于老机型系列：12V 183 TB32、12V/16V/20V 956 TB33 与 TB34，以及 8V/12V/16V/20V 396 第 3 组发动机（TB34、TC34、TE34 及 R/D 变型），在目录数据中均属恒速发电应用。询价时请提供完整型号代码，我们将核查该具体构型的零件参考。';

const pageUrl = `${site.url}/products/mtu-spare-parts/mtu-genset-parts-by-power/`;
const faqItems = [
  {
    question: '如何按功率段查找发电机组配件？',
    answer:
      '先将机组功率铭牌与上表功率段对应，横向读取发动机型号，再提供发动机铭牌上的完整型号代码与出厂编号。功率段用于缩小发动机型号范围；型号代码与出厂编号才能确定确切的零件清单。50 Hz 与 60 Hz 机组之间、不同成套商之间的功率均有差异，一律以铭牌为准。',
  },
  {
    question: '同一系列的发电用配件与船用配件相同吗？',
    answer:
      '部分相同。滤清器、密封件、垫片、皮带与许多保养件在同系列内通用，但应用代码决定了关键部件。G 代码发电发动机通常为散热器冷却、无海水回路，其喷油器、涡轮增压器、冷却零件与发动机控制可能与同系列的 M 代码船用发动机不同。报价一律以完整型号代码为准。',
  },
  {
    question: '型号代码中的 G（或 L）代表什么？',
    answer:
      '在现行 MTU 命名规则中，G 代表柴油发电机组功率，L 代表气体发电机组功率。M 为船用推进，R 为轨交，S 为工业变速，P 为油气，C 为矿用。在 396、956、1163 等老系列中，增压代号后的第一位数字为应用组别——第 3 组即恒速发电用途。',
  },
  {
    question: '发电用途通常最先需要哪些配件？',
    answer:
      '计划性发电维护以机油、燃油与空气滤清器、传动皮带、冷却液节温器、软管与卡箍、报警传感器、蓄电池充电零件及垫片组为主。其余项目取决于运行小时数与负载曲线——高小时数机组还需关注喷油器、油泵、涡轮增压器与冷却系统。请提供运行小时数，我们将提出分阶段清单。',
  },
];
---

<BaseLayout
  title="MTU 发电机组配件按功率段 — 520 至 2,800 kW"
  description="MTU 发电机组配件按功率段整理。将机组功率对应到发动机型号（12V/16V/18V/20V 2000 与 4000 G 系列），再按型号代码与出厂编号核实确切零件清单。"
  currentPath="/products/mtu-spare-parts/mtu-genset-parts-by-power"
  jsonLd={[
    breadcrumbSchema([
      { name: '首页', url: site.url },
      { name: '产品', url: `${site.url}/products/` },
      { name: 'MTU 备件', url: `${site.url}/products/mtu-spare-parts/` },
      { name: '按功率段的发电机组配件', url: pageUrl },
    ]),
    faqSchema(faqItems),
  ]}
>
  <FunnelPageView stage="selection" label="genset-parts-by-power" />
  <BreadcrumbHero
    title="MTU 发电机组配件按功率段"
    trail={[
      { label: '首页', href: '/' },
      { label: '产品', href: '/products/' },
      { label: 'MTU 备件', href: '/products/mtu-spare-parts/' },
      { label: '按功率段的发电机组配件' },
    ]}
    variant="2"
  />

  <div class="resource-page">
    <section class="resource-page-section">
      <p>
        多数发电机组询价带着功率段而来——「1,600 kW 备用机组的配件」——而不是型号代码。本页正是为弥合这一差距：功率段指向发动机型号，型号代码指向零件清单。下列功率段覆盖现役
        <strong>2000 系列（约 520–1,100 kW）</strong>与<strong>4000 系列（约 1,100–2,800 kW）</strong>
        柴油发电发动机，并附老机型发电用途说明。
      </p>
      <p>
        <strong>{gensetPartTotal} 个已索引零件号</strong>在目录数据中对应发电额定发动机型号——下文按系列列出。
      </p>
      <p class="resource-note">
        功率数据为发电成套商公布的典型 50 Hz 主用功率。功率随机组配置、频率、海拔与温度而变化——一律以机组功率铭牌与发动机铭牌为准。请先用功率段初步定位，再提供完整型号代码与出厂编号以供核验。
      </p>
    </section>

    {seriesBlocks.map((block) => (
      <section class="resource-page-section">
        <h2>{block.heading}</h2>
        <p>{block.text}</p>
        <div class="xref-table-wrap">
          <table class="xref-table">
            <thead>
              <tr>
                <th scope="col">发动机型号</th>
                <th scope="col">结构形式</th>
                <th scope="col">典型主用功率（kW，50 Hz）</th>
                <th scope="col">备注</th>
              </tr>
            </thead>
            <tbody>
              {block.bands.map((band) => (
                <tr>
                  <td class="pn-engine">{band.engine}</td>
                  <td>{band.cylinders}</td>
                  <td class="pn-kw">{band.primeKw}</td>
                  <td>{band.note || '—'}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>

        {(() => {
          const parts = gensetPartsForSeries(block.series);
          return parts.length >= 3 ? (
            <div class="genset-parts">
              <h3>目录中 {block.series} 发电型号引用的零件</h3>
              <p class="genset-parts__intro">
                摘自本站索引目录数据中该系列发电额定发动机的示例——可打开零件页查看适配说明，或按保养计划发送完整清单。
              </p>
              <ul class="genset-parts__list">
                {parts.map((part) => (
                  <li>
                    <a href={`/part-products/${part.slug}/`}>{part.partNumber}</a>
                    <span>{part.name}</span>
                  </li>
                ))}
              </ul>
              <p class="genset-parts__more">
                在 <a href={block.hubHref}>{block.hubLabel}</a> 中浏览整个系列，或在 <a href="/part-number-index/">零件号索引</a> 中筛选全部零件号。
              </p>
            </div>
          ) : (
            <p class="genset-parts__more">
              整系列参考见 <a href={block.hubHref}>{block.hubLabel}</a>——可在 <a href="/part-number-index/">零件号索引</a> 中筛选全部零件号，或提供型号代码与出厂编号，获取按您的发动机制定的清单。
            </p>
          );
        })()}
      </section>
    ))}

    <section class="resource-page-section">
      <h2>老机型发电发动机</h2>
      <p>{legacyNote}</p>
    </section>

    <section class="resource-page-section">
      <h2>功率变化会改变什么——又不会改变什么</h2>
      <p>
        同一系列内，功率更高不只是调校不同。喷油器、高压油泵与油管、涡轮增压器、增压空气与冷却部件以及发动机控制零件都会不同。滤清器、密封件、垫片、皮带、节温器与许多传感器通常全系列通用——这正是按错误变型报价的保养包在纸面上依然看似合理的原因。
      </p>
      <h3>提供功率段时请一并提供以下信息</h3>
      <ul>
        <li>铭牌上的完整发动机型号代码（例如 16V 4000 G63 或 12V 2000 G65）</li>
        <li>发动机出厂编号与运行小时数</li>
        <li>机组功率铭牌：主用或备用，kW 或 kVA，50 Hz 或 60 Hz</li>
        <li>零件号、数量与保养期限</li>
        <li>应用类型：备用、主用或连续——负载曲线影响磨损件</li>
      </ul>
    </section>

    <section class="resource-page-section">
      <h2>发电机组配件常见问题</h2>
      {faqItems.map((item) => (
        <details class="resource-faq-item">
          <summary>{item.question}</summary>
          <p>{item.answer}</p>
        </details>
      ))}
    </section>

    <DetailRfqStrip
      title="正在制定发电机组备件清单？"
      text="请提供发动机型号、出厂编号、运行小时数与零件清单。我们将在报价前按确切的功率与构型核验零件参考。"
      quoteHref="/contact/?source=genset-parts-by-power"
      label="发送我的机组信息"
      modalSource="genset-parts-by-power"
    />
  </div>
</BaseLayout>

<style>
  .pn-engine {
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-weight: 700;
    white-space: nowrap;
  }

  .pn-kw {
    font-weight: 700;
    white-space: nowrap;
  }

  .genset-parts {
    margin-top: 24px;
    border: 1px solid #e2e8f0;
    border-radius: 10px;
    padding: 18px 20px;
    background: #f8fafc;
  }

  .genset-parts h3 {
    margin: 0 0 6px;
    font-size: 17px;
  }

  .genset-parts__intro {
    margin: 0 0 12px;
    color: #475569;
    font-size: 14px;
  }

  .genset-parts__list {
    list-style: none;
    margin: 0 0 12px;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 8px 20px;
  }

  .genset-parts__list li {
    font-size: 14px;
    display: flex;
    gap: 8px;
    align-items: baseline;
  }

  .genset-parts__list a {
    color: var(--color-primary, #146ef5);
    font-weight: 700;
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    white-space: nowrap;
  }

  .genset-parts__list span {
    color: #475569;
  }

  .genset-parts__more {
    margin: 0;
    font-size: 14px;
    color: #475569;
  }

  .xref-table-wrap {
    overflow-x: auto;
  }

  .xref-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 15px;
  }

  .xref-table th,
  .xref-table td {
    padding: 10px 12px;
    border-bottom: 1px solid #e2e8f0;
    text-align: left;
    vertical-align: top;
  }

  .xref-table th {
    background: #f8fafc;
    font-weight: 700;
  }

  .resource-faq-item {
    border: 1px solid #e2e8f0;
    border-radius: 8px;
    padding: 14px 16px;
    margin-bottom: 10px;
  }

  .resource-faq-item summary {
    cursor: pointer;
    font-weight: 700;
  }

  .resource-faq-item p {
    margin: 10px 0 0;
    color: #475569;
    line-height: 1.6;
  }
</style>
