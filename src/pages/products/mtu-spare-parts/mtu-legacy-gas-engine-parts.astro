---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import BreadcrumbHero from '../../../components/BreadcrumbHero.astro';
import FunnelPageView from '../../../components/FunnelPageView.astro';
import DetailRfqStrip from '../../../components/DetailRfqStrip.astro';
import { mtuParts } from '../../../data/mtu-parts';
import { parseModels } from '../../../data/engine-models';
import { breadcrumbSchema, faqSchema, site } from '../../../data/site';
import '../../../styles/resource-page.css';

/**
 * Legacy series and gas-engine coverage.
 *
 * The indexed catalog data covers Series 183 through 1163 plus the current
 * 2000/4000 platforms. Older numeric series (331, 493, 652, 8000) and the
 * gas-rated L models are real MTU products with real fleets, but they are
 * not in the index — this page routes those enquiries instead of publishing
 * empty pages per series.
 */

type Coverage = {
  family: string;
  era: string;
  indexStatus: string;
  note: string;
};

const families: Coverage[] = [
  {
    family: '183 系列',
    era: '老机型，量产数十年',
    indexStatus: '已索引',
    note: '8V/12V 183 与 6R 183 参考已收录于目录数据——详见按发动机型号划分的零件清单。',
  },
  {
    family: '331 系列',
    era: '老机型',
    indexStatus: '按询价',
    note: '较早的直列与 V 型构型。请提供型号代码与出厂编号；参考逐行确认。',
  },
  {
    family: '396 系列',
    era: '老机型',
    indexStatus: '已索引',
    note: '第 3 组代码为恒速发电用途；其余组别为船用。零件清单按发动机型号发布。',
  },
  {
    family: '493 系列',
    era: '老机型',
    indexStatus: '按询价',
    note: '较小的老系列。确认任何参考前须提供型号代码与出厂编号。',
  },
  {
    family: '538 系列',
    era: '老机型',
    indexStatus: '已索引',
    note: '12V/16V/20V 538 参考已收录于目录数据。',
  },
  {
    family: '595 系列',
    era: '老机型',
    indexStatus: '已索引',
    note: '12V/16V 595 TC/TE 参考已收录于目录数据。',
  },
  {
    family: '652 系列',
    era: '老机型',
    indexStatus: '按询价',
    note: '较早的直列系列，仍在船用与工业领域服役。按行逐项报价。',
  },
  {
    family: '8000 系列',
    era: '大型老平台',
    indexStatus: '按询价',
    note: '超大排量发动机，装机量小。询价单独核查。',
  },
  {
    family: '956 / 1163 系列',
    era: '老机型',
    indexStatus: '已索引',
    note: 'TB/TE/TC 参考已收录于目录数据，含发电第 3 组代码。',
  },
  {
    family: '气体发动机（L 代码）',
    era: '现役',
    indexStatus: '按询价',
    note: 'MTU 气体发电发动机（L 代码）使用天然气或沼气，其点火、燃油计量与火花相关部件均与柴油发动机不同。按型号代码逐行报价。',
  },
  {
    family: '2000 / 4000 系列（G 代码柴油发电）',
    era: '现役',
    indexStatus: '已索引',
    note: 'G 型号的柴油发电参考已收录于目录数据——详见按功率段的发电机组配件。',
  },
];

/** Series actually present in the indexed catalog data, for an honest count. */
const coveredSeries = new Set<string>();
for (const part of mtuParts) {
  for (const model of parseModels(part.applicableEngines)) {
    coveredSeries.add(model.series);
  }
}

const pageUrl = `${site.url}/products/mtu-spare-parts/mtu-legacy-gas-engine-parts/`;
const faqItems = [
  {
    question: '我的发动机是目录未收录的 MTU 老系列，还能报价吗？',
    answer:
      '可以。本站索引覆盖参考基础最大的系列（183、396、538、595、956、1163、2000、4000）。对于 331、493、652、8000 及其他老构型，我们依据型号代码与出厂编号逐行处理——未收录索引绝不等于无货。',
  },
  {
    question: '气体发动机配件与柴油配件有区别吗？',
    answer:
      '区别很大。气体发动机以燃气进气、点火与火花相关部件取代柴油喷射装置，其活塞、活塞环与连杆也按不同的燃烧负荷设计。只有「通用」保养件——滤清器、皮带、软管、垫片、传感器——与同缸体家族的柴油发动机通用。',
  },
  {
    question: '如何解读老款 MTU 型号代码？',
    answer:
      '老系列（183、331、396、538、595、652、956、1163）的代码读作：气缸数 + V/R + 系列 + 增压代号 + 两位数字 + 构型。增压代号后的第一位数字为应用组别：第 3 组为恒速发电用途，第 5、6、7、9 组为船用应用。请提供完整代码，我们将与您一同解读。',
  },
  {
    question: '提供哪些信息能让老机型询价最快得到报价？',
    answer:
      '完整型号代码、发动机出厂编号，以及铭牌与所询零件的照片。对于大修项目，请附上运行小时数与已知历史（过热事件、既往翻新记录）——这些决定了哪些参考值得报价、哪些可能已被替代。',
  },
];
---

<BaseLayout
  title="MTU 老系列与气体发动机配件 — 按型号采购"
  description="MTU 老系列（183–8000）与气体发动机（L 代码）覆盖：本站收录了哪些内容，哪些按型号代码与出厂编号逐行报价。"
  currentPath="/products/mtu-spare-parts/mtu-legacy-gas-engine-parts"
  jsonLd={[
    breadcrumbSchema([
      { name: '首页', url: site.url },
      { name: '产品', url: `${site.url}/products/` },
      { name: 'MTU 备件', url: `${site.url}/products/mtu-spare-parts/` },
      { name: '老系列与气体发动机', url: pageUrl },
    ]),
    faqSchema(faqItems),
  ]}
>
  <FunnelPageView stage="selection" label="mtu-legacy-gas-engine-parts" />
  <BreadcrumbHero
    title="MTU 老系列与气体发动机"
    trail={[
      { label: '首页', href: '/' },
      { label: '产品', href: '/products/' },
      { label: 'MTU 备件', href: '/products/mtu-spare-parts/' },
      { label: '老系列与气体发动机' },
    ]}
    variant="2"
  />

  <div class="resource-page">
    <section class="resource-page-section">
      <p>
        MTU 生产的发动机型号家族之多，任何一份零件清单都无法覆盖。本站索引目录数据覆盖 <strong>{coveredSeries.size} 个系列</strong>——183、396、538、595、956、1163、2000 与 4000——这些系列的参考基础最大。更早的系列与气体额定发动机按<strong>型号代码与出厂编号逐行报价</strong>，而非发布空页面。
      </p>
      <p class="resource-note">
        「已索引」表示零件页与发动机型号清单已在本站发布。「按询价」表示该型号是真实的 MTU 产品，我们单独采购并报价——并不代表无货。
      </p>
    </section>

    <section class="resource-page-section">
      <h2>按发动机家族划分的覆盖范围</h2>
      <div class="xref-table-wrap">
        <table class="xref-table">
          <thead>
            <tr>
              <th scope="col">发动机家族</th>
              <th scope="col">年代</th>
              <th scope="col">索引状态</th>
              <th scope="col">对您的询价意味着什么</th>
            </tr>
          </thead>
          <tbody>
            {families.map((f) => (
              <tr>
                <td class="pn-engine">{f.family}</td>
                <td>{f.era}</td>
                <td>{f.indexStatus}</td>
                <td>{f.note}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <section class="resource-page-section">
      <h2>老机型与气体发动机询价如何报价</h2>
      <div class="catalog-depth-section">
        <div class="catalog-depth-card">
          <h3>01 — 解读代码</h3>
          <p>
            请提供完整型号代码与出厂编号。对于老系列，我们将与您一同解读增压代号、应用组别（第 3 组 = 发电用途，第 5/6/7/9 组 = 船用）与构型数字，使参考集与实机一致。
          </p>
        </div>
        <div class="catalog-depth-card">
          <h3>02 — 逐行确认</h3>
          <p>
            每个零件号都按该具体构型对照供应商数据核查——供货情况、品质等级与替代情况。对于气体发动机，我们还会确认燃油与点火变型，因为这些部件不能与同缸体家族的柴油发动机互换。
          </p>
        </div>
        <div class="catalog-depth-card">
          <h3>03 — 明示缺口的报价</h3>
          <p>
            您将收到逐行供货情况与运输方案，无法确认的行将明确标注。简短而真实的清单胜过冗长的猜测。
          </p>
        </div>
      </div>
    </section>

    <section class="resource-page-section">
      <h2>相关覆盖内容</h2>
      <ul class="catalog-scenarios-list">
        <li>1600 系列与新款 F 构型：<a href="/products/mtu-spare-parts/mtu-1600-series-parts/">MTU 1600 系列配件</a></li>
        <li>按功率段的发电机组配件：<a href="/products/mtu-spare-parts/mtu-genset-parts-by-power/">按功率段的 MTU 发电机组配件</a></li>
        <li>按发动机型号划分的零件清单：<a href="/engine-models/">按型号划分的零件清单</a></li>
        <li>完整零件号索引（EN · DE）：<a href="/part-number-index/">MTU 零件号索引</a></li>
      </ul>
    </section>

    <section class="resource-page-section">
      <h2>老机型与气体发动机常见问题</h2>
      {faqItems.map((item) => (
        <details class="resource-faq-item">
          <summary>{item.question}</summary>
          <p>{item.answer}</p>
        </details>
      ))}
    </section>

    <DetailRfqStrip
      modalContext="老机型 / 气体发动机采购"
      title="请提供型号代码与出厂编号"
      quoteHref="/contact/?source=mtu-legacy-gas-engine-parts"
      modalSource="mtu-legacy-gas-engine-parts"
      text="老系列与气体发动机按行逐项报价。请提供完整型号代码、出厂编号与零件清单——老构型请附铭牌照片。"
    />
  </div>
</BaseLayout>
