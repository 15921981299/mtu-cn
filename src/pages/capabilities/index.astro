---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BreadcrumbHero from '../../components/BreadcrumbHero.astro';
import BlogCta from '../../components/BlogCta.astro';
import FunnelPageView from '../../components/FunnelPageView.astro';
import { additionalServices } from '../../data/additional-services';
import { faqs } from '../../data/faqs';
import { services } from '../../data/services';
import { breadcrumbSchema, faqSchema, site } from '../../data/site';
import '../../styles/resource-page.css';

const featuredSlugs = new Set(['mtu-engine-parts', 'marine-engine-service', 'genuine-oem-parts']);
const additionalLinks: Record<string, string> = {
  '配件识别': '/products/mtu-spare-parts/mtu-part-number-lookup/',
  '库存核查': '/contact/?source=stock-check',
  '出口包装': '/terms/shipping/',
  '全球运输': '/terms/shipping/',
};
const additionalSummaries: Record<string, string> = {
  '配件识别': '报价前核对零件号、发动机型号、出厂编号与铭牌。',
  '库存核查': '为紧急维护与计划性大修清单核查供货情况与替代件。',
  '出口包装': '为发动机零件运输准备国际包装与单据。',
  '全球运输': '自上海向全球买方提供快递、空运与货运。',
};
const chevronIcon = `<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M6 9l6 6 6-6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>`;
---

<BaseLayout
  title="发动机零件服务与支持 —— MTU、Cummins、DEUTZ"
  description="柴油零件源 支持 MTU、Detroit Diesel、Cummins 与 DEUTZ 零件询价，包括零件识别、经核验的采购路线、船用服务、工业服务与全球交付。"
  currentPath="/capabilities"
  jsonLd={[
    breadcrumbSchema([
      { name: '首页', url: site.url },
      { name: '服务能力', url: `${site.url}/capabilities/` },
    ]),
    faqSchema(faqs.map((f) => ({ question: f.question, answer: f.answer }))),
  ]}
>
  <FunnelPageView stage="selection" label="capabilities-index" />
  <BreadcrumbHero
    title="发动机零件<br>服务与支持"
    trail={[
      { label: '首页', href: '/' },
      { label: '服务能力' },
    ]}
    variant="1"
  />

  <section class="blog-details-section detail-page-section">
    <div class="section-gap bottom">
      <div class="container">
        <article class="blog-details-content-block resource-page fade-in">
          <nav class="resource-nav" aria-label="服务能力导航">
            <a href="/capabilities/" class="resource-nav-link active" aria-current="page">
              全部服务
            </a>
            <a href="/products/mtu-spare-parts/" class="resource-nav-link">MTU 零件</a>
            <a href="/products/cummins-parts/" class="resource-nav-link">Cummins</a>
            <a href="/products/deutz-parts/" class="resource-nav-link">DEUTZ</a>
            <a href="/part-products/" class="resource-nav-link resource-nav-all">零件指南</a>
          </nav>

          <p class="resource-intro">
            柴油零件源 支持柴油发动机零件识别、库存核查、经核验采购路线审核、紧急船用服务、工业服务，以及自上海出发的全球交付。
          </p>

          <div class="resource-meta capabilities-meta">
            <span><strong>{services.length}</strong> 个服务领域</span>
            <span>MTU · Cummins · DEUTZ</span>
            <span>零件号 · <strong>出厂编号</strong></span>
          </div>

          <div class="detail-rfq-strip capabilities-rfq-strip">
            <p>请提供零件清单、发动机型号、出厂编号与目的地，我们将核验适配性与运输方案。</p>
            <a href="/contact/?source=capabilities" class="detail-rfq-link">发送零件询价</a>
          </div>

          <nav class="hub-jump-nav resource-nav capabilities-jump-nav" aria-label="本页导航">
            <a href="#core-capabilities" class="resource-nav-link hub-jump-link">核心服务</a>
            <a href="#value-added" class="resource-nav-link hub-jump-link">增值服务</a>
            <a href="#capabilities-faq" class="resource-nav-link hub-jump-link">常见问题</a>
          </nav>

          <section id="core-capabilities" class="hub-section capabilities-hub-section">
            <div class="hub-section-header">
              <h2>核心服务领域</h2>
              <p>面向紧急与计划性维护的 MTU、Cummins、DEUTZ、船用、工业及经核验零件采购支持。</p>
            </div>
            <div class="hub-grid">
              {services.map((service) => (
                <article class:list={['hub-card', 'capabilities-hub-card', { featured: featuredSlugs.has(service.slug) }]}>
                  {featuredSlugs.has(service.slug) && (
                    <span class="capabilities-hub-badge">热门</span>
                  )}
                  <a href={`/capabilities/${service.slug}/`} class="hub-card-image">
                    <img
                      src={service.mainImage}
                      alt={service.title}
                      width="400"
                      height="280"
                      loading="lazy"
                      decoding="async"
                    />
                  </a>
                  <div class="hub-card-body">
                    <h3 class="hub-card-title">
                      <a href={`/capabilities/${service.slug}/`}>{service.title}</a>
                    </h3>
                    <p class="hub-card-summary">{service.summary}</p>
                    <a href={`/capabilities/${service.slug}/`} class="hub-card-link">
                      查看服务 →
                    </a>
                  </div>
                </article>
              ))}
            </div>
          </section>

          <section id="value-added" class="hub-section capabilities-hub-section">
            <div class="hub-section-header">
              <h2>增值服务</h2>
              <p>围绕零件订单的支持服务：零件识别、库存核查、出口包装与全球交付。</p>
            </div>
            <div class="capabilities-addon-grid">
              {additionalServices.map((item) => (
                <a
                  href={additionalLinks[item.title] ?? '/part-products/'}
                  class="capabilities-addon-card"
                >
                  <span class="capabilities-addon-title">{item.title}</span>
                  <span class="capabilities-addon-desc">{additionalSummaries[item.title]}</span>
                  <span class="capabilities-addon-cta">了解更多 →</span>
                </a>
              ))}
            </div>
          </section>

          <div class="resource-note">
            <strong>零件提示：</strong>不确定哪个零件号正确？订购前请
            <a href="/products/mtu-spare-parts/mtu-part-number-lookup/">使用 MTU 零件号查询指南</a>
            ·
            <a href="/products/mtu-spare-parts/mtu-engine-series-guide/">MTU 系列指南</a>
            ·
            <a href="/contact/">发送照片</a>
            进行确认。
          </div>

          <section id="capabilities-faq" class="hub-section capabilities-hub-section">
            <h2 class="hub-faq-heading">服务能力常见问题</h2>
            <div class="hub-faq-list capabilities-faq-list">
              {faqs.slice(0, 6).map((faq) => (
                <details class="hub-faq-item capabilities-faq-item">
                  <summary>
                    <span>{faq.question}</span>
                    <span class="capabilities-faq-chevron" set:html={chevronIcon} />
                  </summary>
                  <p>{faq.answer}</p>
                </details>
              ))}
            </div>
          </section>

          <p class="resource-related">
            <a href="/products/">发动机零件</a>
            <span aria-hidden="true">·</span>
            <a href="/part-products/">零件指南</a>
            <span aria-hidden="true">·</span>
            <a href="/terms/shipping/">运输</a>
            <span aria-hidden="true">·</span>
            <a href="/contact/">联系我们</a>
          </p>
        </article>
      </div>
    </div>
  </section>

  <BlogCta stage="selection" topic="capabilities-index" primaryHref="/contact/?source=capabilities" />
</BaseLayout>

<style>
  .capabilities-rfq-strip {
    margin-bottom: 20px;
  }

  .capabilities-jump-nav {
    margin-bottom: 24px;
  }

  .capabilities-hub-section {
    scroll-margin-top: 100px;
  }

  .capabilities-hub-card {
    position: relative;
    border-radius: 8px;
    overflow: hidden;
  }

  .capabilities-hub-badge {
    position: absolute;
    top: 14px;
    left: 14px;
    z-index: 2;
    padding: 4px 10px;
    border-radius: 999px;
    background: var(--color-primary);
    color: #fff;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    line-height: 1.2;
  }

  .capabilities-hub-card .hub-card-image,
  .capabilities-hub-card .hub-card-title a,
  .capabilities-hub-card .hub-card-link {
    cursor: pointer;
  }

  .capabilities-hub-card .hub-card-image:focus-visible,
  .capabilities-hub-card .hub-card-title a:focus-visible,
  .capabilities-hub-card .hub-card-link:focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: 2px;
  }

  .capabilities-addon-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 14px;
    margin-bottom: 8px;
  }

  .capabilities-addon-card {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 20px 22px;
    background: var(--color-white);
    border: 1px solid var(--color-stroke);
    border-radius: 8px;
    text-decoration: none;
    color: inherit;
    cursor: pointer;
    transition:
      border-color 0.2s ease,
      box-shadow 0.2s ease,
      transform 0.2s ease;
  }

  .capabilities-addon-card:hover {
    border-color: rgba(20, 110, 245, 0.35);
    box-shadow: 0 4px 18px rgba(20, 110, 245, 0.08);
    transform: translateY(-2px);
  }

  .capabilities-addon-card:focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: 2px;
  }

  .capabilities-addon-title {
    font-family: var(--font-title);
    font-size: 16px;
    font-weight: 600;
    color: var(--color-title);
    line-height: 1.35;
  }

  .capabilities-addon-desc {
    flex: 1;
    font-size: 14px;
    line-height: 1.6;
    color: #475569;
  }

  .capabilities-addon-cta {
    font-size: 13px;
    font-weight: 600;
    color: var(--color-primary);
  }

  .capabilities-faq-item summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }

  .capabilities-faq-chevron {
    flex-shrink: 0;
    display: flex;
    color: var(--color-primary);
    transition: transform 0.2s ease;
  }

  .capabilities-faq-item[open] .capabilities-faq-chevron {
    transform: rotate(180deg);
  }

  .capabilities-faq-item summary:focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: 2px;
    border-radius: 2px;
  }

  .resource-nav-link:focus-visible,
  .detail-rfq-link:focus-visible,
  .resource-note a:focus-visible,
  .resource-related a:focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: 2px;
    border-radius: 4px;
  }

  @media (max-width: 768px) {
    .capabilities-addon-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .capabilities-hub-card:hover .hub-card-image img,
    .capabilities-addon-card:hover {
      transform: none;
    }
    .capabilities-faq-chevron {
      transition: none;
    }
  }
</style>
