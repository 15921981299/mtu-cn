---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BreadcrumbHero from '../../components/BreadcrumbHero.astro';
import BlogCta from '../../components/BlogCta.astro';
import FunnelPageView from '../../components/FunnelPageView.astro';
import { industryFaqs } from '../../data/page-faqs';
import { industries } from '../../data/industries';
import { breadcrumbSchema, faqSchema, site } from '../../data/site';
import '../../styles/resource-page.css';

const featuredSlugs = new Set(['marine', 'industrial-engines', 'power-generation']);
const featuredCount = featuredSlugs.size;
---

<BaseLayout
  title="服务行业 —— 船用、工业、发电与铁路发动机零件"
  description="国晁动力为船用、工业发动机、发电、铁路、船厂、维修公司与能源供应商供应柴油发动机零件。"
  currentPath="/industries"
  jsonLd={[
    breadcrumbSchema([
      { name: '首页', url: site.url },
      { name: '行业', url: `${site.url}/industries/` },
    ]),
    faqSchema(industryFaqs.map((f) => ({ question: f.question, answer: f.answer }))),
  ]}
>
  <FunnelPageView stage="selection" label="industries-index" />
  <BreadcrumbHero
    title="服务行业"
    trail={[
      { label: '首页', href: '/' },
      { label: '行业' },
    ]}
    variant="1"
  />

  <section class="blog-details-section resource-page-section">
    <div class="section-gap bottom">
      <div class="container">
        <article class="blog-details-content-block resource-page fade-in">
          <nav class="resource-nav" aria-label="行业导航">
            <a href="/industries/" class="resource-nav-link active" aria-current="page">
              全部行业
            </a>
            <a href="/industries/marine/" class="resource-nav-link">船用</a>
            <a href="/industries/industrial-engines/" class="resource-nav-link">工业</a>
            <a href="/industries/power-generation/" class="resource-nav-link">发电</a>
            <a href="/part-products/" class="resource-nav-link resource-nav-all">零件指南</a>
          </nav>

          <p class="resource-intro">
            国晁动力为在船用、工业、发电、铁路、船厂、维修与能源领域运营 MTU、Detroit Diesel、Cummins 与 DEUTZ 发动机的维护与采购团队提供支持。
          </p>

          <div class="resource-meta">
            <span><strong>{industries.length}</strong> 个买方群体</span>
            <span><strong>{featuredCount}</strong> 个重点行业</span>
            <span>船用 · 工业 · 发电</span>
            <span>按<strong>发动机系列</strong>选零件</span>
          </div>

          <div class="detail-rfq-strip">
            <p>请提供零件清单、发动机型号、出厂编号、数量与目的地，我们将为您的应用场景核验正确的零件。</p>
            <a href="/contact/?source=industries" class="detail-rfq-link">发送零件询价</a>
          </div>

          <div class="hub-grid">
            {industries.map((industry) => (
              <article class:list={['hub-card', { featured: featuredSlugs.has(industry.slug) }]}>
                {featuredSlugs.has(industry.slug) && <span class="hub-featured-badge">重点推荐</span>}
                <a href={`/industries/${industry.slug}/`} class="hub-card-image">
                  <img
                    src={industry.image}
                    alt={industry.title}
                    width="400"
                    height="280"
                    loading="lazy"
                    decoding="async"
                  />
                </a>
                <div class="hub-card-body">
                  <h2 class="hub-card-title">
                    <a href={`/industries/${industry.slug}/`}>{industry.title}</a>
                  </h2>
                  <p class="hub-card-summary">{industry.summary}</p>
                  <a href={`/industries/${industry.slug}/`} class="hub-card-link">
                    查看行业 →
                  </a>
                </div>
              </article>
            ))}
          </div>

          <div class="resource-note">
            <strong>采购提示：</strong>对于船队或大修订单，请尽早发送零件清单，以便一并核查供货情况、替代方案与运费。
          </div>

          <h2 class="hub-faq-heading">发动机零件行业常见问题</h2>
          <div class="hub-faq-list">
            {industryFaqs.map((faq) => (
              <details class="hub-faq-item">
                <summary>{faq.question}</summary>
                <p>{faq.answer}</p>
              </details>
            ))}
          </div>

          <p class="resource-related">
            <a href="/products/mtu-spare-parts/">MTU 备件</a>
            <span aria-hidden="true">·</span>
            <a href="/products/cummins-parts/">Cummins 零件</a>
            <span aria-hidden="true">·</span>
            <a href="/products/deutz-parts/">DEUTZ 零件</a>
            <span aria-hidden="true">·</span>
            <a href="/contact/">联系我们</a>
          </p>
        </article>
      </div>
    </div>
  </section>

  <BlogCta
    stage="selection"
    topic="industries-index"
    title="为您的发动机应用场景核对零件"
    text="请提供零件号、发动机出厂编号、数量与目的地，我们将在报价前确认供货情况与适配性。"
    primaryLabel="发送零件询价"
    primaryHref="/contact/?source=industries"
    primaryEvent="industries_index_rfq"
    secondaryLabel="零件指南"
    secondaryHref="/part-products/"
    secondaryEvent="industries_index_cases"
  />
</BaseLayout>
