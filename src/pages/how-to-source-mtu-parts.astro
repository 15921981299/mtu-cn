---
import BaseLayout from '../layouts/BaseLayout.astro';
import BreadcrumbHero from '../components/BreadcrumbHero.astro';
import FunnelPageView from '../components/FunnelPageView.astro';
import DetailRfqStrip from '../components/DetailRfqStrip.astro';
import { articleSchema, breadcrumbSchema, faqSchema, site } from '../data/site';
import '../styles/resource-page.css';

/**
 * "MTU parts distributors: how to choose" — written to answer the buyer query
 * behind "MTU parts distributors" without claiming to be an authorised
 * distributor. The company's own positioning is independent supplier
 * (/about/, homepage disclaimer), so this page states that plainly and then
 * earns the click by explaining which source is right for which job.
 */

const pageUrl = `${site.url}/how-to-source-mtu-parts/`;

const comparison = [
  {
    question: '各自的定位',
    distributor: '依据与发动机厂商的区域协议，销售全新的工厂包装零件',
    independent: '通过实际可行的路线找到并供应正确的零件',
  },
  {
    question: '所持库存',
    distributor: '以其协议与自身备货计划为限——在现产快流件上最强',
    independent: '无固定范围。按零件号逐一核查供货情况，包括工厂库存与专业翻新厂',
  },
  {
    question: '经典与停产零件',
    distributor: '发动机家族退出主动生产支持后往往受限',
    independent: '往往是更优路线——这正是追溯旧参考号与被替代号最关键的领域',
  },
  {
    question: '保修立场',
    distributor: '发动机仍在制造商保修期内时，通常是路径最清晰的选择',
    independent: '保修随所供零件而定。保修期内的发动机请说明，供货路线会据此界定',
  },
  {
    question: '提供的选项',
    distributor: '通常只有全新 OEM 一条路线',
    independent: '通常有多条路线——全新 OEM、OEM 替代件、再制造换新件或替代件——各自标注并单独报价',
  },
  {
    question: '覆盖范围',
    distributor: '限定区域——区域之外可能完全无法向您销售',
    independent: '跨境发货，因此出口单证、HS 编码与运费是报价的组成部分',
  },
];

const vettingChecklist = [
  '要求对方给出拟供应的零件号，而不只是零件描述',
  '询问它是全新 OEM、OEM 替代件、再制造件还是替代件——并要求在报价书上书面载明',
  '要求对方对照您的发动机出厂编号（而非仅型号名称）确认适配性',
  '如果您手上的参考号较旧，要求提供现行编号及其所替代的编号',
  '在批准运费前索要 HS 编码与运输重量——可避免海关与货代处的意外',
  '询问零件不适配时如何处理、回程运费由谁承担',
  '核查公司可通过企业域名联系，且有可用的电话与可追溯的公司记录',
  '同时比较交货期与价格——晚于船舶开航到达的便宜零件，才是昂贵的选项',
];

const faqs = [
  {
    question: '你们是授权的 MTU 分销商吗？',
    answer:
      '不是。柴油零件源 是独立的柴油发动机零件供应商。我们不是 MTU、Rolls-Royce Power Systems、Detroit Diesel、Cummins 或 DEUTZ 的授权分销商或经销商，也不作此声称。品牌名与零件号仅用于识别采购方所求的零件。每份报价都注明其所提供的供货路线——全新 OEM、OEM 替代件、再制造件或替代件。',
  },
  {
    question: '我该向授权分销商还是独立供应商采购？',
    answer:
      '取决于具体任务，而非原则。如果发动机在制造商保修期内，或零件关乎安全且规格必须可追溯至厂商，授权分销商通常是更稳妥的第一选择。如果零件用于经典发动机、已被替代、需求紧急，或授权渠道无货也无明确交期，拥有实际采购路线的独立供应商往往是唯一能弄到零件的途径。',
  },
  {
    question: '你们有本地办公室或我附近的分销商吗？',
    answer:
      '没有。我们从上海供货并发往全球；不设本地分支或国家分销。这是刻意为之——它使我们能跨发动机系列报价，且对零件去向无任何区域限制。如果您需要本地提货，请告知目的地，我们将运费路线连同价格一并报价。',
  },
  {
    question: '如何知道你们报的零件就是正确的那个？',
    answer:
      '报价注明零件号、供货路线，以及在适配取决于修订版本时，所对照的发动机出厂编号。某编号替代另一编号时，我们会两个都告知。如果报价中有任何与您所求不符之处，请在下单前告知；我们宁愿重新核查，也不愿发错货。',
  },
  {
    question: '如果我在别处已有更优价格怎么办？',
    answer:
      '请发给我们。我们会诚实告知能否匹配。在快流通用件上我们并非总是最便宜的来源，这一点我们会明说，而不是削减报价、拿零件的正确性冒险。在经典与被替代编号上，我们常常是唯一握有已确认编号与交期的来源。',
  },
];

const today = new Date().toISOString().slice(0, 10);
const hasPersonAuthor = Boolean(site.author.name);
---

<BaseLayout
  title="MTU 零件分销商：如何选择"
  description="如何在授权的 MTU 零件分销商与独立供应商之间选择：各自的定位、何时该选哪一方，以及下单前审查任何供货来源的方法。"
  currentPath="/how-to-source-mtu-parts"
  jsonLd={[
    breadcrumbSchema([
      { name: '首页', url: site.url },
      { name: '如何采购 MTU 零件', url: pageUrl },
    ]),
    articleSchema({
      title: 'MTU 零件分销商：如何选择供货来源',
      description:
        '授权分销商还是独立供应商——各自擅长什么、何时该选哪一方，以及向任何来源采购发动机零件前使用的审查清单。',
      url: pageUrl,
      image: `${site.url}/images/engine-parts-verification-desk.webp`,
      datePublished: today,
      dateModified: today,
      authorName: hasPersonAuthor ? site.author.name : site.name,
      authorType: hasPersonAuthor ? 'Person' : 'Organization',
      authorJobTitle: hasPersonAuthor && site.author.jobTitle ? site.author.jobTitle : undefined,
      authorSameAs: hasPersonAuthor && site.author.linkedin ? [site.author.linkedin] : undefined,
    }),
    faqSchema(faqs),
  ]}
>
  <FunnelPageView stage="comparison" label="how-to-source-mtu-parts" />
  <BreadcrumbHero
    title="如何选择 MTU 零件供货来源"
    trail={[{ label: '首页', href: '/' }, { label: '如何采购 MTU 零件' }]}
    variant="2"
  />

  <div class="resource-page">
    <section class="resource-page-section">
      <p>
        采购方搜索<em>MTU 零件分销商</em>之类关键词来到这里时，背后的问题很少是“谁被官方任命”。而是<strong>“谁能真正把正确的零件交到我手上，万一搞错我要付出什么代价？”</strong>本页回答这个问题，而不假装两类供货来源可以互换。
      </p>
      <p>
        本页由独立供应商撰写，因此阅读下一节时请记住这一点：我们既说明授权分销商更合适的场景，也不只讲我们合适的场景。在这个市场上选错代价很高——零件迟到，或适配型号不适配出厂编号区间，其代价远超单件差价。
      </p>
    </section>

    <section class="resource-page-section">
      <h2>两类供货来源</h2>
      <p>
        <strong>授权分销商</strong>与发动机制造商有正式协议。他们在约定区域内，以厂商的零件号销售全新的工厂包装零件，并承担厂商的保修立场。其优势在于规格可直接追溯至制造商，且库存集中于仍在主动生产支持中的发动机零件。
      </p>
      <p>
        <strong>独立供应商</strong>与厂商无协议，也无区域限制。他们通过实际可行的路线找件——厂商库存、向发动机厂商供货的部件制造商、专业翻新厂，或在最坏情况下用替代件。其优势是覆盖与选项，尤其是在授权渠道已经转移的经典发动机上。其劣势在于采购方必须核查提供的是<em>哪一条</em>路线，因为单说“MTU 零件”不说明任何问题。
      </p>
    </section>

    <section class="resource-page-section">
      <h2>各自的定位</h2>
      <div class="cost-table-wrap">
        <table class="cost-table">
          <thead>
            <tr>
              <th scope="col">问题</th>
              <th scope="col">授权分销商</th>
              <th scope="col">独立供应商</th>
            </tr>
          </thead>
          <tbody>
            {comparison.map((row) => (
              <tr>
                <th scope="row">{row.question}</th>
                <td>{row.distributor}</td>
                <td>{row.independent}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <section class="resource-page-section">
      <h2>何时选择哪一方</h2>
      <h3>以下情况找授权分销商</h3>
      <ul class="resource-checklist">
        <li>发动机仍在制造商保修期内，且保修索赔取决于零件的来源</li>
        <li>零件关乎安全，规格必须直接追溯至厂商</li>
        <li>是现产快流件且他们有现货——真品库存是实在的优势</li>
        <li>船级社或合同要求厂商的单证链</li>
      </ul>
      <h3>以下情况找独立供应商</h3>
      <ul class="resource-checklist">
        <li>发动机已经典或退出生产支持，零件号已经变迁</li>
        <li>授权渠道无货也无确认交期，而发动机已经停机</li>
        <li>需要把选项并列摆开——全新 OEM 对 OEM 替代件对再制造换新件</li>
        <li>您在分销商区域之外，他们完全无法向您销售</li>
        <li>您的清单跨多个发动机系列或品牌，希望一份合并报价</li>
      </ul>
    </section>

    <section class="resource-page-section">
      <h2>我们的定位</h2>
      <p>
        直说：<strong>{site.company.legalNameEn} 是独立供应商，不是授权的 MTU 分销商或经销商。</strong>我们不声称制造商授权，我们的任何报价都不应被解读为暗示授权。品牌名与零件号在本站仅用于识别采购方所求的零件。
      </p>
      <p>
        我们所做的是：对照发动机型号与出厂编号核验零件号，列明可行的供货路线，并连同交货期与运费一并报价，让决定基于真实数字而非表面价格。如果授权路线适合您的任务，我们会明说——在我们无法正确供货时，我们也会明说，而不是接下无法正确履行的订单。
      </p>
      <p>
        <a href="/about/">我们的工作方式与谁来做核验</a> ·
        <a href="/genuine-oem-parts/">购买前如何检查 MTU 真品零件</a>
      </p>
    </section>

    <section class="resource-page-section">
      <h2>如何审查任何供货来源（包括我们）</h2>
      <p>
        这些是值得向任何发动机零件供应商提出的问题。它们对授权分销商与独立供应商一视同仁，我们也期望在出具的每一份报价上回答全部问题。
      </p>
      <ul class="resource-checklist">
        {vettingChecklist.map((item) => (
          <li>{item}</li>
        ))}
      </ul>
    </section>

    <section class="resource-page-section">
      <h2>下一步去哪里</h2>
      <ul class="resource-olist">
        <li><a href="/part-products/">MTU 零件号目录</a>——我们供应的零件号，可搜索</li>
        <li><a href="/cross-reference/">零件号交叉引用</a>——OEM 号与被替代号对应到现行参考号</li>
        <li><a href="/guides/how-to-read-mtu-parts-diagram/">如何阅读 MTU 零件图</a>——把图纸编号变成可购买的编号</li>
        <li><a href="/support-services/">采购支持服务</a>——一次请求实际包含什么</li>
        <li><a href="/catalog/">MTU 备件目录（PDF）</a>——按发动机系列下载清单</li>
      </ul>
    </section>

    <section class="resource-page-section">
      <h2>常见问题</h2>
      {faqs.map((item) => (
        <details class="guide-faq-item">
          <summary>{item.question}</summary>
          <p>{item.answer}</p>
        </details>
      ))}
    </section>

    <DetailRfqStrip
      title="发送零件号与发动机详情"
      text="我们会告知哪些供货路线可行、各自成本与所需时间——包括诚实的答案是“去别处看看”的时候。"
      quoteHref="/contact/?source=how-to-source-mtu-parts"
      label="发起零件询价"
      modalSource="how-to-source-mtu-parts"
    />
  </div>
</BaseLayout>

<style>
  .cost-table-wrap {
    overflow-x: auto;
  }

  .cost-table {
    width: 100%;
    min-width: 640px;
    border-collapse: collapse;
    font-size: 15px;
  }

  .cost-table th,
  .cost-table td {
    padding: 12px 14px;
    border-bottom: 1px solid #e2e8f0;
    text-align: left;
    vertical-align: top;
    line-height: 1.55;
  }

  .cost-table thead th {
    background: #f8fafc;
    font-size: 14px;
    color: #0f172a;
    white-space: nowrap;
  }

  .cost-table tbody th {
    font-weight: 600;
    color: #0f172a;
    width: 24%;
  }

  .guide-faq-item {
    border: 1px solid #e2e8f0;
    border-radius: 8px;
    padding: 14px 16px;
    margin-bottom: 10px;
  }

  .guide-faq-item summary {
    cursor: pointer;
    font-weight: 700;
  }

  .guide-faq-item p {
    margin: 10px 0 0;
    color: #475569;
    line-height: 1.6;
  }
</style>
