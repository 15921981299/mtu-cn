---
import BaseLayout from '../layouts/BaseLayout.astro';
import BreadcrumbHero from '../components/BreadcrumbHero.astro';
import BlogCta from '../components/BlogCta.astro';
import FunnelPageView from '../components/FunnelPageView.astro';
import { breadcrumbSchema, site } from '../data/site';
import '../styles/terms-page.css';

const pageUrl = `${site.url}/privacy/`;
const legalName = site.company.legalNameEn;
---

<BaseLayout
  title="隐私政策 — 国晁动力"
  description="国晁动力如何收集、使用和保护通过零件询价表单、邮件与网站分析提交的信息。"
  currentPath="/privacy"
  jsonLd={breadcrumbSchema([
    { name: '首页', url: site.url },
    { name: '隐私政策', url: pageUrl },
  ])}
>
  <FunnelPageView stage="awareness" label="privacy" />
  <BreadcrumbHero
    title="隐私政策"
    trail={[
      { label: '首页', href: '/' },
      { label: '隐私政策' },
    ]}
    variant="5"
  />

  <section class="blog-details-section terms-page-section">
    <div class="section-gap bottom">
      <div class="container">
        <article class="blog-details-content-block terms-page fade-in">
          <p class="terms-intro">
            最后更新：2026 年 6 月 15 日。本政策说明 {legalName}（{site.name}）在您访问
            {site.url.replace('https://', '')} 或提交询价时如何处理信息。
          </p>

          <div class="terms-meta" aria-label="隐私政策概览">
            <span>询价与联系表单</span>
            <span>工程文件处理</span>
            <span>分析与 Cookie</span>
            <span>数据保留最长 <strong>7 年</strong></span>
          </div>

          <nav class="terms-jump-nav" aria-label="本页导航">
            <a href="#information-collected" class="terms-jump-link">收集的信息</a>
            <a href="#how-we-use" class="terms-jump-link">数据使用方式</a>
            <a href="#engineering-files" class="terms-jump-link">工程文件</a>
            <a href="#your-rights" class="terms-jump-link">您的权利</a>
            <a href="#contact" class="terms-jump-link">联系我们</a>
          </nav>

          <h2 id="information-collected">我们收集的信息</h2>
          <ul class="terms-list">
            <li><strong>询价与联系表单：</strong>姓名、公司、邮箱、电话、项目详情，以及您上传的文件（图纸、STEP、PDF）。</li>
            <li><strong>邮件与消息：</strong>为您的订单报价、生产与发货所需的往来通信。</li>
            <li><strong>网站分析：</strong>启用时通过 Google Analytics 收集匿名化使用数据（页面浏览、来源、设备类型）。</li>
            <li><strong>技术日志：</strong>IP 地址、浏览器类型与时间戳，用于安全与滥用防范。</li>
          </ul>

          <h2 id="how-we-use">我们如何使用信息</h2>
          <ul class="terms-list">
            <li>编制您请求的报价、零件核验反馈与零件订单</li>
            <li>就交货期、检验、运输与付款进行沟通</li>
            <li>维护与您的 PO 挂钩的质量记录（流程卡、检验编号、材料批次）</li>
            <li>改进网站内容并衡量营销效果</li>
            <li>遵守法律并执行我们的条款</li>
          </ul>

          <h2 id="engineering-files">工程文件与保密</h2>
          <p>
            图纸与 CAD 文件仅用于为您的零件报价与生产。我们不出售您的设计。需要时可在报价中确认 NDA 条款。如可能，请在上传前移除无关的专有数据。
          </p>

          <h2>信息共享</h2>
          <p>
            我们仅在履行您的订单所必需的范围内，与生产合作伙伴、承运方与支付处理方共享信息。我们不会向数据中介出售个人数据。
          </p>

          <h2>数据保留</h2>
          <p>
            询价文件与订单记录按生产追溯、保修与税务合规所需的期限保存——已完成订单通常最长保留七年，除非您在法律允许的范围内要求提前删除。
          </p>

          <h2>Cookie 与分析</h2>
          <p>
            我们可能将 Cookie 用于分析与表单功能。您可以在浏览器中阻止 Cookie；缺少 Cookie 时部分功能可能无法正常工作。
          </p>

          <h2 id="your-rights">您的权利</h2>
          <p>
            根据您所在地的法律，您可以请求查阅、更正或删除我们持有的个人数据。请使用您询价时所用的邮箱地址联系我们：{' '}
            <a href={`mailto:${site.email}`}>{site.email}</a>。
          </p>

          <h2>国际传输</h2>
          <p>
            数据可能在中国及我们的合作伙伴运营的其他国家处理。我们对 B2B 制造工作流采取合理的安全保障措施。
          </p>

          <h2 id="contact">联系我们</h2>
          <p>
            {legalName}<br />
            邮箱：<a href={`mailto:${site.email}`}>{site.email}</a><br />
            电话：{site.phone}
          </p>

          <p class="terms-related">
            相关：<a href="/terms/payment/">付款条款</a> · <a href="/terms/shipping/">运输条款</a> ·{' '}
            <a href="/contact/">联系我们</a>
          </p>
        </article>
      </div>
    </div>
  </section>

  <BlogCta
    stage="awareness"
    topic="privacy"
    title="对您的询价数据有疑问？"
    text="如对与您的报价或订单相关的个人数据的查阅、更正或删除有疑问，请联系我们。"
    primaryLabel="联系我们"
    primaryHref="/contact/?source=privacy"
    primaryEvent="privacy_contact"
    secondaryLabel="付款条款"
    secondaryHref="/terms/payment/"
    secondaryEvent="privacy_payment"
  />
</BaseLayout>
