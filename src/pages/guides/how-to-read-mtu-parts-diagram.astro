---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BreadcrumbHero from '../../components/BreadcrumbHero.astro';
import FunnelPageView from '../../components/FunnelPageView.astro';
import DetailRfqStrip from '../../components/DetailRfqStrip.astro';
import { mtuParts } from '../../data/mtu-parts';
import { articleSchema, breadcrumbSchema, faqSchema, site } from '../../data/site';
import '../../styles/resource-page.css';

/**
 * "How to read an MTU parts diagram" — a self-contained guide that teaches the
 * reader to go from a diagram/exploded view to a part number and then to a
 * usable RFQ. Everything here is original: the zone map is drawn by us from our
 * own category data. No manufacturer handbook artwork and no supplier artwork is
 * reproduced (copyright + supplier-identity rules).
 */

const pageUrl = `${site.url}/guides/how-to-read-mtu-parts-diagram/`;

const categoryCount = (name: string) => mtuParts.filter((part) => part.category === name).length;

/** Zones are drawn from real category totals so the diagram never overstates coverage. */
const zones = [
  { key: 'valve-train', label: '配气机构', count: categoryCount('Valve train'), href: '/part-products/catalog/mtu-valve-train/' },
  { key: 'gaskets', label: '气缸盖、垫片与密封件', count: categoryCount('Gaskets and seals'), href: '/part-products/catalog/mtu-gasket-kits/' },
  { key: 'pistons', label: '活塞、缸套与活塞环', count: categoryCount('Pistons and liners'), href: '/part-products/catalog/mtu-pistons-liners/' },
  { key: 'bearings', label: '轴承与曲轴', count: categoryCount('Bearings'), href: '/part-products/catalog/mtu-bearings/' },
];

const leftModules = [
  { label: '燃油系统', note: '喷油器、油泵、高压油管', count: categoryCount('Fuel system'), href: '/part-products/catalog/mtu-fuel-pumps/' },
  { label: '滤清器', note: '机油、燃油、空气、冷却液滤芯', count: categoryCount('Filters'), href: '/part-products/catalog/mtu-filters/' },
  { label: '传动元件', note: '齿轮、联轴器、传动轴', count: categoryCount('Drive components'), href: '/part-products/' },
];

const rightModules = [
  { label: '涡轮增压', note: '增压器芯子、壳体、隔热罩', count: categoryCount('Turbocharging'), href: '/part-products/catalog/mtu-turbocharger-parts/' },
  { label: '冷却系统', note: '水泵、叶轮、节温器', count: categoryCount('Cooling system'), href: '/part-products/catalog/mtu-cooling-system/' },
  { label: '传感器与电气', note: '传感器、起动机、交流发电机', count: categoryCount('Sensors and electrical'), href: '/part-products/catalog/mtu-sensors/' },
];

const totalCatalogued = mtuParts.length;

const steps = [
  {
    title: '1. 找到与您发动机世代相符的图纸',
    body: '零件图或爆炸图是针对某一发动机世代绘制的，而不是针对系列名。不同生产批次的两台同标“16V 2000”的发动机，在页面同一位置所示的喷油器、缸套或垫片可能不同。请从图纸编号或铭牌上的发动机代号入手，而不是单凭型号铭牌。',
  },
  {
    title: '2. 按系统而非位置号通览图纸',
    body: '爆炸图按总成布置：气缸盖与配气机构在上，活塞与缸套居中，曲轴箱与轴承在下，燃油、冷却与涡轮增压作为独立子总成绘制。请一次处理一个子总成，并记下图纸上所示的位置号。',
  },
  {
    title: '3. 读位置号，再查它指向的参考号',
    body: '图纸上的位置号是该图纸零件表的索引——它不是零件号。横向读取该位置对应的参考号。在 MTU 图纸上，通常是长的数字参考号；在较早的文档中，可能是带斜杠后缀的短参考号。',
  },
  {
    title: '4. 预期图纸上的参考号已被替代',
    body: '图纸会印刷数十年。从旧图纸上读到的编号经常已被替代，现行供货参考号是另一个编号。这是采购方订错件的头号常见原因，因此该参考号在报价前务必对照出厂编号区间核查。',
  },
  {
    title: '5. 下单前按发动机出厂编号确认',
    body: '图纸告诉您是哪个部位、哪一类零件；发动机出厂编号告诉您您的发动机实际装的是哪个修订版。请将图纸参考号连同出厂编号一并发来，我们会在下单前确认现行编号、供货路线与交货期。',
  },
];

const faqs = [
  {
    question: '可以给我发一份零件图或维修手册吗？',
    answer:
      '我们不分发制造商的图纸或手册——它们由发动机厂商出版，并按厂商自身条款供应。我们能做的是：读取您从自己图纸上抄下的参考号，告诉您现行零件号、互换选项与交货期。请发送位置号、图纸或发动机代号，以及您的发动机出厂编号。',
  },
  {
    question: '我只有旧件的照片，这够吗？',
    answer:
      '通常够。一张清晰的零件照片加上发动机型号与出厂编号，通常足以让我们识别参考号，尤其是原编号钢印在零件上时。请再附一张零件上任何钢印或铸号的照片，并告知它取自哪个部位。',
  },
  {
    question: '为什么同一部位在不同图纸上显示不同的编号？',
    answer:
      '因为图纸属于特定的发动机世代与构型。喷射、冷却与管理系统在不同生产批次中发生过变化，因此早期图纸上某一部位的编号，在后期图纸上是另一个。出厂编号区间决定哪个适用于您的发动机。',
  },
  {
    question: '你们公布每个系统的零件号区间吗？',
    answer:
      '不公布。零件号不存在能清晰对应到某个系统的区间——同一前缀出现在互不相关的组别中，后缀决定具体零件。我们公布所供应的零件号，按系统与发动机系列分组，报价前逐一对照发动机详情核验。请先用上方的系统图按系统浏览，再与我们确认您的参考号。',
  },
];

const today = new Date().toISOString().slice(0, 10);
const hasPersonAuthor = Boolean(site.author.name);
---

<BaseLayout
  title="如何阅读 MTU 零件图"
  description="从 MTU 零件图或爆炸图得到可用的零件号：位置号如何对应参考号、为什么图纸上的编号常被替代，以及如何按发动机出厂编号核验。"
  currentPath="/guides"
  jsonLd={[
    breadcrumbSchema([
      { name: '首页', url: site.url },
      { name: '零件指南', url: `${site.url}/guides/` },
      { name: '如何阅读 MTU 零件图', url: pageUrl },
    ]),
    articleSchema({
      title: '如何阅读 MTU 零件图',
      description:
        '把 MTU 零件图转化为经核验零件号的方法：按系统阅读、位置号与参考号的区别、替代关系，以及出厂编号确认。',
      url: pageUrl,
      image: `${site.url}/images/mtu-4000-series-overhaul-parts.webp`,
      datePublished: today,
      dateModified: today,
      authorName: hasPersonAuthor ? site.author.name : site.name,
      authorType: hasPersonAuthor ? 'Person' : 'Organization',
      authorJobTitle: hasPersonAuthor && site.author.jobTitle ? site.author.jobTitle : undefined,
      authorSameAs: hasPersonAuthor && site.author.linkedin ? [site.author.linkedin] : undefined,
    }),
    faqSchema(faqs),
  ]}
>
  <FunnelPageView stage="service" label="guide-parts-diagram" />
  <BreadcrumbHero
    title="如何阅读 MTU 零件图"
    trail={[
      { label: '首页', href: '/' },
      { label: '零件指南', href: '/guides/' },
      { label: '如何阅读 MTU 零件图' },
    ]}
    variant="3"
  />

  <div class="resource-page">
    <section class="resource-page-section">
      <p>
        零件图或爆炸图是指出所需零件的最快方式，也是最慢的下单方式——因为印在图纸部位旁边的编号，通常<strong>不是</strong>您可以买到的编号。本指南讲解从图纸上读什么、忽略什么，以及如何把它转化为我们能对照您发动机确认的参考号。
      </p>
      <p>
        这是一篇采购指南，不是维修手册。我们不复制制造商图纸，也不公布扭矩值、间隙或装配程序——那些属于您发动机的官方文档。
      </p>
      <div class="resource-meta">
        <span><strong>已收录零件号</strong> {totalCatalogued} 条经核验记录</span>
        <span><strong>分组依据</strong> 发动机系列与系统</span>
        <span><strong>适配核验</strong> 按发动机出厂编号</span>
        {hasPersonAuthor ? (
          <span><strong>审核人</strong> {site.author.name}{site.author.jobTitle ? `，${site.author.jobTitle}` : ''}</span>
        ) : (
          <span><strong>维护方</strong> {site.name} 零件团队</span>
        )}
      </div>
    </section>

    <section class="resource-page-section">
      <h2>零件图上会看到的发动机系统</h2>
      <p>
        下图由我们依据自有目录绘制，因此计数是我们实际持有记录的零件号——而非插图。点击任一系统浏览该组，或在通览图纸时把它当清单用。少量记录位于这些组别之外（通用发动机部件、润滑、进气），可从完整的<a href="/part-products/">零件号目录</a>进入。
      </p>

      <div class="diagram-map-wrap">
        <svg
          class="diagram-map"
          viewBox="0 0 940 546"
          width="100%"
          role="img"
          aria-labelledby="diagram-map-title diagram-map-desc"
          xmlns="http://www.w3.org/2000/svg"
        >
          <title id="diagram-map-title">按爆炸图呈现方式分组的 MTU 发动机系统</title>
          <desc id="diagram-map-desc">
            MTU 主要发动机系统的区块图：中央发动机机体内为配气机构、气缸盖垫片与密封件、活塞与缸套、轴承；左侧为燃油系统、滤清器与传动元件；右侧为涡轮增压、冷却与电气；垫片与密封件横跨整个宽度。
          </desc>

          <text x="40" y="30" class="dm-title">MTU 零件图上的主要系统</text>

          <rect x="300" y="70" width="340" height="380" rx="20" class="dm-block" />
          <text x="470" y="60" class="dm-block-label" text-anchor="middle">发动机机体</text>

          {zones.map((zone, index) => (
            <a href={zone.href} class="dm-link">
              <g class="dm-node">
                <rect x="318" y={88 + index * 90} width="304" height="74" rx="10" class="dm-zone" />
                <text x="336" y={88 + index * 90 + 30} class="dm-zone-label">{zone.label}</text>
                <text x="336" y={88 + index * 90 + 52} class="dm-zone-count">{zone.count} 个零件号 →</text>
              </g>
            </a>
          ))}

          {leftModules.map((module, index) => (
            <a href={module.href} class="dm-link">
              <g class="dm-node">
                <rect x="40" y={88 + index * 121} width="230" height="101" rx="10" class="dm-module" />
                <text x="58" y={88 + index * 121 + 30} class="dm-zone-label">{module.label}</text>
                <text x="58" y={88 + index * 121 + 52} class="dm-module-note">{module.note}</text>
                <text x="58" y={88 + index * 121 + 76} class="dm-zone-count">{module.count} 个零件号 →</text>
              </g>
            </a>
          ))}

          {rightModules.map((module, index) => (
            <a href={module.href} class="dm-link">
              <g class="dm-node">
                <rect x="670" y={88 + index * 121} width="230" height="101" rx="10" class="dm-module" />
                <text x="688" y={88 + index * 121 + 30} class="dm-zone-label">{module.label}</text>
                <text x="688" y={88 + index * 121 + 52} class="dm-module-note">{module.note}</text>
                <text x="688" y={88 + index * 121 + 76} class="dm-zone-count">{module.count} 个零件号 →</text>
              </g>
            </a>
          ))}

          <a href="/part-products/catalog/mtu-gasket-kits/" class="dm-link">
            <g class="dm-node">
              <rect x="40" y="470" width="860" height="56" rx="10" class="dm-band" />
              <text x="58" y="492" class="dm-zone-label">垫片与密封件——上述每个系统中都有</text>
              <text x="58" y="512" class="dm-zone-count">{categoryCount('Gaskets and seals')} 个零件号 →</text>
            </g>
          </a>
        </svg>
      </div>
    </section>

    <section class="resource-page-section">
      <h2>从图纸到零件号</h2>
      <ol class="diagram-steps">
        {steps.map((step) => (
          <li>
            <h3>{step.title}</h3>
            <p>{step.body}</p>
          </li>
        ))}
      </ol>
    </section>

    <section class="resource-page-section">
      <h2>随图纸编号一并提供的信息</h2>
      <p>
        单凭图纸编号不足以报价，因为它不能识别生产修订版本。请一并提供以下信息，我们即可确认现行编号，而不是按可能比您的发动机更旧的图纸报价：
      </p>
      <ul class="resource-checklist">
        <li>图纸上所示的参考号或位置号</li>
        <li>该参考号来源的图纸、零件手册或发动机代号</li>
        <li>铭牌上所示的发动机型号，含完整后缀（例如 12V 4000 M93L）</li>
        <li>发动机出厂编号——它决定适配的零件修订版本</li>
        <li>数量，以及发动机是在用中还是即将大修</li>
        <li>旧件照片，含任何钢印或铸号</li>
        <li>目的地，以便价格与交货期、运费一并报价</li>
      </ul>
      <p>
        如果参考号看不清或完全缺失，也并非死路——发送照片与出厂编号，我们即可从部位与发动机记录中识别它。
      </p>
    </section>

    <section class="resource-page-section">
      <h2>相关参考工具</h2>
      <ul class="resource-olist">
        <li><a href="/engine-models/">按发动机型号列出的零件清单</a>——您型号代码对应的全部已收录零件号，按系统分组</li>
        <li><a href="/cross-reference/">零件号交叉引用</a>——被替代号与 OEM 号对应到我们供应的零件</li>
        <li><a href="/series/mtu-4000-variants/">MTU 4000 变型解码</a>——铭牌上的 M 工况后缀意味着什么</li>
        <li><a href="/part-products/">MTU 零件号目录</a>——全部 {totalCatalogued} 个零件号，可搜索</li>
        <li><a href="/catalog/">目录 PDF 下载</a>——同一索引的可打印、可搜索 PDF，每个系列一个文件</li>
        <li><a href="/how-to-source-mtu-parts/">分销商还是独立供应商</a>——哪条采购路线适合该发动机</li>
        <li><a href="/guides/">全部零件指南</a>——大修规划与系列识别</li>
      </ul>
    </section>

    <section class="resource-page-section">
      <h2>常见问题</h2>
      {faqs.map((item) => (
        <details class="guide-faq-item">
          <summary>{item.question}</summary>
          <p>{item.answer}</p>
        </details>
      ))}
    </section>

    <DetailRfqStrip
      title="发送参考号与出厂编号"
      text="位置号、发动机型号与出厂编号，足以让我们追溯现行零件号并报价供货情况。"
      quoteHref="/contact/?source=guide-parts-diagram"
      label="发起零件询价"
      modalSource="guide-parts-diagram"
    />
  </div>
</BaseLayout>

<style>
  .diagram-map-wrap {
    margin: 8px 0 4px;
    overflow-x: auto;
  }

  .diagram-map {
    min-width: 660px;
    max-width: 940px;
    height: auto;
  }

  .diagram-map .dm-title {
    font-family: inherit;
    font-size: 15px;
    font-weight: 600;
    fill: #0f172a;
  }

  .diagram-map .dm-block {
    fill: #f1f5f9;
    stroke: #cbd5e1;
    stroke-width: 1.5;
  }

  .diagram-map .dm-block-label {
    font-family: inherit;
    font-size: 13px;
    font-weight: 600;
    fill: #64748b;
  }

  .diagram-map .dm-link {
    text-decoration: none;
  }

  .diagram-map .dm-node rect {
    transition: stroke 0.15s ease, fill 0.15s ease;
  }

  .diagram-map .dm-node:hover rect {
    stroke: #146ef5;
  }

  .diagram-map .dm-zone {
    fill: #e3edfd;
    stroke: #a9c6f2;
    stroke-width: 1;
  }

  .diagram-map .dm-module {
    fill: #e8f4ee;
    stroke: #a9d6c1;
    stroke-width: 1;
  }

  .diagram-map .dm-band {
    fill: #eef2f7;
    stroke: #c3d0de;
    stroke-width: 1;
  }

  .diagram-map .dm-zone-label {
    font-family: inherit;
    font-size: 14px;
    font-weight: 600;
    fill: #0f172a;
  }

  .diagram-map .dm-module-note {
    font-family: inherit;
    font-size: 12px;
    fill: #52616f;
  }

  .diagram-map .dm-zone-count {
    font-family: inherit;
    font-size: 12px;
    font-weight: 600;
    fill: #146ef5;
  }

  .diagram-steps {
    margin: 0;
    padding: 0;
    list-style: none;
    counter-reset: step;
  }

  .diagram-steps li {
    border-left: 3px solid #e2e8f0;
    padding: 0 0 4px 18px;
    margin-bottom: 22px;
  }

  .diagram-steps h3 {
    margin: 0 0 6px;
    font-size: 17px;
  }

  .diagram-steps p {
    margin: 0;
  }

  .guide-faq-item {
    border: 1px solid #e2e8f0;
    border-radius: 8px;
    padding: 14px 16px;
    margin-bottom: 10px;
  }

  .guide-faq-item summary {
    cursor: pointer;
    font-weight: 700;
  }

  .guide-faq-item p {
    margin: 10px 0 0;
    color: #475569;
    line-height: 1.6;
  }
</style>
