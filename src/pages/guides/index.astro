---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BreadcrumbHero from '../../components/BreadcrumbHero.astro';
import FunnelPageView from '../../components/FunnelPageView.astro';
import DetailRfqStrip from '../../components/DetailRfqStrip.astro';
import { partsGuides } from '../../data/guides';
import { mtuParts } from '../../data/mtu-parts';
import { breadcrumbSchema, site } from '../../data/site';
import '../../styles/resource-page.css';

const pageUrl = `${site.url}/guides/`;
const guideCards = partsGuides.map((guide) => {
  const seriesSet = new Set(guide.seriesFilter);
  const count = mtuParts.filter((part) => part.series.some((s) => seriesSet.has(s))).length;
  return { guide, count };
});
---

<BaseLayout
  title="发动机零件指南 — 大修规划与系列识别"
  description="面向 MTU 发动机零件的实用采购指南：大修规划清单、系列识别、被替代编号追溯，以及我们按系列供应的经核验零件组。"
  currentPath="/guides"
  jsonLd={[
    breadcrumbSchema([
      { name: '首页', url: site.url },
      { name: '零件指南', url: pageUrl },
    ]),
  ]}
>
  <FunnelPageView stage="service" label="guides-index" />
  <BreadcrumbHero
    title="发动机零件指南"
    trail={[{ label: '首页', href: '/' }, { label: '零件指南' }]}
    variant="3"
  />

  <div class="resource-page">
    <section class="resource-page-section">
      <p>
        采购指南围绕一个原则编写：正确的零件来自发动机的<strong>出厂编号</strong>，而非单凭型号铭牌。每篇指南都将识别清单与我们为该系列供应的经核验零件组相结合——没有凑数内容，没有臆造的规格。
      </p>
    </section>

    <section class="resource-page-section">
      <div class="guides-grid">
        {guideCards.map(({ guide, count }) => (
          <a class="guide-card" href={`/guides/${guide.slug}/`}>
            <h2>{guide.h1}</h2>
            <p>{guide.description}</p>
            <span class="guide-card__meta">内含 {count} 个经核验零件号 →</span>
          </a>
        ))}
      </div>
    </section>

    <section class="resource-page-section">
      <h2>从哪篇指南开始</h2>
      <p>
        如果您在计划一次<strong>大修（Overhaul）</strong>，请从您系列的大修指南开始：其中列出总是要更换的零件组、取决于测量结果的零件组，以及开缸前要收集的信息。如果您手上只有<strong>旧或看不清的零件号</strong>，请将系列识别指南与<a href="/cross-reference/">交叉引用</a>配合使用，后者将较早的编号对应到现行参考号。如果是<strong>单件紧急需求</strong>，可跳过指南，直接搜索<a href="/part-products/">零件号目录</a>。
      </p>
      <h2>指南不能替代什么</h2>
      <p>
        指南帮助您准备准确的询价；但不能替代发动机制造商的维护文档。保养间隔、拧紧扭矩与设定值应始终来自您具体发动机的操作与维护手册。当指南与您的文档不一致时，以您的文档和发动机出厂编号为准，我们会在报价前核查该参考号。
      </p>
    </section>

    <section class="resource-page-section">
      <h2>更多采购工具</h2>
      <ul class="resource-olist">
        <li><a href="/cross-reference/">零件号交叉引用</a>——OEM 号与被替代号对应到我们供应的零件</li>
        <li><a href="/engine-models/">按发动机型号列出的零件清单</a>——您型号代码对应的全部已收录零件号，按系统分组</li>
        <li><a href="/part-products/">MTU 零件号目录</a>——全部零件号，可搜索</li>
        <li><a href="/catalog/">目录 PDF 下载</a>——同一索引的可打印、可搜索 PDF，每个系列一个文件</li>
        <li><a href="/guides/how-to-read-mtu-parts-diagram/">如何阅读零件图</a>——先找位置号，再找其背后的零件号</li>
        <li><a href="/how-to-source-mtu-parts/">分销商还是独立供应商</a>——哪条路线适合您的发动机，我们两者对比下的定位</li>
        <li><a href="/certifications/">质量与认证</a>——零件发货前如何核验</li>
      </ul>
    </section>

    <DetailRfqStrip
      title="跳过阅读——直接发零件号"
      text="零件号、发动机型号与出厂编号，足以进行一次经核验的供货情况检查。"
      quoteHref="/contact/?source=guides-index"
      label="发起零件询价"
      modalSource="guides-index"
    />
  </div>
</BaseLayout>

<style>
  .guides-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 18px;
  }

  .guide-card {
    display: block;
    border: 1px solid #e2e8f0;
    border-radius: 10px;
    padding: 20px;
    color: inherit;
    text-decoration: none;
    transition: border-color 0.15s ease, box-shadow 0.15s ease;
  }

  .guide-card:hover {
    border-color: var(--color-primary, #146ef5);
    box-shadow: 0 8px 24px rgba(15, 23, 42, 0.08);
  }

  .guide-card h2 {
    margin: 0 0 10px;
    font-size: 20px;
    line-height: 1.3;
  }

  .guide-card p {
    margin: 0 0 12px;
    color: #475569;
    font-size: 15px;
    line-height: 1.55;
  }

  .guide-card__meta {
    color: var(--color-primary, #146ef5);
    font-size: 14px;
    font-weight: 700;
  }
</style>
