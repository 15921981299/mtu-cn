---
import BaseLayout from '../layouts/BaseLayout.astro';
import BreadcrumbHero from '../components/BreadcrumbHero.astro';
import FunnelPageView from '../components/FunnelPageView.astro';
import { site, breadcrumbSchema } from '../data/site';
import '../styles/resource-page.css';
import '../styles/hub-list-page.css';
import '../styles/certification-page.css';

const certIcons: Record<string, string> = {
  iso: `<svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8l-6-6z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/><path d="M14 2v6h6M8 13h8M8 17h5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>`,
  automotive: `<svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M14 16H9m10 0h1a1 1 0 001-1v-3.5a1 1 0 00-.684-.948l-4.493-1.498a1 1 0 00-1.316.948V15a1 1 0 001 1h1M6 16H5a1 1 0 01-1-1v-3.5a1 1 0 01.684-.948l4.493-1.498a1 1 0 011.316.948V15a1 1 0 01-1 1h-1M6 11l1.5-4h9L18 11M6 16v2m12-2v2" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>`,
  medical: `<svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M12 8v8M8 12h8M21 12a9 9 0 11-18 0 9 9 0 0118 0z" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>`,
  cmm: `<svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M4 8V4m0 0h4M4 4l5 5m11-1V4m0 0h-4m4 0l-5 5M4 16v4m0 0h4m-4 0l5-5m11 5v-4m0 4h-4m4 0l-5-5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>`,
  material: `<svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M9 3v2m6-2v2M9 19v2m6-2v2M5 9H3m2 6H3m18-6h-2m2 6h-2M7 19h10a2 2 0 002-2V7a2 2 0 00-2-2H7a2 2 0 00-2 2v10a2 2 0 002 2z" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>`,
  dfm: `<svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" stroke="currentColor" stroke-width="1.5"/><path d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" stroke="currentColor" stroke-width="1.5"/></svg>`,
};

const pageUrl = `${site.url}/certifications/`;

const qualityCommitments = [
  {
    title: '零件识别',
    description: '数据可得时，我们依据完整的零件标记、发动机型号、出厂编号与旧件照片审核所询零件。',
    iconKey: 'cmm',
  },
  {
    title: '清晰的供货状态',
    description: '报价会注明所供的确切编号，以及路线属于 OEM、替代件、再制造件还是替代参考号。',
    iconKey: 'dfm',
  },
  {
    title: '供应商单证范围',
    description: '随询价一并提出您需要的 datasheet、证书、检测记录或产地信息。我们会确认所供零件适用哪些单证。',
    iconKey: 'material',
  },
  {
    title: '发货前检查',
    description: '订单确认后，可在发货前要求提供标记与包装照片。可提供的凭证以报价约定为准。',
    iconKey: 'iso',
  },
];

const equipment = [
  { name: '识别', qty: '报价前', capability: '所询编号、发动机出厂编号、旧件标记与替代历史' },
  { name: '所供零件', qty: '报价时', capability: '所供编号、状态、数量、供货情况与交货期' },
  { name: '单证', qty: '按零件', capability: '确认可提供的 datasheet、证书、检测记录或产地单证' },
  { name: '发运', qty: '发货前', capability: '确认标记、包装、运输单证与跟踪范围' },
];

const inspectionSteps = [
  '接收零件号、数量、目的地，以及任何标记或铭牌照片',
  '适配性或替代关系不确定时，核查发动机出厂编号与目录对应关系',
  '就所供编号、状态、交货期、单证范围与交付条款报价',
  '发货前确认标记与包装要求；提供约定的运输单证',
];

const verificationDocuments = [
  {
    label: '供应商供货确认',
    detail: '逐行审核零件号、数量、替代路线与预计交付窗口。',
  },
  {
    label: '铭牌与旧件照片核查',
    detail: '零件号不明时，审核发动机型号、出厂编号、铭牌照片、铸件标记或旧件图片。',
  },
  {
    label: '包装与发货照片',
    detail: '紧急订单、出口包装或高价值总成，可在发货前进行照片确认。',
  },
  {
    label: '按需提供供应商单证',
    detail: '按订单范围匹配可提供的供应商单证、一致性说明、发票、装箱单与出口单据。',
  },
  {
    label: '海关与 HS 编码支持',
    detail: '目的国要求时，为发动机零件订单提供 HS 编码与运输单证支持。',
  },
] as const;
---

<BaseLayout
  title="零件核验与单证 | 国晁动力"
  description="国晁动力在报价与发货前核查发动机零件号、出厂编号、供应商单证、包装要求与交付路线。"
  currentPath="/certifications"
  jsonLd={[
    breadcrumbSchema([
      { name: '首页', url: site.url },
      { name: '质量与认证', url: pageUrl },
    ]),
  ]}
>
  <FunnelPageView stage="signing" event="cert_page_view" label="certifications" />
  <BreadcrumbHero title="零件核验与单证" current="质量" variant="5" />

  <section class="blog-details-section detail-page-section">
    <div class="section-gap bottom">
      <div class="container">
        <article class="blog-details-content-block blog-index-page cert-page fade-in">
          <nav class="resource-nav blog-index-top-nav" aria-label="质量导航">
            <a href="#quality-commitments" class="resource-nav-link">核验范围</a>
            <a href="#inspection-process" class="resource-nav-link">审核步骤</a>
            <a href="#documentation" class="resource-nav-link">单证</a>
            <a href="/about/" class="resource-nav-link resource-nav-all">关于我们</a>
          </nav>

          <header class="blog-index-hero cert-hero">
            <p class="blog-index-kicker">零件识别 · 报价审核</p>
            <p class="blog-index-intro">
              发送零件号与数量即可开始。目录参考号不全时，发动机出厂编号、旧件标记与照片可帮助我们核查适配性。报价会注明所供零件以及可随附的单证。
            </p>
            <div class="blog-index-stats" role="list">
              <span class="blog-index-stat" role="listitem">
                <strong>零件号</strong>
                <span>识别</span>
              </span>
              <span class="blog-index-stat" role="listitem">
                <strong>出厂编号</strong>
                <span>适配核验</span>
              </span>
              <span class="blog-index-stat" role="listitem">
                <strong>报价</strong>
                <span>单证范围</span>
              </span>
            </div>
          </header>

          <div class="blog-index-rfq-strip detail-rfq-strip">
            <p>请在零件询价中一并列出所需单证——供应商单证、包装照片、海关单据或交付期限。下单前我们会确认哪些可以落实。</p>
            <a href="/contact/?source=certifications" class="blog-index-rfq-btn detail-rfq-link" data-rfq-modal data-rfq-context="零件核验与文件索取" data-rfq-source="certifications">请求零件核验</a>
          </div>

          <section id="quality-commitments" class="blog-index-section cert-section">
            <header class="blog-index-section-head">
              <div>
                <h2>核验范围</h2>
                <p>识别与单证范围按所报零件及其供货路线逐项约定。</p>
              </div>
            </header>
            <div class="cert-grid">
              {qualityCommitments.map((c) => (
                <div class="cert-card">
                  <span class="cert-icon" set:html={certIcons[c.iconKey]} />
                  <h3 class="cert-title">{c.title}</h3>
                  <p class="cert-desc">{c.description}</p>
                </div>
              ))}
            </div>
          </section>

          <section id="inspection-process" class="blog-index-section cert-section">
            <header class="blog-index-section-head">
              <div>
                <h2>我们的零件核验流程</h2>
                <p>从零件识别到约定发货单证的四步核查。</p>
              </div>
            </header>
            <div class="inspection-list">
              {inspectionSteps.map((step, i) => (
                <div class="inspection-step">
                  <span class="inspection-num">{String(i + 1).padStart(2, '0')}</span>
                  <span class="inspection-text">{step}</span>
                </div>
              ))}
            </div>
          </section>

          <section id="equipment" class="blog-index-section cert-section">
            <header class="blog-index-section-head">
              <div>
                <h2>采购方可以确认的内容</h2>
                <p>请随零件清单一并提出您需要的凭证，以便下单前核查其可得性。</p>
              </div>
            </header>
            <div class="equip-table-wrap">
              <table class="equip-table">
                <caption class="equip-table-caption">报价与发货审核要点</caption>
                <thead>
                  <tr>
                    <th scope="col">审核要点</th>
                    <th scope="col">阶段</th>
                    <th scope="col">待确认信息</th>
                  </tr>
                </thead>
                <tbody>
                  {equipment.map((e) => (
                    <tr>
                      <td class="equip-name">{e.name}</td>
                      <td class="equip-qty">{e.qty}</td>
                      <td class="equip-cap">{e.capability}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </section>

          <section id="documentation" class="blog-index-section cert-section">
            <header class="blog-index-section-head">
              <div>
                <h2>采购方可要求的单证</h2>
                <p>单证可得性取决于所报供应商与零件。请在确认订单前提出；本页不意味着每个零件都具备全部记录。</p>
              </div>
            </header>
            <div class="verify-doc-grid">
              {verificationDocuments.map((doc) => (
                <div class="verify-doc-card">
                  <h3 class="verify-doc-label">{doc.label}</h3>
                  <p class="verify-doc-detail">{doc.detail}</p>
                </div>
              ))}
            </div>
            <p class="cert-cta-row">
              <a href="/part-products/">MTU 零件号</a>
              <span aria-hidden="true">·</span>
              <a href="/contact/?source=certifications">咨询单证范围 →</a>
            </p>
          </section>

          <footer class="hub-list-footer-links blog-index-footer">
            <a href="/terms/payment/">付款条款</a>
            <span aria-hidden="true">·</span>
            <a href="/terms/shipping/">运输与物流</a>
            <span aria-hidden="true">·</span>
            <a href="/terms/samples/">样品与试单政策</a>
            <span aria-hidden="true">·</span>
            <a href="/part-products/">MTU 零件号</a>
          </footer>
        </article>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .cert-page .cert-hero {
    margin-bottom: 8px;
  }

  .cert-jump {
    margin-bottom: 36px;
  }

  .cert-section {
    scroll-margin-top: 120px;
  }

  .cert-media-section {
    margin-bottom: 40px;
  }

  .cert-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
  }

  @media (max-width: 991px) {
    .cert-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 600px) {
    .cert-grid {
      grid-template-columns: 1fr;
    }
  }

  .cert-card {
    background: var(--color-white);
    border: 1px solid var(--color-stroke);
    border-radius: 10px;
    padding: 24px 22px;
    display: flex;
    flex-direction: column;
    gap: 12px;
    transition:
      border-color 0.22s ease,
      box-shadow 0.22s ease;
  }

  .cert-card:hover {
    border-color: rgba(20, 110, 245, 0.38);
    box-shadow: 0 8px 28px rgba(20, 110, 245, 0.08);
  }

  .cert-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: 10px;
    background: rgba(20, 110, 245, 0.1);
    color: var(--color-primary);
    flex-shrink: 0;
  }

  .cert-title {
    font-size: 17px;
    font-weight: 600;
    color: var(--color-title);
    line-height: 1.35;
    margin: 0;
  }

  .cert-desc {
    font-size: 14px;
    color: #475569;
    line-height: 1.6;
    margin: 0;
  }

  .inspection-list {
    display: flex;
    flex-direction: column;
    gap: 0;
    border: 1px solid var(--color-stroke);
    border-radius: 10px;
    overflow: hidden;
    background: var(--color-white);
  }

  .inspection-step {
    display: flex;
    align-items: center;
    gap: 20px;
    padding: 18px 24px;
    border-bottom: 1px solid var(--color-stroke);
  }

  .inspection-step:last-child {
    border-bottom: none;
  }

  .inspection-num {
    font-family: var(--font-title);
    font-size: 20px;
    font-weight: 600;
    color: var(--color-primary);
    min-width: 32px;
    flex-shrink: 0;
  }

  .inspection-text {
    font-size: 16px;
    color: var(--color-title);
    line-height: 1.5;
  }

  .equip-table-wrap {
    overflow-x: auto;
    border: 1px solid var(--color-stroke);
    border-radius: 10px;
    background: var(--color-white);
  }

  .equip-table-caption {
    padding: 14px 16px 0;
    font-size: 14px;
    font-weight: 600;
    text-align: left;
    color: var(--color-title);
    caption-side: top;
  }

  .equip-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 14px;
  }

  .equip-table th,
  .equip-table td {
    padding: 16px 24px;
    border-bottom: 1px solid var(--color-stroke);
    text-align: left;
    vertical-align: top;
  }

  .equip-table tbody tr:last-child td {
    border-bottom: none;
  }

  .equip-table tbody tr {
    transition: background-color 0.2s ease;
  }

  .equip-table tbody tr:hover {
    background: rgba(20, 110, 245, 0.04);
  }

  .equip-table thead tr {
    background: var(--color-background);
  }

  .equip-table th {
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--color-title);
  }

  .equip-name {
    font-weight: 600;
    color: var(--color-title);
    font-size: 15px;
  }

  .equip-qty {
    color: var(--color-primary);
    font-size: 14px;
    font-weight: 600;
  }

  .equip-cap {
    color: #475569;
    font-size: 14px;
  }

  .industry-proof-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    gap: 16px;
  }

  .industry-proof-card {
    padding: 20px 22px;
    background: var(--color-white);
    border: 1px solid var(--color-stroke);
    border-radius: 10px;
    border-left: 4px solid var(--color-primary);
    transition:
      border-color 0.22s ease,
      box-shadow 0.22s ease;
  }

  .industry-proof-card:hover {
    border-color: rgba(20, 110, 245, 0.35);
    box-shadow: 0 6px 20px rgba(20, 110, 245, 0.08);
  }

  .industry-proof-title {
    margin: 0 0 6px;
    font-size: 17px;
    font-weight: 600;
    line-height: 1.35;
  }

  .industry-proof-title a {
    color: var(--color-title);
    text-decoration: none;
    cursor: pointer;
    transition: color 0.2s ease;
  }

  .industry-proof-title a:hover {
    color: var(--color-primary);
  }

  .industry-proof-meta {
    margin: 0 0 12px;
    font-size: 13px;
    color: #64748b;
  }

  .industry-proof-links {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .industry-proof-links a {
    font-size: 14px;
    font-weight: 600;
    color: var(--color-primary);
    text-decoration: none;
    cursor: pointer;
    transition: color 0.2s ease;
  }

  .industry-proof-links a:hover {
    text-decoration: underline;
  }

  .verify-doc-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    gap: 16px;
  }

  .verify-doc-card {
    padding: 18px 20px;
    background: var(--color-background);
    border: 1px solid var(--color-stroke);
    border-radius: 10px;
    transition:
      border-color 0.22s ease,
      box-shadow 0.22s ease;
  }

  .verify-doc-card:hover {
    border-color: rgba(20, 110, 245, 0.35);
    box-shadow: 0 4px 16px rgba(15, 23, 42, 0.06);
  }

  .verify-doc-label {
    margin: 0 0 8px;
    font-size: 15px;
    font-weight: 600;
    color: var(--color-title);
  }

  .verify-doc-detail {
    margin: 0;
    font-size: 14px;
    line-height: 1.55;
    color: #475569;
  }

  .verify-doc-sample {
    display: inline-block;
    margin-top: 10px;
    font-size: 13px;
    font-weight: 600;
    color: var(--color-primary);
    text-decoration: none;
    cursor: pointer;
    transition: color 0.2s ease;
  }

  .verify-doc-sample:hover {
    text-decoration: underline;
  }

  .cert-cta-row {
    margin-top: 24px;
    text-align: center;
    font-size: 14px;
    font-weight: 600;
    color: var(--color-body-text);
  }

  .cert-cta-row a {
    color: var(--color-primary);
    text-decoration: none;
    cursor: pointer;
  }

  .cert-cta-row a:hover {
    text-decoration: underline;
  }

  .cert-cta-row span {
    margin: 0 8px;
    opacity: 0.45;
  }

  .featured-proof-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 16px;
  }

  .featured-proof-card {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 18px 20px;
    background: var(--color-white);
    border: 1px solid var(--color-stroke);
    border-radius: 10px;
    text-decoration: none;
    cursor: pointer;
    transition:
      border-color 0.22s ease,
      box-shadow 0.22s ease;
  }

  .featured-proof-card:hover {
    border-color: rgba(20, 110, 245, 0.4);
    box-shadow: 0 8px 28px rgba(20, 110, 245, 0.1);
  }

  .featured-proof-industry {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-primary);
  }

  .featured-proof-title {
    font-size: 16px;
    font-weight: 600;
    color: var(--color-title);
    line-height: 1.35;
  }

  .featured-proof-spec {
    font-size: 13px;
    color: #64748b;
  }

  .hub-list-jump-link:focus-visible,
  .detail-rfq-link:focus-visible,
  .industry-proof-title a:focus-visible,
  .industry-proof-links a:focus-visible,
  .verify-doc-sample:focus-visible,
  .cert-cta-row a:focus-visible,
  .hub-list-footer-links a:focus-visible,
  .featured-proof-card:focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: 2px;
    border-radius: 4px;
  }

  .hub-list-jump-link:focus-visible {
    border-radius: 999px;
  }

  .featured-proof-card:focus-visible {
    border-radius: 10px;
