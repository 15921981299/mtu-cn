    title: '垫片、密封件与 O 型圈',
    href: '/part-products/catalog/mtu-gasket-kits/',
    parts: getHomepageGroupParts((part) => /gasket|seal|o-?ring|washer|plug/i.test(`${part.name} ${part.category}`)),
  },
  {
    title: '燃油、冷却与增压',
    href: '/part-products/catalog/mtu-4000-fuel-system-parts/',
    parts: getHomepageGroupParts((part) => /injector|fuel|pump|coolant|water|impeller|turbo|turbine/i.test(`${part.name} ${part.category}`)),
  },
].filter((group) => group.parts.length > 0);

---

<BaseLayout
  title="MTU 发动机零件供应商 | 柴油零件源"
  description="总部位于上海的柴油发动机零件供应商，专注 MTU 发动机零件与备件。收录 800+ 个零件号，提供适配核验、库存核查与从上海出发的全球交付服务。"
  currentPath="/"
  jsonLd={[
    ...homepageVideos,
    itemListSchema(
      homepageHotParts.map((part) => ({
        name: `${part.partNumber} ${zhPartName(part.name)}`,
        url: `${site.url}/part-products/${part.slug}/`,
      }))
    ),
  ]}
>
  <FunnelPageView stage="selection" label="homepage" />
  <!-- ═══ HERO ═══ -->
  <section class="hero-section">
    <div class="container">
      <div class="hero-wrapper">
        <div class="hero-content-block">
          <div class="hero-subtitle-block fade-in">
            <img
              src="/images/precision-manufacturing-badge-icon.svg"
              alt="精密制造图标"
              class="hero-subtitle-icon"
              width="24"
              height="24"
              loading="eager"
              decoding="async"
            />
            <div class="hero-subtitle-text">
              {site.tagline}
            </div>
          </div>
          <div class="hero-title-block">
            <h1 class="hero-title fade-in">
              选对 MTU 零件，<br />发货前完成核验
            </h1>
          </div>
          <div class="hero-bottom-content-block">
            <div class="hero-summary-block">
              <p class="hero-summary">
                总部位于上海的柴油发动机零件供应商，专注 MTU 备件。发送零件号、型号代码或铭牌照片，我们即可核验适配性、追溯被替代的编号，并在每条报价中注明供货等级。
              </p>
            </div>
            <div class="hero-button-block">
              <div class="hero-cta-row">
                <a href="/contact/?source=homepage" class="secondary-button hero">
                  <div class="button-content-block">
                    <div class="button-text">零件询价</div>
                    <div class="button-text">零件询价</div>
                  </div>
                </a>
                <a href="/products/mtu-spare-parts/" class="hero-secondary-cta">MTU 备件</a>
              </div>
              <ul class="hero-trust-row" aria-label="核心服务保障">
                <li>已收录 {mtuParts.length}+ 个 MTU 零件号</li>
                <li>10 个发动机系列 — 从 183 到 8000</li>
                <li>每条报价均标注供货等级</li>
                <li>从上海发往全球</li>
              </ul>
            </div>
          </div>
        </div>
        <div class="hero-image-block">
          <img
            src="/images/mtu-engine-parts-hero.webp"
            alt="MTU 柴油发动机备件，包括喷油器、滤清器、涡轮增压器（Turbocharger）、泵、传感器、垫片与密封件"
            class="hero-image"
            width="800"
            height="649"
            loading="eager"
            fetchpriority="high"
            decoding="async"
          />
          <div class="hero-image-overlay image-overlay fade-in"></div>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══ PART IDENTIFICATION SERVICE (P1) ═══ -->
  <section class="identify-section section-gap bottom" aria-labelledby="identify-heading">
    <div class="container">
      <SectionHeading
        title="零件识别服务"
        subtitle="信息不全也足以开始"
      />
      <div class="identify-grid fade-in">
        {
          identificationSteps.map((item) => (
            <article class="identify-card">
              <div class="identify-card-head">
                <span class="identify-step" aria-hidden="true">{item.step}</span>
                <span class="identify-name">{item.name}</span>
              </div>
              <h3 class="identify-card-title">{item.title}</h3>
              <p class="identify-card-summary">{item.summary}</p>
            </article>
          ))
        }
      </div>
      <p class="identify-note">
        还没有零件号？发动机铭牌、磨损的标签或旧件的照片，就足够我们开始工作。<a href="/contact/?source=identify">把您手头的资料发给我们 →</a>
      </p>
    </div>
  </section>

  <!-- ═══ CAPABILITIES ═══ -->
  <section class="service-section">
    <div class="section-gap bottom">
      <div class="container">
        <div class="service-wrapper">
          <SectionHeading
            title="发动机零件与服务支持"
            subtitle="供货范围"
          />
          <div class="service-bottom-block fade-in">
            <p class="service-bottom-text service-bottom-hint">
              不确定哪个零件号适合您的发动机？<a
                href="/contact/"
                class="service-bottom-link"
                >发送您的发动机详情</a>，我们将在发货前协助核验替换件。
            </p>
          </div>
          <div class="service-card-sticky-block fade-in">
            {
              services.map((service) => (
                <div class="service-card-item-block">
                  <a
                    href={`/capabilities/${service.slug}/`}
                    class="service-card-image-block"
                  >
                    <img
                      src={service.image}
                      alt={service.title}
                      class="service-card-image"
                      width="400"
                      height="441"
                      loading="lazy"
                      decoding="async"
