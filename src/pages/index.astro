const homepageHotPartNumbers = searchPriorityPartNumbers.slice(0, 12);

const homepageHotParts = homepageHotPartNumbers
  .map((partNumber) => mtuParts.find((part) => part.partNumber.toUpperCase() === partNumber.toUpperCase()))
  .filter((part): part is (typeof mtuParts)[number] => Boolean(part));

const getHomepagePartEngine = (part: (typeof mtuParts)[number]) =>
  part.engineType || part.series.join(', ') || '按出厂编号核验';

const homepageHotSlugs = new Set(homepageHotParts.map((part) => part.slug));
const homepageFeaturedParts = [...mtuParts]
  .filter((part) => isRealPartImage(part.image) && part.weightKg && part.hsCode && !homepageHotSlugs.has(part.slug))
  .sort((a, b) => {
    const bScore =
      Number(Boolean(b.replacementFor?.length)) +
      Number(Boolean(b.applicableEngines)) +
      Number(Boolean(b.commonFailureScenarios?.length));
    const aScore =
      Number(Boolean(a.replacementFor?.length)) +
      Number(Boolean(a.applicableEngines)) +
      Number(Boolean(a.commonFailureScenarios?.length));
    return bScore - aScore || a.partNumber.localeCompare(b.partNumber);
  })
  .slice(0, 48);

const getHomepageGroupParts = (predicate: (part: (typeof mtuParts)[number]) => boolean, limit = 12) =>
  [...mtuParts]
    .filter((part) => predicate(part) && part.weightKg && part.hsCode)
    .sort((a, b) => {
      const bScore =
        Number(isRealPartImage(b.image)) * 4 +
        Number(Boolean(b.replacementFor?.length)) * 2 +
        Number(Boolean(b.applicableEngines));
      const aScore =
        Number(isRealPartImage(a.image)) * 4 +
        Number(Boolean(a.replacementFor?.length)) * 2 +
        Number(Boolean(a.applicableEngines));
      return bScore - aScore || a.partNumber.localeCompare(b.partNumber);
    })
    .slice(0, limit);

const homepagePartNumberGroups = [
  {
    title: 'MTU 4000 系列零件',
    href: '/part-products/catalog/mtu-4000-series/',
    parts: getHomepageGroupParts((part) => part.series.includes('MTU 4000') || /4000/i.test(part.engineType ?? '')),
  },
