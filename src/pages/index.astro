    title: 'MTU 2000 系列零件',
    href: '/part-products/catalog/mtu-2000-series/',
    parts: getHomepageGroupParts((part) => part.series.includes('MTU 2000') || /2000/i.test(part.engineType ?? '')),
  },
  {
    title: 'MTU 396 / 956 系列零件',
    href: '/part-products/catalog/mtu-396-series/',
    parts: getHomepageGroupParts((part) =>
      part.series.some((series) => ['MTU 396', 'MTU 956', 'MTU 956/1163'].includes(series)) ||
