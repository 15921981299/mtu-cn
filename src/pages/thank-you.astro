---
import BaseLayout from '../layouts/BaseLayout.astro';
import BreadcrumbHero from '../components/BreadcrumbHero.astro';
import { site } from '../data/site';
import '../styles/resource-page.css';
import '../styles/utility-page.css';
---

<BaseLayout
  title="感谢 — 已收到您的零件询价 | 国晁动力"
  description="感谢您提交发动机零件询价。国晁动力将审核您的零件号、发动机详情与交付需求。"
  currentPath="/thank-you"
  noindex
>
  <BreadcrumbHero title="感谢！" current="已收到报价请求" variant="5" />

  <section class="blog-details-section utility-section">
    <div class="section-gap bottom">
      <div class="container">
        <article class="blog-details-content-block resource-page fade-in utility-card">
          <h2>我们已收到您的请求</h2>
          <p>我们的零件团队将审核您的零件号、发动机型号、出厂编号、数量与交付需求，然后回复供货情况或待确认问题。</p>
          <p>期间如有疑问？请致电 <a href={`tel:${site.phone.replace(/\s/g, '')}`}>{site.phoneDisplay}</a> 或添加微信（同号），也可发送邮件至 <a href={`mailto:${site.email}`}>{site.email}</a>。</p>

          <div class="utility-actions">
            <a href="/capabilities/" class="primary-button dark-hover">
              <div class="button-content-block">
                <div class="button-text">了解服务支持</div>
                <div class="button-text">了解服务支持</div>
              </div>
            </a>
            <a href="/part-products/" class="secondary-button">
              <div class="button-content-block">
                <div class="button-text">阅读零件指南</div>
                <div class="button-text">阅读零件指南</div>
              </div>
            </a>
          </div>

          <nav class="utility-pill-nav" aria-label="等待期间">
            <a href="/part-products/" class="utility-pill-link">MTU 零件号</a>
            <a href="/products/mtu-spare-parts/" class="utility-pill-link">MTU 备件</a>
            <a href="/terms/payment/" class="utility-pill-link">付款条款</a>
          </nav>
        </article>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  import { getAttributionSnapshot } from '../scripts/attribution';

  const params = new URLSearchParams(window.location.search);
  const source = params.get('source') ?? 'contact';
  const attribution = getAttributionSnapshot();

  if (typeof window.gtag === 'function') {
    window.gtag('event', 'rfq_thank_you_view', {
      event_category: 'RFQ',
      event_label: source,
      ...(attribution
        ? {
            first_touch_page: attribution.firstTouchPage,
            first_touch_stage: attribution.firstTouchStage,
            touch_count: attribution.touches.length,
          }
        : {}),
    });
  }
</script>
