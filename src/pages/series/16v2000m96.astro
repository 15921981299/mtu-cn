---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BreadcrumbHero from '../../components/BreadcrumbHero.astro';
import DetailPageShell from '../../components/DetailPageShell.astro';
import DetailRfqStrip from '../../components/DetailRfqStrip.astro';
import FaqSection from '../../components/FaqSection.astro';
import { breadcrumbSchema, itemListSchema, faqSchema, site } from '../../data/site';
import '../../styles/resource-page.css';

const title = 'MTU 16V 2000 M96 配件';
const seoTitle = 'MTU 16V 2000 M96 配件 — 1,790 kW 高速船用发动机（135 × 156 mm）';
const description = 'MTU 16V 2000 M96 配件：为 1,790 kW / 2,400 bhp 高速 V16 船用发动机提供原厂新件、翻新交换件与凭证替代件。附交叉引用表（含 Bosch 喷油器等价号）、零件识别指南，上海全球发货。';
const pageUrl = `${site.url}/series/16v2000m96/`;
const quoteHref = `/contact/?source=16v2000m96`;

const specs = [
  { k: '结构形式', v: '90° V16 四冲程，每缸 4 气门' },
  { k: '缸径 × 行程', v: '135 × 156 mm' },
  { k: '排量', v: '35.7 L（单缸 2.23 L）' },
  { k: '额定功率', v: '1,790 kW / 2,400 bhp @ 2,450 rpm' },
  { k: 'M96L 功率', v: '1,939 kW / 2,600 bhp @ 2,450 rpm' },
  { k: '燃油消耗率', v: '约 215 g/kWh（额定工况约 464 L/h）' },
  { k: '飞轮 / 齿轮箱', v: 'SAE 0 / ZF 3060' },
  { k: '排放', v: 'IMO Tier II / EPA Tier 3 Recreational / Directive 2013/53/EU' },
  { k: '干重', v: '约 3,450 kg' },
  { k: '燃油系统', v: '共轨；顺序涡轮增压（3 台增压器）；ADEC' },
  { k: '应用', v: '高速游艇、巡逻艇、人员转运船' },
];

// Series 2000 catalog seeds apply to the 16V2000M96 (verify against serial).
const crossRef = [
  { pn: '5410110059', desc: '密封环（缸套 / 曲轴箱）', fit: 'M96 缸套与曲轴箱', tag: 'cat' },
  { pn: '0229974948', desc: '缸套下部密封环', fit: 'M96 缸套结构', tag: 'cat' },
  { pn: '5410160920', desc: '缸垫', fit: 'M96 气缸盖', tag: 'cat' },
  { pn: '0249975047', desc: '径向轴封', fit: 'M96', tag: 'cat' },
  { pn: '5369970147', desc: '密封环', fit: 'M96', tag: 'cat' },
  { pn: '700429036001', desc: 'O 型圈 36 × 5', fit: 'M96 气门室盖', tag: 'cat' },
  { pn: 'X51107500011', desc: '燃油喷油器（Bosch 0986435617 / F00BL0J005）', fit: 'M96 燃油系统', tag: 'cat' },
  { pn: '5420382211', desc: '连杆轴承', fit: 'M96 曲轴下部', tag: 'cat' },
  { pn: '0005357433', desc: '转速传感器', fit: 'M96 检测', tag: 'cat' },
  { pn: '0005356430', desc: '温度传感器', fit: 'M96 检测', tag: 'cat' },
  { pn: '0035352531', desc: '压力传感器', fit: 'M96 检测', tag: 'cat' },
  { pn: '0031845301', desc: '机油滤芯', fit: 'M96（亦适用 S4000）', tag: 'cat' },
  { pn: '0020922801', desc: '燃油滤清器（旋装式）', fit: 'M96 燃油系统', tag: 'cat' },
  { pn: 'X000040776', desc: '涡轮增压器总成 GTA5523', fit: 'M96 增压空气', tag: 'cat' },
];

const listItems = crossRef.map((r) => ({ name: `${r.pn} — ${r.desc}`, url: pageUrl }));

const faqItems = [
  {
    question: '仅凭「MTU 2000」足以订购 16V2000M96 配件吗？',
    answer: '不够。16V2000M96 是 2000 系列的一种构型（135 × 156 mm，共轨，ADEC）。请补充完整型号、发动机出厂编号及旧件上标注的号码，我们才能为您的 M96 构型匹配确切的垫片组、喷油器或轴承——12V2000G83 的大修组无法装到 M96 上。',
  },
  {
    question: '你们供应 M96 的原厂 MTU 喷油器吗？',
    answer: '我们供应原厂 MTU X51107500011 喷油器，以及有凭证的 Bosch 等价号（0986435617 / F00BL0J005）。每份报价都会注明原厂件与交叉引用件，便于您按关键程度与预算选择。',
  },
  {
    question: 'M96 与 M96L 有什么区别？',
    answer: 'M96L 是高输出版：同为 2,450 rpm，1,939 kW / 2,600 bhp 对 1,790 kW / 2,400 bhp。外部件大多通用，但部分内部功率档不同，确切功率请以识别铭牌为准。',
  },
  {
    question: '报价 16V2000M96 配件需要提供哪些信息？',
    answer: '发动机型号 + 出厂编号 + 零件号 + 描述 + 数量。喷油器与传感器的交叉引用还需发动机功率档与出厂年份，以确认对应的 Bosch 或 MTU 等价号。',
  },
  {
    question: '已识别零件号的报价速度如何？',
    answer: '对于能按 16V2000M96 型号确认的零件号，通常一个工作日内报价。本页目录零件号均经公开 MTU BOM 与采购参考核验。',
  },
];

const jsonLd = [
  breadcrumbSchema([
    { name: '首页', url: site.url },
    { name: 'MTU 备件', url: `${site.url}/products/mtu-spare-parts/` },
    { name: 'MTU 2000 系列', url: `${site.url}/series/mtu-2000/` },
    { name: title, url: pageUrl },
  ]),
  itemListSchema(listItems),
  faqSchema(faqItems),
];
---

<BaseLayout
  title={seoTitle}
  description={description}
  currentPath="/series/16v2000m96"
  image="/images/mtu-engine-parts-hero.webp"
  jsonLd={jsonLd}
>
  <BreadcrumbHero
    title={title}
    trail={[
      { label: '首页', href: '/' },
      { label: 'MTU 备件', href: '/products/mtu-spare-parts/' },
      { label: 'MTU 2000 系列', href: '/series/mtu-2000/' },
      { label: title },
    ]}
    variant="1"
  />

  <DetailPageShell intro="MTU 16V 2000 M96 是高速四冲程 V16 船用柴油发动机，额定 1,790 kW（2,400 bhp）@ 2,450 rpm——是高速游艇、巡逻艇与人员转运船的常用推进方案。本页为单机型深度解析：已确认的发动机规格、我们常年供应的配件（附已核验交叉引用），以及面向确切 M96 构型的零件识别流程。">
    <img
      slot="hero"
      src="/images/mtu-engine-parts-hero.webp"
      alt="MTU 16V 2000 M96 发动机配件询价"
      width="1400"
      height="692"
      loading="eager"
      fetchpriority="high"
      decoding="async"
    />

    <div class="resource-meta">
      <span><strong>型号</strong> 16V 2000 M96</span>
      <span><strong>功率</strong> 1,790 kW @ 2,450 rpm</span>
      <span><strong>缸径 × 行程</strong> 135 × 156 mm</span>
      <span><strong>运输</strong> 全球运输</span>
    </div>

    <DetailRfqStrip
      quoteHref={quoteHref}
      title="询价 16V 2000 M96 配件"
      text="请提供发动机出厂编号、零件号、数量、目的地与要求交期。"
      secondaryHref="/series/mtu-2000/"
      secondaryLabel="MTU 2000 系列专区"
    />

    <h2>1. 发动机规格（16V 2000 M96）</h2>
    <div class="resource-table-wrap">
      <table class="resource-table">
        <thead>
          <tr><th>参数</th><th>数值</th></tr>
        </thead>
        <tbody>
          {specs.map((r) => (
            <tr>
              <td><strong>{r.k}</strong></td>
              <td>{r.v}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <p class="resource-note">确切功率与 M 后缀（M96 与 M96L）请以发动机识别铭牌为准。M96L 在同样 2,450 rpm 下可达 1,939 kW / 2,600 bhp。</p>

    <h2>2. 按系统划分的供应配件</h2>
    <div class="hub-grid">
      <a class="hub-card" href="/part-products/catalog/mtu-2000-series/"><div class="hub-card-body"><h3 class="hub-card-title">气缸盖与配气机构</h3><p class="hub-card-summary">缸套、活塞环、气门导管、气门座、摇臂、缸垫。</p></div></a>
      <a class="hub-card" href="/part-products/catalog/mtu-injectors/"><div class="hub-card-body"><h3 class="hub-card-title">燃油系统</h3><p class="hub-card-summary">喷油器与油嘴（含 Bosch 交叉引用）、油嘴座、喷油泵。</p></div></a>
      <a class="hub-card" href="/part-products/catalog/mtu-gasket-kits/"><div class="hub-card-body"><h3 class="hub-card-title">垫片与密封件</h3><p class="hub-card-summary">大修垫片组、O 型圈、缸套密封环、径向轴封。</p></div></a>
      <a class="hub-card" href="/part-products/catalog/mtu-turbocharger-parts/"><div class="hub-card-body"><h3 class="hub-card-title">涡轮增压器</h3><p class="hub-card-summary">GTA 系列芯体、涡轮叶轮、V 型卡箍、保养包。</p></div></a>
      <a class="hub-card" href="/part-products/catalog/mtu-filters/"><div class="hub-card-body"><h3 class="hub-card-title">冷却与润滑</h3><p class="hub-card-summary">海水泵与淡水泵、叶轮、机油/燃油滤芯。</p></div></a>
      <a class="hub-card" href="/part-products/catalog/mtu-sensors/"><div class="hub-card-body"><h3 class="hub-card-title">传感器与 ADEC</h3><p class="hub-card-summary">转速、温度、压力传感器与发动机管理模块。</p></div></a>
    </div>

    <h2>3. 零件号交叉引用（经核验的 2000 系列预置数据）</h2>
    <p>这些零件号均经公开 MTU BOM 与采购参考核验，适用于含 16V2000M96 的 2000 系列家族。订购前请对照发动机出厂编号逐条确认。标签：<span class="rfq-badge cat">目录</span> = 经核验的公开交叉引用预置数据。</p>
    <div class="resource-table-wrap">
      <table class="resource-table">
        <thead>
          <tr><th>零件号</th><th>描述</th><th>M96 适配</th><th>来源 / 交叉引用</th></tr>
        </thead>
        <tbody>
          {crossRef.map((r) => (
            <tr>
              <td><code>{r.pn}</code></td>
              <td>{r.desc}</td>
              <td>{r.fit}</td>
              <td><span class="rfq-badge cat">目录</span> {r.tag === 'cat' ? '经核验 MTU BOM / Bosch' : ''}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <p class="resource-note">没找到您的零件号？请通过表单提交（附发动机出厂编号）——经确认的号码将补充至本页及 2000 专区不断更新的清单。</p>

    <h2>4. 如何识别您的确切零件</h2>
    <ul class="resource-list">
      <li><strong>完整发动机型号</strong>（例如 <code>16V2000M96</code>，而非仅「2000」）</li>
      <li>识别铭牌上的<strong>发动机出厂编号</strong></li>
      <li><strong>现有零件号</strong>——旧件上的标记胜过任何照片说明</li>
      <li><strong>零件描述 + 数量</strong>，并尽可能提供旧件照片</li>
    </ul>

    <h2>5. 供货选项</h2>
    <div class="hub-grid">
      <div class="hub-card"><div class="hub-card-body"><h3 class="hub-card-title">原厂新件</h3><p class="hub-card-summary">MTU 原包装零件，溯源完整——在文件链需经受检验的场合最为稳妥。</p></div></div>
      <div class="hub-card"><div class="hub-card-body"><h3 class="hub-card-title">翻新 / 交换件</h3><p class="hub-card-summary">喷油器、涡轮增压器、油泵的工厂级翻新——成本通常低 30–40%，交货期更短。</p></div></div>
      <div class="hub-card"><div class="hub-card-body"><h3 class="hub-card-title">凭证替代件</h3><p class="hub-card-summary">经核验的等价件（含喷油器的 Bosch 替代），适用于买方接受的非关键项目。</p></div></div>
    </div>

    <h2>6. MTU 系列集群</h2>
    <div class="hub-grid">
      <a class="hub-card" href="/series/mtu-2000/"><div class="hub-card-body"><h3 class="hub-card-title">MTU 2000 系列专区</h3><p class="hub-card-summary">8V / 12V / 16V / 18V 家族全览。</p></div></a>
      <a class="hub-card" href="/series/mtu-2000-variants/"><div class="hub-card-body"><h3 class="hub-card-title">MTU 2000 变型解读</h3><p class="hub-card-summary">M61 → M9x 代际解读与分型号表。</p></div></a>
      <a class="hub-card" href="/series/mtu-396/"><div class="hub-card-body"><h3 class="hub-card-title">MTU 396 系列专区</h3><p class="hub-card-summary">8V / 12V / 16V 主力机型——含实时 RFQ 零件号。</p></div></a>
      <a class="hub-card" href="/series/mtu-4000-variants/"><div class="hub-card-body"><h3 class="hub-card-title">MTU 4000 变型解读</h3><p class="hub-card-summary">M05 / M03 / C05 / R03 / R04 / T05 及 M 用途标识。</p></div></a>
    </div>

    <FaqSection items={faqItems} title="MTU 16V 2000 M96 常见问题" subtitle="常见问题" />
  </DetailPageShell>
</BaseLayout>

<style>
  .rfq-badge {
    display: inline-block;
    font-size: 11px;
    font-weight: 700;
    padding: 2px 8px;
    border-radius: 10px;
    letter-spacing: 0.03em;
    vertical-align: middle;
  }
  .rfq-badge.cat {
    background: #e4eef7;
    color: var(--color-primary);
  }
  .hub-card h3.hub-card-title {
    font-size: 17px;
  }
  .resource-table code {
    background: #eef3f8;
    padding: 1px 6px;
    border-radius: 4px;
    font-size: 13px;
    color: #0a3d66;
  }
</style>
