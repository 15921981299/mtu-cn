---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BreadcrumbHero from '../../components/BreadcrumbHero.astro';
import DetailPageShell from '../../components/DetailPageShell.astro';
import DetailRfqStrip from '../../components/DetailRfqStrip.astro';
import FaqSection from '../../components/FaqSection.astro';
import { breadcrumbSchema, itemListSchema, faqSchema, site } from '../../data/site';
import '../../styles/resource-page.css';

const title = 'MTU 1163 变型解读';
const seoTitle = 'MTU 1163 变型解读 — M74 / M84 / M94 代际与分型号表（230 × 280 mm）';
const description = '解读 MTU 1163 型号：12V / 16V / 20V 构型与 M74 / M84 / M94 代际。哪些零件随构型而异，附分型号功率表与零件识别指南，覆盖 11.63 L/缸大缸径家族。';
const pageUrl = `${site.url}/series/mtu-1163-variants/`;
const quoteHref = `/contact/?source=mtu-1163-variants`;

const genRows = [
  { gen: 'M74', inj: '单体喷射', mgmt: '机械式 / 早期电控', emis: 'IMO II', note: '1163 初代；喷油器与传感器编号与后续构型不同。' },
  { gen: 'M84', inj: '共轨（最高 1800 bar）', mgmt: 'ADEC', emis: 'IMO II', note: '共轨升级款；与 M94 共用许多燃油系统零件。' },
  { gen: 'M94', inj: '共轨（最高 1800 bar）', mgmt: 'ADEC', emis: 'IMO II / IMO III（SCR）', note: '1163 最新款；功率最高（20V1163M94 = 7400 kW）。' },
];

const modelRows = [
  { desig: '12V 1163 M74', out: '~3600 kW', rpm: '1300', disp: '139.6 L' },
  { desig: '12V 1163 M84 / M94', out: '~4440 kW', rpm: '1300', disp: '139.6 L' },
  { desig: '16V 1163 M74', out: '~4800 kW', rpm: '1300', disp: '186.1 L' },
  { desig: '16V 1163 M94', out: '~6000 kW', rpm: '1300', disp: '186.1 L' },
  { desig: '20V 1163 M84', out: '~6000 kW', rpm: '1300', disp: '232.7 L' },
  { desig: '20V 1163 M94', out: '7400 kW', rpm: '1300', disp: '232.7 L' },
];

const variantParts = [
  { sys: '燃油系统', diff: 'M74 采用单体喷油器；M84/M94 采用共轨喷油器（1800 bar）——不可互换。' },
  { sys: '发动机管理', diff: 'M74 为机械/早期电控，M84/M94 为 ADEC——传感器、线束与 ECM 均不同。' },
  { sys: '涡轮增压', diff: '各代际均采用两级顺序增压（LP + HP）；芯体按代际专用。' },
  { sys: '活塞 / 缸套', diff: '全家族缸径/行程均为 230 × 280 mm；活塞环与缸套编号按代际通用，但需按出厂编号确认。' },
  { sys: '垫片 / 密封件', diff: '缸垫与大修组按构型专用——须按型号 + 出厂编号确认，不能仅凭代际判断。' },
];

const listItems = [
  { name: 'MTU 1163 M74 代际', url: pageUrl },
  { name: 'MTU 1163 M84 共轨', url: pageUrl },
  { name: 'MTU 1163 M94 7400 kW', url: pageUrl },
  { name: 'MTU 1163 20V 构型', url: pageUrl },
];

const faqItems = [
  {
    question: '1163 的 M 后缀代表什么？',
    answer: '在 1163 上，M 后缀对应代际与喷射系统：M74 为单体喷射，M84 与 M94 为最高 1800 bar 的共轨系统并配 ADEC 发动机管理。这些后缀不是简单的功率排序——彼此的喷油器、传感器与管理部件均不同。',
  },
  {
    question: '1163 的活塞与缸套在各代际间通用吗？',
    answer: '全家族缸径 × 行程均为 230 × 280 mm，活塞与缸套几何尺寸通用。但确切的活塞环与缸套零件号需按发动机出厂编号确认，其周围的燃油系统零件则并不通用——请一律按完整型号 + 出厂编号询价。',
  },
  {
    question: 'M74 喷油器能用 M94 共轨喷油器替代吗？',
    answer: '不能。M74 采用单体喷油器；M84/M94 采用 1800 bar 共轨喷油器并配 ADEC。两者系统不同、不可互换。我们将按您的发动机型号报出正确的代际专用喷油器。',
  },
  {
    question: '哪些 1163 型号达到 7400 kW？',
    answer: '1163 的最高功率为 20V1163M94，7400 kW（约 9925 bhp）@ 1300 rpm；20V1163M84 约为 6000 kW。12V 与 16V 变型覆盖约 3600–6000 kW。确切功率请以识别铭牌为准。',
  },
];

const jsonLd = [
  breadcrumbSchema([
    { name: '首页', url: site.url },
    { name: 'MTU 备件', url: `${site.url}/products/mtu-spare-parts/` },
    { name: 'MTU 1163 系列', url: `${site.url}/series/mtu-1163/` },
    { name: title, url: pageUrl },
  ]),
  itemListSchema(listItems),
  faqSchema(faqItems),
];
---

<BaseLayout
  title={seoTitle}
  description={description}
  currentPath="/series/mtu-1163-variants"
  image="/images/mtu-engine-parts-hero.webp"
  jsonLd={jsonLd}
>
  <BreadcrumbHero
    title={title}
    trail={[
      { label: '首页', href: '/' },
      { label: 'MTU 备件', href: '/products/mtu-spare-parts/' },
      { label: 'MTU 1163 系列', href: '/series/mtu-1163/' },
      { label: title },
    ]}
    variant="1"
  />

  <DetailPageShell intro="MTU 1163 的型号由气缸数（12V / 16V / 20V）与代际后缀（M74 / M84 / M94）组成。由于代际决定喷射与管理系统，后缀决定了您实际需要的喷油器、传感器与垫片。本解读页面讲解各代际、分型号功率表，以及哪些零件随构型而异。">
    <img
      slot="hero"
      src="/images/mtu-engine-parts-hero.webp"
      alt="MTU 1163 变型解读"
      width="1400"
      height="692"
      loading="eager"
      fetchpriority="high"
      decoding="async"
    />

    <div class="resource-meta">
      <span><strong>系列</strong> MTU 1163</span>
      <span><strong>缸径 × 行程</strong> 230 × 280 mm</span>
      <span><strong>代际</strong> M74 / M84 / M94</span>
      <span><strong>运输</strong> 全球运输</span>
    </div>

    <DetailRfqStrip
      quoteHref={quoteHref}
      title="解读您的 1163 并询价"
      text="请提供完整型号（例如 20V1163M94）、出厂编号及旧件上标注的号码。"
      secondaryHref="/series/mtu-1163/"
      secondaryLabel="MTU 1163 专区"
    />

    <h2>1. 代际解读（M74 / M84 / M94）</h2>
    <p>M 后缀是决定零件清单的关键。M74 为初代单体喷射；M84 与 M94 改用最高 1800 bar 的共轨系统并配 ADEC 发动机管理。这些后缀<strong>并非</strong>简单的功率排序——它们改变的是燃油与管理系统。</p>
    <div class="resource-table-wrap">
      <table class="resource-table">
        <thead>
          <tr><th>代际</th><th>喷射</th><th>管理</th><th>排放</th><th>备注</th></tr>
        </thead>
        <tbody>
          {genRows.map((r) => (
            <tr>
              <td><strong>{r.gen}</strong></td>
              <td>{r.inj}</td>
              <td>{r.mgmt}</td>
              <td>{r.emis}</td>
              <td>{r.note}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <h2>2. 分型号功率表</h2>
    <p>所有 1163 型号转速均在 1300 rpm 左右。功率随气缸数与代际提升；20V M94 为家族顶端，达 7400 kW。</p>
    <div class="resource-table-wrap">
      <table class="resource-table">
        <thead>
          <tr><th>型号</th><th>功率</th><th>额定转速</th><th>排量</th></tr>
        </thead>
        <tbody>
          {modelRows.map((r) => (
            <tr>
              <td><strong>{r.desig}</strong></td>
              <td>{r.out}</td>
              <td>{r.rpm} rpm</td>
              <td>{r.disp}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <p class="resource-note">表中数值为家族代表值；订购前请以发动机识别铭牌核对确切功率与代际。</p>

    <h2>3. 哪些零件随代际而异</h2>
    <div class="resource-table-wrap">
      <table class="resource-table">
        <thead>
          <tr><th>系统</th><th>构型差异</th></tr>
        </thead>
        <tbody>
          {variantParts.map((r) => (
            <tr>
              <td><strong>{r.sys}</strong></td>
              <td>{r.diff}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <h2>4. 如何识别您的确切 1163 零件</h2>
    <ul class="resource-list">
      <li><strong>完整型号</strong>（例如 <code>20V1163M94</code>）</li>
      <li><strong>代际</strong>——M74 与 M84 / M94 的燃油系统不同</li>
      <li>识别铭牌上的<strong>发动机出厂编号</strong></li>
      <li><strong>旧件零件号</strong>——部件上的标记胜过任何照片说明</li>
      <li>尽可能提供<strong>识别铭牌照片</strong></li>
    </ul>

    <h2>5. MTU 系列集群</h2>
    <div class="hub-grid">
      <a class="hub-card" href="/series/mtu-1163/"><div class="hub-card-body"><h3 class="hub-card-title">MTU 1163 系列专区</h3><p class="hub-card-summary">12V / 16V / 20V 大缸径家族全览与供应配件。</p></div></a>
      <a class="hub-card" href="/series/mtu-396/"><div class="hub-card-body"><h3 class="hub-card-title">MTU 396 系列专区</h3><p class="hub-card-summary">8V / 12V / 16V 主力机型——含实时 RFQ 零件号。</p></div></a>
      <a class="hub-card" href="/series/mtu-2000/"><div class="hub-card-body"><h3 class="hub-card-title">MTU 2000 系列专区</h3><p class="hub-card-summary">8V / 12V / 16V / 18V 高速发动机。</p></div></a>
      <a class="hub-card" href="/series/mtu-4000-variants/"><div class="hub-card-body"><h3 class="hub-card-title">MTU 4000 变型解读</h3><p class="hub-card-summary">M05 / M03 / C05 / R03 / R04 / T05 及 M 用途标识。</p></div></a>
    </div>

    <FaqSection items={faqItems} title="MTU 1163 变型解读常见问题" subtitle="常见问题" />
  </DetailPageShell>
</BaseLayout>

<style>
  .rfq-badge {
    display: inline-block;
    font-size: 11px;
    font-weight: 700;
    padding: 2px 8px;
    border-radius: 10px;
    letter-spacing: 0.03em;
    vertical-align: middle;
  }
  .rfq-badge.cat {
    background: #e4eef7;
    color: var(--color-primary);
  }
  .hub-card h3.hub-card-title {
    font-size: 17px;
  }
  .resource-table code {
    background: #eef3f8;
    padding: 1px 6px;
    border-radius: 4px;
    font-size: 13px;
    color: #0a3d66;
  }
</style>
