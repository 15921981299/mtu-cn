---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BreadcrumbHero from '../../components/BreadcrumbHero.astro';
import DetailPageShell from '../../components/DetailPageShell.astro';
import DetailRfqStrip from '../../components/DetailRfqStrip.astro';
import FaqSection from '../../components/FaqSection.astro';
import { breadcrumbSchema, itemListSchema, faqSchema, site } from '../../data/site';
import '../../styles/resource-page.css';

const title = 'MTU 4000 变型解读';
const seoTitle = 'MTU 4000 变型解读 — M05 / M03 / C05 / R03 / R04 / T05 版本与 M 用途标识';
const description = '解读 MTU 4000 型号：应用版本（M05 / M03 / C05 / R03 / R04 / T05）、M 用途标识（M53 → M93）及各版本缸径/行程差异。附分型号功率表与零件识别指南，覆盖 12V / 16V / 20V 家族。';
const pageUrl = `${site.url}/series/mtu-4000-variants/`;
const quoteHref = `/contact/?source=mtu-4000-variants`;

const verRows = [
  { ver: 'M05', app: '船用主推进与船载电源', cyl: '12V / 16V / 20V', emis: 'IMO III, EPA T4', note: '核心船用版本；1500–3200 kW。' },
  { ver: 'M05-N', app: '气体', cyl: '8V / 16V', emis: 'IMO III, EPA T4, EU V', note: 'M05 的火花点火气体变型。' },
  { ver: 'M03', app: '游艇', cyl: '12V / 16V / 20V', emis: 'IMO II, EPA T2', note: '游艇功率档，1920–4300 kW。' },
  { ver: 'C05', app: '矿用', cyl: '12V / 16V', emis: 'EPA T4', note: '连续工况矿用版本。' },
  { ver: 'R03', app: '轨交', cyl: '20V', emis: 'UIC IIIA, EU IIIA', note: '轨交推挽 / 机车；2700–3300 kW。' },
  { ver: 'R04', app: '轨交', cyl: '12V / 16V', emis: 'UIC IIIA, EU IIIB', note: '后续轨交版本；1500–2400 kW。' },
  { ver: 'T05', app: '油气压裂', cyl: '12V / 16V', emis: 'EPA T4', note: '压裂工况版本；1680–2240 kW。' },
];

const dutyRows = [
  { duty: 'M53 / M63', profile: '轻载', app: '游艇、轻型工作艇', note: '允许的年满负荷小时数较低；内部件负荷较轻。' },
  { duty: 'M73 / M73L', profile: '商用', app: '高速渡轮、海上作业、商用船', note: '满负荷曲线更高；连杆 / 曲轴截面比 M53 更重。' },
  { duty: 'M90', profile: '重载', app: '巡逻艇、高速渡轮', note: '持续高输出；内部件比 M73 更重。' },
  { duty: 'M93 / M93L', profile: '海军', app: '近海巡逻舰、快速攻击艇、护卫舰、轻型护卫舰', note: '满功率小时数要求最高；全家族中连杆 / 曲轴截面最重。' },
];

const boreRows = [
  { ver: 'M 家族（M05 / M53 / M63 / M73 / M90 / M93）', bore: '165 / 190 mm', note: '多数船用 M 用途版本。' },
  { ver: 'R 家族（R03 / R04 轨交）', bore: '170 / 210 mm', note: '轨交版本行程更长。' },
  { ver: 'C05 / T05', bore: '170 / 190 mm', note: '矿用与压裂版本。' },
];

const modelRows = [
  { desig: '12V 4000 M53 / M63', out: '1100–1500 kW', rpm: '1800', app: '游艇、巡逻、小型渡轮' },
  { desig: '12V 4000 M73', out: '约 1600 kW', rpm: '1800', app: '商用、海上作业' },
  { desig: '12V 4000 M90', out: '约 1800 kW', rpm: '1800', app: '巡逻、高速渡轮' },
  { desig: '16V 4000 M53 / M63', out: '1450–2000 kW', rpm: '1800', app: '大型游艇、高速渡轮' },
  { desig: '16V 4000 M73', out: '约 2200 kW', rpm: '1800', app: '高速渡轮、海上作业' },
  { desig: '16V 4000 M90', out: '约 2400 kW', rpm: '1800', app: '高速渡轮、巡逻艇' },
  { desig: '16V 4000 M93L', out: '约 3000 kW', rpm: '1800', app: '海军近海巡逻舰、快速攻击艇' },
  { desig: '20V 4000 M53 / M63', out: '1800–2500 kW', rpm: '1800', app: '大型游艇、高速渡轮' },
  { desig: '20V 4000 M90', out: '约 3600 kW', rpm: '1800', app: '巡逻、护卫舰辅助' },
  { desig: '20V 4000 M93', out: '约 4300 kW', rpm: '1800', app: '海军护卫舰、轻型护卫舰' },
];

const listItems = [
  { name: 'MTU 4000 M 用途标识 M53 至 M93', url: pageUrl },
  { name: 'MTU 4000 M05 船用版本', url: pageUrl },
  { name: 'MTU 4000 R03 R04 轨交版本', url: pageUrl },
  { name: 'MTU 4000 20V M93 海军', url: pageUrl },
];

const faqItems = [
  {
    question: '4000 的版本字母代表什么（M05 / M03 / C05 / R03 / R04 / T05）？',
    answer: '字母+数字标识应用版本：M05 = 船用主推进与船载电源，M03 = 游艇，C05 = 矿用，R03 / R04 = 轨交（机车），T05 = 油气压裂。每个版本有各自的排放认证与用途曲线，决定正确的零件。',
  },
  {
    question: 'M 用途数字代表什么（M53、M73、M90、M93）？',
    answer: 'M 用途标识对应允许的年满负荷运行曲线。M53 / M63 为轻载（游艇），M73 / M73L 商用，M90 重载（巡逻 / 高速渡轮），M93 / M93L 为要求最高的海军用途。数字越大，连杆与曲轴截面越重——即使气缸数相同。因此内部件报价必须依据用途后缀。',
  },
  {
    question: '所有 4000 发动机的缸径与行程都一样吗？',
    answer: '不一样。M 家族船用版本为 165 / 190 mm；R 家族轨交版本为 170 / 210 mm（行程更长）；C05 / T05 为 170 / 190 mm。缸径/行程直接决定缸套、活塞与密封件——订购前请先确认版本。',
  },
  {
    question: '4000 有通用的大修垫片组吗？',
    answer: '没有。所需密封件取决于版本（M/R/C/T）、M 用途、气缸数与出厂编号。2000 系列的已核验参考（如缸套密封件 5410110059、0229974948）仅示意格式，4000 整套垫片必须对照您的发动机确认。',
  },
];

const jsonLd = [
  breadcrumbSchema([
    { name: '首页', url: site.url },
    { name: 'MTU 备件', url: `${site.url}/products/mtu-spare-parts/` },
    { name: 'MTU 4000 系列配件', url: `${site.url}/products/mtu-4000-series-parts/` },
    { name: title, url: pageUrl },
  ]),
  itemListSchema(listItems),
  faqSchema(faqItems),
];
---

<BaseLayout
  title={seoTitle}
  description={description}
  currentPath="/series/mtu-4000-variants"
  image="/images/mtu-engine-parts-hero.webp"
  jsonLd={jsonLd}
>
  <BreadcrumbHero
    title={title}
    trail={[
      { label: '首页', href: '/' },
      { label: 'MTU 备件', href: '/products/mtu-spare-parts/' },
      { label: 'MTU 4000 系列配件', href: '/products/mtu-4000-series-parts/' },
      { label: title },
    ]}
    variant="1"
  />

  <DetailPageShell intro="MTU 4000 的型号包含两组决定零件清单的代码：应用版本（M05 / M03 / C05 / R03 / R04 / T05）与 M 用途标识（M53 → M93）。两者共同决定排放认证、用途曲线、缸径/行程——更关键的是连杆与曲轴的内部截面。本解读页面讲解这两组代码、分型号功率表，以及哪些零件随构型而异。">
    <img
      slot="hero"
      src="/images/mtu-engine-parts-hero.webp"
      alt="MTU 4000 变型解读"
      width="1400"
      height="692"
      loading="eager"
      fetchpriority="high"
      decoding="async"
    />

    <div class="resource-meta">
      <span><strong>系列</strong> MTU 4000</span>
      <span><strong>气缸</strong> 8V / 12V / 16V / 20V</span>
      <span><strong>版本</strong> M05 / M03 / C05 / R03 / R04 / T05</span>
      <span><strong>运输</strong> 全球运输</span>
    </div>

    <DetailRfqStrip
      quoteHref={quoteHref}
      title="解读您的 4000 并询价"
      text="请提供完整型号（例如 16V4000M93L）、出厂编号及旧件上标注的号码。"
      secondaryHref="/products/mtu-4000-series-parts/"
      secondaryLabel="MTU 4000 配件专区"
    />

    <h2>1. 应用版本解读</h2>
    <p>「4000」之后的字母+数字标识应用版本及其排放认证。这是从识别铭牌上应读取的第一组代码。</p>
    <div class="resource-table-wrap">
      <table class="resource-table">
        <thead>
          <tr><th>版本</th><th>应用</th><th>气缸</th><th>排放</th><th>备注</th></tr>
        </thead>
        <tbody>
          {verRows.map((r) => (
            <tr>
              <td><strong>{r.ver}</strong></td>
              <td>{r.app}</td>
              <td>{r.cyl}</td>
              <td>{r.emis}</td>
              <td>{r.note}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <h2>2. M 用途标识（M53 → M93）</h2>
    <p>M 用途数字对应允许的年满负荷运行曲线。数字越大，用途要求越高，<strong>连杆与曲轴截面越重</strong>——即使气缸数相同。这正是 16V4000M93 机体内部与 16V4000M53 不同的原因。</p>
    <div class="resource-table-wrap">
      <table class="resource-table">
        <thead>
          <tr><th>用途</th><th>曲线</th><th>典型应用</th><th>备注</th></tr>
        </thead>
        <tbody>
          {dutyRows.map((r) => (
            <tr>
              <td><strong>{r.duty}</strong></td>
              <td>{r.profile}</td>
              <td>{r.app}</td>
              <td>{r.note}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <h2>3. 按版本的缸径与行程</h2>
    <p>并非所有 4000 的缸径与行程都相同。船用 M 家族与轨交 R 家族不同，这直接改变缸套、活塞与密封件。</p>
    <div class="resource-table-wrap">
      <table class="resource-table">
        <thead>
          <tr><th>版本组</th><th>缸径 × 行程</th><th>备注</th></tr>
        </thead>
        <tbody>
          {boreRows.map((r) => (
            <tr>
              <td><strong>{r.ver}</strong></td>
              <td>{r.bore}</td>
              <td>{r.note}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <h2>4. 分型号功率表</h2>
    <div class="resource-table-wrap">
      <table class="resource-table">
        <thead>
          <tr><th>型号</th><th>功率</th><th>额定转速</th><th>主要应用</th></tr>
        </thead>
        <tbody>
          {modelRows.map((r) => (
            <tr>
              <td><strong>{r.desig}</strong></td>
              <td>{r.out}</td>
              <td>{r.rpm} rpm</td>
              <td>{r.app}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <p class="resource-note">表中数值为家族代表值；订购前请以发动机识别铭牌核对确切功率、版本与 M 用途。</p>

    <h2>5. 如何识别您的确切 4000 零件</h2>
    <ul class="resource-list">
      <li><strong>完整型号</strong>（例如 <code>16V4000M93L</code>）</li>
      <li><strong>版本 + M 用途</strong>——M05/M03/C05/R03/R04/T05 与 M53→M93 改变零件</li>
      <li>识别铭牌上的<strong>发动机出厂编号</strong></li>
      <li><strong>旧件零件号</strong>——部件上的标记胜过任何照片说明</li>
      <li>尽可能提供<strong>识别铭牌照片</strong></li>
    </ul>

    <h2>6. MTU 系列集群</h2>
    <div class="hub-grid">
      <a class="hub-card" href="/products/mtu-4000-series-parts/"><div class="hub-card-body"><h3 class="hub-card-title">MTU 4000 系列配件专区</h3><p class="hub-card-summary">12V / 16V / 20V 同族更大机型的完整配件专区。</p></div></a>
      <a class="hub-card" href="/series/mtu-1163/"><div class="hub-card-body"><h3 class="hub-card-title">MTU 1163 系列专区</h3><p class="hub-card-summary">12V / 16V / 20V 大缸径家族（230 × 280 mm）。</p></div></a>
      <a class="hub-card" href="/series/mtu-396/"><div class="hub-card-body"><h3 class="hub-card-title">MTU 396 系列专区</h3><p class="hub-card-summary">8V / 12V / 16V 主力机型——含实时 RFQ 零件号。</p></div></a>
      <a class="hub-card" href="/series/mtu-2000/"><div class="hub-card-body"><h3 class="hub-card-title">MTU 2000 系列专区</h3><p class="hub-card-summary">8V / 12V / 16V / 18V 高速发动机。</p></div></a>
    </div>

    <FaqSection items={faqItems} title="MTU 4000 变型解读常见问题" subtitle="常见问题" />
  </DetailPageShell>
</BaseLayout>

<style>
  .rfq-badge {
    display: inline-block;
    font-size: 11px;
    font-weight: 700;
    padding: 2px 8px;
    border-radius: 10px;
    letter-spacing: 0.03em;
    vertical-align: middle;
  }
  .rfq-badge.cat {
    background: #e4eef7;
    color: var(--color-primary);
  }
  .hub-card h3.hub-card-title {
    font-size: 17px;
  }
  .resource-table code {
    background: #eef3f8;
    padding: 1px 6px;
    border-radius: 4px;
    font-size: 13px;
    color: #0a3d66;
  }
</style>
