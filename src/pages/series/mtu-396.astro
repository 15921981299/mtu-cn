---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BreadcrumbHero from '../../components/BreadcrumbHero.astro';
import DetailPageShell from '../../components/DetailPageShell.astro';
import DetailRfqStrip from '../../components/DetailRfqStrip.astro';
import FaqSection from '../../components/FaqSection.astro';
import { breadcrumbSchema, itemListSchema, faqSchema, site } from '../../data/site';
import '../../styles/resource-page.css';

const title = 'MTU 396 发动机型号与零件识别';
const seoTitle = 'MTU 396 发动机型号与零件识别指南';
const description = 'MTU 396 型号命名、发动机构型与目录零件参考。订购替换件前，请确认完整型号与发动机出厂编号。';
const pageUrl = `${site.url}/series/mtu-396/`;
const quoteHref = `/contact/?source=mtu-396-series`;

const configRows = [
  { desig: '8V 396', cyl: 'V8', output: '约 600–1120 kW', app: '发电机组、小型高速艇' },
  { desig: '12V 396', cyl: 'V12', output: '约 1000–2000 kW', app: '巡逻艇、渡轮、发电机组' },
  { desig: '16V 396', cyl: 'V16', output: '约 1350–2240 kW', app: '高速船舶、海军、游艇' },
];

const crossRef = [
  { pn: '0005350260', desc: '排气热电偶', fit: '396 排气温度检测', src: 'RFQ · 以色列买家', tag: 'rfq' },
  { pn: '0005353960', desc: '排气热电偶', fit: '396 排气温度检测', src: 'RFQ · 以色列买家', tag: 'rfq' },
  { pn: '5600160180', desc: '垫片', fit: '396 通用', src: 'RFQ · 阿曼买家', tag: 'rfq' },
  { pn: '5582040406', desc: '叶轮（冷却水泵）', fit: '396 海水泵', src: '目录预置', tag: 'cat' },
  { pn: '5110809821', desc: '涡轮叶轮', fit: '396 涡轮增压器', src: '目录预置', tag: 'cat' },
  { pn: '5501800016', desc: '机油滤芯', fit: '396 润滑', src: '目录预置', tag: 'cat' },
  { pn: '5090850060', desc: '活塞环', fit: '396 活塞', src: '目录预置', tag: 'cat' },
  { pn: '5500500333 / 5500500334', desc: '摇臂（进气/排气）', fit: '396 配气机构', src: '目录预置', tag: 'cat' },
  { pn: '5550533244', desc: '气门导管（进气）', fit: '396 气缸盖', src: '目录预置', tag: 'cat' },
  { pn: '0045427217', desc: '温度监测器', fit: '396 检测', src: '目录预置', tag: 'cat' },
  { pn: '0011535528', desc: '压力变送器', fit: '396 检测', src: '目录预置', tag: 'cat' },
  { pn: '—', desc: '排气热电偶交叉引用（非 MTU 品牌）', fit: '396', src: '目录 · "Thermo Fisher 33.700.040"——未经核验，请提供照片', tag: 'cat' },
];

const faqItems = [
  {
    question: '仅凭「MTU 396」足以订购零件吗？',
    answer: '并非对所有零件都够。请补充完整发动机型号（例如 16V396TE94，而非仅「396」）、发动机出厂编号，以及——最好——旧件上标注的号码。396 家族已服役数十年，零件号屡经变更并换装过翻新件；这一组合可避免适配错误。',
  },
  {
    question: '你们只供应原厂 MTU 件吗？',
    answer: '我们供应原厂新件、翻新交换件与凭证替代件。合适选项取决于零件关键程度以及您对等价件的接受度——每份报价都会注明属于哪一类；热电偶与传感器在您要求时按品牌 OE 件报价。',
  },
  {
    question: '能把零件号对应到非 MTU 品牌吗？',
    answer: '多数可以，但我们先核验再报价。若零件号可对应到其他制造商，我们会先索要照片确认而非想当然——部分 396 检测件存在非 MTU 交叉引用，必须对照您的确切发动机核对。',
  },
  {
    question: '报价需要提供哪些信息？',
    answer: '发动机型号 + 出厂编号 + 零件号 + 描述 + 数量。提供旧件照片能显著缩短识别时间。热电偶与传感器还需发动机功率档与出厂年份辅助判断。',
  },
  {
    question: '已识别零件号的报价速度如何？',
    answer: '对于能按发动机型号确认的零件号，通常一个工作日内报价。本页 RFQ 核验零件号（例如 0005350260、5600160180）当日即可从库存或指定供应商渠道报价。',
  },
];

const jsonLd = [
  breadcrumbSchema([
    { name: '首页', url: site.url },
    { name: 'MTU 备件', url: `${site.url}/products/mtu-spare-parts/` },
    { name: title, url: pageUrl },
  ]),
  itemListSchema(crossRef.filter((r) => r.pn !== '—').map((r) => ({ name: `${r.pn} — ${r.desc}`, url: pageUrl }))),
  faqSchema(faqItems),
];
---

<BaseLayout
  title={seoTitle}
  description={description}
  currentPath="/series/mtu-396"
  image="/images/mtu-engine-parts-hero.webp"
  jsonLd={jsonLd}
>
  <BreadcrumbHero
    title={title}
    trail={[
      { label: '首页', href: '/' },
      { label: 'MTU 备件', href: '/products/mtu-spare-parts/' },
      { label: title },
    ]}
    variant="1"
  />

  <DetailPageShell intro="MTU 396 是 MTU Friedrichshafen（今 Rolls-Royce Power Systems）旗下高速四冲程 V 型柴油发动机家族，是高速艇、巡逻船、潜艇与固定发电机组的骨干机型。本专区汇总发动机构型、常年供应配件、持续补充的交叉引用表，以及面向该系列（零件号在数十年服役中屡经变更）的零件识别流程。">
    <img
      slot="hero"
      src="/images/mtu-engine-parts-hero.webp"
      alt="MTU 396 系列发动机配件询价"
      width="1400"
      height="692"
      loading="eager"
      fetchpriority="high"
      decoding="async"
    />

    <div class="resource-meta">
      <span><strong>类别</strong> MTU 备件</span>
      <span><strong>家族</strong> 396（8V / 12V / 16V）</span>
      <span><strong>核验</strong> 型号 + 出厂编号</span>
      <span><strong>运输</strong> 全球运输</span>
    </div>

    <DetailRfqStrip
      quoteHref={quoteHref}
      title="询价 MTU 396 配件"
      text="请提供发动机型号、出厂编号、零件号、数量、目的地与要求交期。"
      secondaryHref="/part-products/catalog/mtu-396-series/"
      secondaryLabel="MTU 396 目录"
    />

    <h2>1. 发动机构型</h2>
    <p>396 家族覆盖三种气缸数与多种用途变型。<strong>TB</strong> = 基础/早期船用，<strong>TC</strong> = 增压（工业与轨交），<strong>TE</strong> = 强化（高速船舶、游艇、渡轮），<strong>SE</strong> = 潜艇（低噪声）用途。缸径 × 行程均为 165 × 185 mm。</p>
    <div class="resource-table-wrap">
      <table class="resource-table">
        <thead>
          <tr><th>型号</th><th>气缸</th><th>缸径 × 行程</th><th>典型功率</th><th>主要应用</th></tr>
        </thead>
        <tbody>
          {configRows.map((r) => (
            <tr>
              <td><strong>{r.desig}</strong></td>
              <td>{r.cyl}</td>
              <td rowspan="3">165 × 185 mm</td>
              <td>{r.output}</td>
              <td>{r.app}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <p class="resource-note">表中数值为家族代表值；订购前请一律以发动机<strong>识别铭牌</strong>（型号 + 出厂编号）为准。保养间隔通常为约 500 运行小时或每年一次。</p>

    <h2>2. 按系统划分的供应配件</h2>
    <div class="hub-grid">
      <a class="hub-card" href="/part-products/catalog/mtu-396-series/"><div class="hub-card-body"><h3 class="hub-card-title">气缸盖与配气机构</h3><p class="hub-card-summary">气门导管、气门座、气门弹簧、锁夹、摇臂、推杆、缸垫。</p></div></a>
      <a class="hub-card" href="/part-products/catalog/mtu-injectors/"><div class="hub-card-body"><h3 class="hub-card-title">燃油系统</h3><p class="hub-card-summary">喷油器与油嘴、油嘴座、喷油泵、燃油输送泵。</p></div></a>
      <a class="hub-card" href="/part-products/catalog/mtu-396-series/"><div class="hub-card-body"><h3 class="hub-card-title">活塞 / 缸套 / 活塞环</h3><p class="hub-card-summary">活塞总成、气缸套、活塞环、连杆螺栓。</p></div></a>
      <a class="hub-card" href="/part-products/catalog/mtu-396-series/"><div class="hub-card-body"><h3 class="hub-card-title">轴承</h3><p class="hub-card-summary">主轴承与连杆轴瓦、推力垫圈。</p></div></a>
      <a class="hub-card" href="/part-products/catalog/mtu-gasket-kits/"><div class="hub-card-body"><h3 class="hub-card-title">垫片与密封件</h3><p class="hub-card-summary">缸垫、O 型圈、铜密封环、垫片组。</p></div></a>
      <a class="hub-card" href="/part-products/catalog/mtu-turbocharger-parts/"><div class="hub-card-body"><h3 class="hub-card-title">涡轮增压器</h3><p class="hub-card-summary">涡轮叶轮、芯体、ZR140 / ZR170 / ZR210 保养包。</p></div></a>
      <a class="hub-card" href="/part-products/catalog/mtu-filters/"><div class="hub-card-body"><h3 class="hub-card-title">冷却</h3><p class="hub-card-summary">海水泵与淡水泵、叶轮、热交换器包、节温器。</p></div></a>
      <a class="hub-card" href="/part-products/catalog/mtu-sensors/"><div class="hub-card-body"><h3 class="hub-card-title">传感器与 MDEC</h3><p class="hub-card-summary">排气热电偶、温度/压力变送器、发动机管理模块。</p></div></a>
    </div>

    <h2>3. 零件号交叉引用（持续补充）</h2>
    <p>我们在处理真实询盘的过程中发布可确认的零件号。标签说明：<span class="rfq-badge rfq">RFQ</span> = 经收到的询盘核验；<span class="rfq-badge cat">目录</span> = 公开 MTU 396 交叉引用预置数据。凡零件号涉及非 MTU 品牌，我们会注明待核验。</p>
    <div class="resource-table-wrap">
      <table class="resource-table">
        <thead>
          <tr><th>零件号</th><th>描述</th><th>396 适配</th><th>来源 / 交叉引用</th></tr>
        </thead>
        <tbody>
          {crossRef.map((r) => (
            <tr>
              <td><code>{r.pn}</code></td>
              <td>{r.desc}</td>
              <td>{r.fit}</td>
              <td>
                {r.tag === 'rfq' ? <span class="rfq-badge rfq">RFQ</span> : <span class="rfq-badge cat">目录</span>}
                {' '}{r.src}
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <p class="resource-note">没找到您的零件号？请通过表单提交（附发动机型号 + 出厂编号）——经确认的号码将补充至本表，也能帮助下一位同款发动机的用户。</p>

    <h2>4. 如何识别您的确切零件</h2>
    <p>「MTU 396 零件」往往<strong>不足以</strong>安全订购。一台 396 发动机可能已运转数十年：零件换过、号变过、翻新件装过。为匹配正确零件，我们需要：</p>
    <ul class="resource-list">
      <li><strong>完整发动机型号</strong>（例如 <code>16V396TE94</code>，而非仅「396」）</li>
      <li>识别铭牌上的<strong>发动机出厂编号</strong></li>
      <li><strong>现有零件号</strong>——旧件上的标记胜过任何照片说明</li>
      <li><strong>零件描述 + 数量</strong>，并尽可能提供旧件照片</li>
    </ul>
    <p>这与我们对每笔询价报价前的一贯要求相同——可避免发出与您的确切构型不匹配的「貌似之件」。</p>

    <h2>5. 询盘记录——396 配件如何到达我们手中</h2>
    <p>我们经手的 396 相关请求实例（买家已匿名）。它们展示了在役构型与零件的范围：</p>

    <div class="enquiry-log">
      <div class="meta">RFQ · 船运运营商 · 排气温度检测</div>
      <strong>排气热电偶 <code>0005350260</code> / <code>0005353960</code></strong>，用于一台连续运行的 MTU 396。买家要求品牌 OE 件（不要白牌）。我们报了原厂热电偶；非 MTU 传感器品牌的交叉引用按买家要求以照片确认。
    </div>

    <div class="enquiry-log">
      <div class="meta">RFQ · 招标 / 项目买家 · 垫片</div>
      <strong>垫片 <code>5600160180</code></strong>，MTU 396 用，属多行招标的一部分。按零件号识别；随附针对发动机型号的适配确认。
    </div>

    <div class="enquiry-log">
      <div class="meta">RFQ · 船配供应商 · 库存匹配</div>
      <strong>MTU 396 备件清单</strong>——一家船配供应商发来 MTU 零件清单，要求逐行匹配可用库存。体现了「发来您的清单，我们逐号匹配」的工作流。
    </div>

    <div class="enquiry-log">
      <div class="meta">RFQ · 大修 / 保养包</div>
      <strong>MTU 396 保养与大修包</strong>——定期保养组合（活塞、活塞环、轴承、垫片、密封件）。在买方接受凭证等价件的前提下，经非 OEM 替代渠道采购。
    </div>

    <h2>6. 供货选项</h2>
    <div class="hub-grid">
      <div class="hub-card"><div class="hub-card-body"><h3 class="hub-card-title">原厂新件</h3><p class="hub-card-summary">MTU 原包装零件，溯源完整——在文件链需经受检验的场合最为稳妥。</p></div></div>
      <div class="hub-card"><div class="hub-card-body"><h3 class="hub-card-title">翻新 / 交换件</h3><p class="hub-card-summary">油泵、喷油器、涡轮增压器的工厂级翻新——成本通常低 30–40%，交货期更短。</p></div></div>
      <div class="hub-card"><div class="hub-card-body"><h3 class="hub-card-title">凭证替代件</h3><p class="hub-card-summary">经核验的等价件，适用于买方接受的非关键项目——常规大修性价比之选。</p></div></div>
    </div>

    <h2>7. MTU 系列集群</h2>
    <p>下列专区按我们实际收到的询盘对 MTU 家族分组。396 页面含实时 RFQ 核验零件号；2000 页面目录预置数据丰富；两者均链接至 4000 家族：</p>
    <div class="hub-grid">
      <a class="hub-card" href="/series/mtu-396-variants/"><div class="hub-card-body"><h3 class="hub-card-title">MTU 396 变型解读</h3><p class="hub-card-summary">TB / TC / TE / SE 用途代码与分型号表——哪些零件随构型而异。</p></div></a>
      <a class="hub-card" href="/series/mtu-2000/"><div class="hub-card-body"><h3 class="hub-card-title">MTU 2000 系列专区</h3><p class="hub-card-summary">8V / 12V / 16V / 18V 高速发动机——游艇、巡逻艇、渡轮、船用发电机组。</p></div></a>
      <a class="hub-card" href="/products/mtu-4000-series-parts/"><div class="hub-card-body"><h3 class="hub-card-title">MTU 4000 系列配件</h3><p class="hub-card-summary">12V / 16V / 20V 同族更大机型——更高功率的船用与发电用途。</p></div></a>
      <a class="hub-card" href="/products/mtu-spare-parts/mtu-engine-series-guide/"><div class="hub-card-body"><h3 class="hub-card-title">MTU 发动机系列指南</h3><p class="hub-card-summary">MTU 家族全图——询价前先选对系列。</p></div></a>
      <a class="hub-card" href="/series/mtu-1163/"><div class="hub-card-body"><h3 class="hub-card-title">MTU 1163 系列专区</h3><p class="hub-card-summary">12V / 16V / 20V 大缸径家族（230 × 280 mm）——海军与高速渡轮。</p></div></a>
      <a class="hub-card" href="/series/mtu-4000-variants/"><div class="hub-card-body"><h3 class="hub-card-title">MTU 4000 变型解读</h3><p class="hub-card-summary">M05 / M03 / C05 / R03 / R04 / T05 及 M 用途标识——同族更大机型。</p></div></a>
      <a class="hub-card" href="/series/12v396te94/"><div class="hub-card-body"><h3 class="hub-card-title">MTU 12V 396 TE94</h3><p class="hub-card-summary">单机型深度解析——1,680 kW 船用与发电发动机，含实时 RFQ 零件号。</p></div></a>
    </div>

    <FaqSection items={faqItems} title="MTU 396 系列常见问题" subtitle="常见问题" />
  </DetailPageShell>
</BaseLayout>

<style>
  .rfq-badge {
    display: inline-block;
    font-size: 11px;
    font-weight: 700;
    padding: 2px 8px;
    border-radius: 10px;
    letter-spacing: 0.03em;
    vertical-align: middle;
  }
  .rfq-badge.rfq {
    background: #fdeccb;
    color: #9a5b00;
  }
  .rfq-badge.cat {
    background: #e4eef7;
    color: var(--color-primary);
  }
  .enquiry-log {
    border-left: 3px solid var(--color-primary);
    background: var(--color-background);
    padding: 14px 18px;
    border-radius: 0 8px 8px 0;
    margin: 12px 0;
  }
  .enquiry-log .meta {
    font-size: 12.5px;
    color: var(--color-body-text);
    opacity: 0.8;
    margin-bottom: 4px;
  }
  .enquiry-log code {
    background: #eef3f8;
    padding: 1px 6px;
    border-radius: 4px;
    font-size: 13px;
    color: #0a3d66;
  }
  .hub-card h3.hub-card-title {
    font-size: 17px;
  }
  .resource-table code {
    background: #eef3f8;
    padding: 1px 6px;
    border-radius: 4px;
    font-size: 13px;
    color: #0a3d66;
  }
</style>
