---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BreadcrumbHero from '../../components/BreadcrumbHero.astro';
import FunnelPageView from '../../components/FunnelPageView.astro';
import DetailRfqStrip from '../../components/DetailRfqStrip.astro';
import QuotationExamples from '../../components/QuotationExamples.astro';
import { quotationExamples } from '../../data/quotation-examples';
import { publishedCaseStudies } from '../../data/case-studies';
import { breadcrumbSchema, site } from '../../data/site';
import '../../styles/resource-page.css';

const pageUrl = `${site.url}/case-studies/`;
const hasCases = publishedCaseStudies.length > 0 || quotationExamples.length > 0;
---

<BaseLayout
  title="客户供货案例 — 在役发动机零件"
  description="真实的发动机零件供货案例，均经客户书面授权后发布：应用场景、所供零件与最终结果。"
  currentPath="/case-studies"
  noindex={!hasCases}
  jsonLd={[
    breadcrumbSchema([
      { name: '首页', url: site.url },
      { name: '客户案例', url: pageUrl },
    ]),
  ]}
>
  <FunnelPageView stage="signing" label="case-studies-index" />
  <BreadcrumbHero
    title="客户供货案例"
    trail={[{ label: '首页', href: '/' }, { label: '客户案例' }]}
    variant="2"
  />

  <div class="resource-page">
    {quotationExamples.length > 0 && <QuotationExamples ids={quotationExamples.map((example) => example.id)} source="completed-order-cases" />}
    {publishedCaseStudies.length > 0 ? (
      <section class="resource-page-section">
        <div class="guides-grid">
          {publishedCaseStudies.map((study) => (
            <a class="guide-card" href={`/case-studies/${study.slug}/`}>
              <h2>{study.title}</h2>
              <p>{study.summary}</p>
              <span class="guide-card__meta">{study.industry} · {study.region} →</span>
            </a>
          ))}
        </div>
      </section>
    ) : !hasCases && (
      <section class="resource-page-section">
        <p>
          我们仅在获得客户书面授权后发布供货案例——包括应用场景、所供零件号，以及客户视角的结果。首批案例正与相关客户共同整理中。
        </p>
        <p>
          在案例发布前，评估我们最直接的方式是：提供一个零件号，连同发动机型号与出厂编号，亲自检验我们的核验与报价流程。
        </p>
        <ul class="resource-olist">
          <li><a href="/certifications/">质量与认证</a> — 发货前的零件核验方式</li>
          <li><a href="/terms/payment/">付款与运输条款</a></li>
          <li><a href="/part-products/">MTU 零件号目录</a></li>
        </ul>
      </section>
    )}

    <DetailRfqStrip
      title="以一次真实询价检验我们"
      text="一个零件号足矣。报价前，我们将对照您的发动机出厂编号核验适配。"
      quoteHref="/contact/?source=case-studies"
      label="发起询价"
      modalSource="case-studies"
    />
  </div>
</BaseLayout>

<style>
  .guides-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 18px;
  }

  .guide-card {
    display: block;
    border: 1px solid #e2e8f0;
    border-radius: 10px;
    padding: 20px;
    color: inherit;
    text-decoration: none;
  }

  .guide-card:hover {
    border-color: var(--color-primary, #146ef5);
  }

  .guide-card h2 {
    margin: 0 0 10px;
    font-size: 20px;
  }

  .guide-card p {
    margin: 0 0 12px;
    color: #475569;
    font-size: 15px;
  }

  .guide-card__meta {
    color: var(--color-primary, #146ef5);
    font-size: 14px;
    font-weight: 700;
  }
</style>
