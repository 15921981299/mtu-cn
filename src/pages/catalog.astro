---
import { existsSync, statSync } from 'node:fs';
import { resolve } from 'node:path';
import BaseLayout from '../layouts/BaseLayout.astro';
import BreadcrumbHero from '../components/BreadcrumbHero.astro';
import FunnelPageView from '../components/FunnelPageView.astro';
import DetailRfqStrip from '../components/DetailRfqStrip.astro';
import { breadcrumbSchema, faqSchema, site } from '../data/site';
import catalogsJson from '../data/download-catalogs.json';
import '../styles/resource-page.css';

/**
 * Downloadable catalog hub. The PDFs themselves are produced by
 * `npm run catalogs` (scripts/build-catalogs.mjs) from src/data/mtu-parts.ts.
 *
 * The existence check below is deliberate and hard: the manifest and the files
 * on disk are produced by two different steps, and a page that links to eight
 * 404s is worse than no page at all. If a PDF is missing the build stops here
 * rather than shipping dead download links.
 */

type Catalog = {
  slug: string;
  file: string;
  title: string;
  heading: string;
  subtitle: string;
  series: string;
  parts: number;
  pages: number;
  bytes: number;
  /** ISO date the PDF was generated, written by scripts/build-catalogs.mjs. */
  generated: string;
};

const catalogs = catalogsJson as Catalog[];

const missing: string[] = [];
for (const catalog of catalogs) {
  const onDisk = resolve('public', catalog.file.replace(/^\//, ''));
  if (!existsSync(onDisk) || statSync(onDisk).size < 2000) {
    missing.push(catalog.file);
  } else if (!/^\d{4}-\d{2}-\d{2}$/.test(catalog.generated ?? '')) {
    // A manifest without a generation date was written by an older revision of
    // the script and would render a page claiming no date at all. Treat it the
    // same as a missing PDF: rebuild rather than ship a half-true page.
    missing.push(`${catalog.file} (manifest has no generation date)`);
  }
}
if (missing.length > 0) {
  throw new Error(
    `Downloadable catalogs referenced by src/data/download-catalogs.json are missing or stale: ` +
      `${missing.join(', ')}. Run \`npm run catalogs\` before building.`
  );
}

const totalParts = catalogs.find((c) => c.slug === 'MTU-Engine-Parts-Catalog-Complete')?.parts ?? 0;
const seriesCatalogs = catalogs.filter((c) => c.slug !== 'MTU-Engine-Parts-Catalog-Complete');
const complete = catalogs.find((c) => c.slug === 'MTU-Engine-Parts-Catalog-Complete');

const formatSize = (bytes: number) => `${Math.round(bytes / 1024)} KB`;

const pageUrl = `${site.url}/catalog/`;

const faqs = [
  {
    question: '目录是否免费，需要注册吗？',
    answer:
      '两个文件均免费，无需表单、无需邮箱门槛、无需账号。点击下载即可获得 PDF。我们更希望您在写信之前先核对零件号，而不是用您的邮箱来换一个文件。',
  },
  {
    question: '目录中包含价格吗？',
    answer:
      '不包含。目录是零件号参考索引：零件号、零件名称、所属系统、发动机系列、HS 编码与单件重量。价格、供货情况与交货期取决于供货路线、数量与目的地，因此按询价报价，而不是印成一个月就会过期的清单。',
  },
  {
    question: '零件号出现在目录中，是否意味着适合我的发动机？',
    answer:
      '不是。系列列告诉您该编号所属的发动机家族，这与为您的发动机确认它不是一回事。许多部位在不同生产批次中发生过变更，因此下单前必须对照完整的发动机型号与出厂编号核查。请将这两项信息连同编号一并发来，我们予以确认。',
  },
  {
    question: '目录的更新程度如何？',
    answer:
      '每个目录都注明生成日期，并在我们的零件记录变更时重新生成。如果日期看起来较旧，也请照常发来零件号——您询价时其背后的记录会实时核查，替代关系会在报价前追溯。',
  },
  {
    question: '我的零件号不在目录中，你们还能供应吗？',
    answer:
      '能。目录只是我们持有经核验记录的编号索引，而不是可采购范围的限制。请发来您手上的编号，连同发动机型号与出厂编号，我们会追溯它——包括它已被替代的情况。',
  },
  {
    question: '可以换成电子表格提供清单吗？',
    answer:
      '可以。如果您需要将长清单与自己的库存系统比对，请发来待核查的零件号，我们会以电子表格形式返回比对结果。PDF 为纯文本文档，零件号也可直接复制。',
  },
];

// No `hasPersonAuthor` here on purpose: this is a download/reference hub, not an
// article, so it carries no Article schema to attribute. The trust signals on
// this page are the disclosures (no prices, no email gate, "read the number,
// not mine") and the live FAQ, not a byline.
---

<BaseLayout
  title="MTU 备件目录（PDF 下载）| 柴油零件源"
  description={`下载 MTU 备件目录 PDF——收录 ${totalParts} 个零件号，覆盖 2000、4000、396、1163、956、538 与 595 系列，含零件名称、所属系统、HS 编码与单件重量。免费，无需注册。`}
  currentPath="/catalog"
  jsonLd={[
    breadcrumbSchema([
      { name: '首页', url: site.url },
      { name: '目录下载', url: pageUrl },
    ]),
    faqSchema(faqs),
  ]}
>
  <FunnelPageView stage="comparison" label="catalog-downloads" />
  <BreadcrumbHero
    title="MTU 备件目录 — PDF 下载"
    trail={[{ label: '首页', href: '/' }, { label: '目录下载' }]}
    variant="2"
  />

  <div class="resource-page">
    <section class="resource-page-section">
      <p>
        以下是我们零件号索引的可下载版本：<strong>收录 {totalParts} 个零件号</strong>，
        覆盖我们供货的 MTU 发动机系列，每行列出零件号、零件名称、所属系统、发动机系列、HS 编码与单件重量。
        它们由本站其余部分所依据的同一套经核验记录生成——不是抓取的清单，也不是销售宣传册。
      </p>
      <p>
        文件为纯文本 PDF，零件号可选中复制，可用浏览器或阅读器搜索，也可打印到车间使用。<strong>无需注册，无邮箱门槛</strong>。
      </p>
      <div class="resource-meta">
        <span><strong>零件号</strong> 已收录 {totalParts} 个</span>
        <span><strong>覆盖系列</strong> {seriesCatalogs.length} 个系列 + 完整清单</span>
        <span><strong>字段</strong> 名称、系统、系列、HS 编码、单件重量</span>
        <span><strong>价格数据</strong> 不含——按询价报价</span>
      </div>
    </section>

    <section class="resource-page-section">
      <h2>先下载完整清单，或按系列下载</h2>
      {complete && (
        <a class="catalog-card catalog-card--primary" href={complete.file} download>
          <div class="catalog-card__head">
            <h3>{complete.zhHeading ?? complete.heading}</h3>
            <span class="catalog-card__cta">下载 PDF</span>
          </div>
          <p>{complete.zhSubtitle ?? complete.subtitle}</p>
          <span class="catalog-card__meta">
            {complete.parts} 个零件号 · {complete.pages} 页 · {formatSize(complete.bytes)} · 生成于{' '}
            {complete.generated}
          </span>
        </a>
      )}

      <div class="catalog-grid">
        {seriesCatalogs.map((catalog) => (
          <a class="catalog-card" href={catalog.file} download>
            <div class="catalog-card__head">
              <h3>{catalog.zhHeading ?? catalog.heading}</h3>
              <span class="catalog-card__cta">PDF</span>
            </div>
            <p>{catalog.zhSubtitle ?? catalog.subtitle}</p>
            <span class="catalog-card__meta">
              {catalog.parts} 个零件号 · {catalog.pages} 页 · {formatSize(catalog.bytes)} ·{' '}
              {catalog.generated}
            </span>
          </a>
        ))}
      </div>
    </section>

    <section class="resource-page-section">
      <h2>各列含义说明</h2>
      <ul class="resource-checklist">
        <li><strong>零件号</strong>——我们记录的参考号，完整印出，便于检索与复制</li>
        <li><strong>零件名称</strong>——零件的简明描述，如垫片、喷油器、气门锁夹</li>
        <li><strong>所属系统</strong>——该编号归属的总成分组，对照图纸作业时很有用</li>
        <li><strong>发动机系列</strong>——该编号编入的发动机家族</li>
        <li><strong>HS 编码</strong>——海关归类，便于询价前估算关税</li>
        <li><strong>单件重量</strong>——每件运输重量，用于运费规划；重量因具体变型而异的，标注“按询价确认”</li>
      </ul>
      <p>
        文件中刻意<strong>不含</strong>的内容：价格、库存水平、交货期与供应商信息。这些取决于当时的供货路线，属于针对具体发动机的报价内容，而不是几周内就会过期的清单内容。
      </p>
    </section>

    <section class="resource-page-section">
      <h2>如何利用目录快速获得答复</h2>
      <ol class="catalog-steps">
        <li>
          <h3>找到编号并记下所属系统</h3>
          <p>在 PDF 中搜索您手上的编号。如果只有描述，请按系统浏览以缩小范围。</p>
        </li>
        <li>
          <h3>补上发动机型号与出厂编号</h3>
          <p>目录确认该编号存在于我们的记录中；出厂编号决定它是否为您发动机所装的修订版本。</p>
        </li>
        <li>
          <h3>连同数量与目的地一起发送清单</h3>
          <p>跨多个部位的合并清单逐行报价，每行注明供货路线，运费一并计入。</p>
        </li>
      </ol>
      <p>
        如果您的编号完全不在目录中，也并非到此为止——照常发来即可。目录是索引而非限制，已被替代的编号不会出现在您手上的参考号之下。
        如果您在对照图纸作业，请参阅<a href="/guides/how-to-read-mtu-parts-diagram/">如何阅读零件图</a>；
        如果需要把旧编号对应到新编号，请使用<a href="/cross-reference/">零件号交叉引用</a>。
      </p>
    </section>

    <section class="resource-page-section">
      <h2>相关工具</h2>
      <ul class="resource-olist">
        <li><a href="/part-products/">MTU 零件号目录</a>——同样的编号在线可查，每个均附完整适配与互换详情</li>
        <li><a href="/engine-models/">按发动机型号列出的零件清单</a>——按型号代码而非按编号分组</li>
        <li><a href="/cross-reference/">零件号交叉引用</a>——OEM 号与被替代号对应到现行参考号</li>
        <li><a href="/guides/">发动机零件指南</a>——大修规划与系列识别</li>
      </ul>
    </section>

    <section class="resource-page-section">
      <h2>常见问题</h2>
      {faqs.map((item) => (
        <details class="guide-faq-item">
          <summary>{item.question}</summary>
          <p>{item.answer}</p>
        </details>
      ))}
    </section>

    <DetailRfqStrip
      title="清单准备好了？原样发来即可"
      text="零件号、数量、发动机型号与出厂编号，以及目的港。我们逐行核查，并注明供货路线后报价。"
      quoteHref="/contact/?source=catalog-downloads"
      label="发起零件询价"
      modalSource="catalog-downloads"
    />
  </div>
</BaseLayout>

<style>
  .catalog-card {
    display: block;
    border: 1px solid #e2e8f0;
    border-radius: 10px;
    padding: 18px 20px;
    color: inherit;
    text-decoration: none;
    transition: border-color 0.15s ease, box-shadow 0.15s ease;
  }

  .catalog-card:hover {
    border-color: var(--color-primary, #146ef5);
    box-shadow: 0 8px 24px rgba(15, 23, 42, 0.08);
  }

  .catalog-card--primary {
    border-color: #bcd6fb;
    background: #f5f9ff;
    margin-bottom: 18px;
  }

  .catalog-card__head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 14px;
    flex-wrap: wrap;
  }

  .catalog-card h3 {
    margin: 0;
    font-size: 17px;
    line-height: 1.3;
  }

  .catalog-card__cta {
    color: var(--color-primary, #146ef5);
    font-size: 13px;
    font-weight: 700;
    white-space: nowrap;
  }

  .catalog-card p {
    margin: 8px 0 10px;
    color: #475569;
    font-size: 14.5px;
    line-height: 1.55;
  }

  .catalog-card__meta {
    color: #64748b;
    font-size: 13px;
  }

  .catalog-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 16px;
  }

  .catalog-steps {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .catalog-steps li {
    border-left: 3px solid #e2e8f0;
    padding: 0 0 4px 18px;
    margin-bottom: 20px;
  }

  .catalog-steps h3 {
    margin: 0 0 6px;
    font-size: 16px;
  }

  .catalog-steps p {
    margin: 0;
  }

  .guide-faq-item {
    border: 1px solid #e2e8f0;
    border-radius: 8px;
    padding: 14px 16px;
    margin-bottom: 10px;
  }

  .guide-faq-item summary {
    cursor: pointer;
    font-weight: 700;
  }

  .guide-faq-item p {
    margin: 10px 0 0;
    color: #475569;
    line-height: 1.6;
  }
</style>
