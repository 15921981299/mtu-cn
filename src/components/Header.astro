---
import { site } from '../data/site';
import PartSearch from './PartSearch.astro';

interface Props {
  currentPath?: string;
}

const { currentPath = '/' } = Astro.props;
const isActive = (path: string) => currentPath === path || (path !== '/' && currentPath.startsWith(path));
const productsActive = isActive('/products') || isActive('/part-products');
const supportActive = isActive('/capabilities') || isActive('/industries');
const companyActive = isActive('/about') || isActive('/certifications');
const resourcesActive = isActive('/resources') || isActive('/part-products/catalog') || isActive('/part-number-index');
const phoneHref = `tel:${site.phone.replace(/\s/g, '')}`;
---

<header class="header">
  <div class="container">
    <nav class="navbar" aria-label="主导航">
      <div class="navbar-wrapper">
        <a href="/" class="navbar-brand" aria-label="国晁动力首页">
          <img src={site.logo.default} srcset={`${site.logo.compact} 440w, ${site.logo.default} 660w`} sizes="220px" alt={site.logo.alt} class="brand-logo is-1" width={site.logo.width} height={site.logo.height} loading="eager" fetchpriority="high" decoding="async" />
          <img src={site.logo.default} srcset={`${site.logo.compact} 440w, ${site.logo.default} 660w`} sizes="220px" alt="" aria-hidden="true" class="brand-logo is-2" width={site.logo.width} height={site.logo.height} loading="eager" decoding="async" />
        </a>

        <div class="nav-menu-block" id="nav-menu">
          <div class="nav-mobile-brand">
            <a href="/" class="navbar-brand" aria-label="国晁动力首页">
              <img src={site.logo.default} srcset={`${site.logo.compact} 440w, ${site.logo.default} 660w`} sizes="220px" alt={site.logo.alt} class="brand-logo" width={site.logo.width} height={site.logo.height} loading="eager" decoding="async" />
            </a>
            <button class="nav-close-btn" aria-label="关闭菜单" id="nav-close">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M18 6L6 18M6 6l12 12" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path>
              </svg>
            </button>
          </div>

          <ul class="nav-menu">
            <li class="nav-menu-list nav-desktop-hide">
              <div class="nav-menu-link-wrapper">
                <a href="/" class:list={['nav-menu-link', { active: isActive('/') }]} aria-current={isActive('/') ? 'page' : undefined}>首页</a>
                <div class="nav-link-line-shape"></div>
              </div>
            </li>

            <li class="nav-menu-list">
              <div class="nav-dropdown">
                <button class="nav-dropdown-toggle" aria-expanded="false" aria-haspopup="true">
                  <span class="nav-menu-link" class:list={['nav-menu-link', { active: productsActive }]}>配件</span>
                  <svg class="nav-dropdown-icon" width="14" height="8" viewBox="0 0 14 8" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M13 1C13 1 8.581 7 7 7C5.419 7 1 1 1 1" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
                  </svg>
                  <div class="nav-link-line-shape"></div>
                </button>
                <div class="nav-dropdown-list nav-dropdown-list--grid">
                  <div class="nav-dropdown-panel">
                      <a href="/products/mtu-spare-parts/" class="nav-dropdown-link-block"><div class="nav-dropdown-shape"></div><span class="nav-dropdown-link-text">MTU 配件</span></a>
                      <a href="/products/mtu-2000-series-parts/" class="nav-dropdown-link-block"><div class="nav-dropdown-shape"></div><span class="nav-dropdown-link-text">MTU 2000 系列配件</span></a>
                      <a href="/products/mtu-4000-series-parts/" class="nav-dropdown-link-block"><div class="nav-dropdown-shape"></div><span class="nav-dropdown-link-text">MTU 4000 系列配件</span></a>
                      <a href="/products/mtu-series-8000-engines/" class="nav-dropdown-link-block"><div class="nav-dropdown-shape"></div><span class="nav-dropdown-link-text">MTU 8000 系列配件</span></a>
                      <a href="/part-products/" class="nav-dropdown-link-block"><div class="nav-dropdown-shape"></div><span class="nav-dropdown-link-text">MTU 零件号总目录</span></a>
                      <a href="/products/detroit-diesel-parts/" class="nav-dropdown-link-block"><div class="nav-dropdown-shape"></div><span class="nav-dropdown-link-text">Detroit Diesel 配件</span></a>
                      <a href="/products/cummins-parts/" class="nav-dropdown-link-block"><div class="nav-dropdown-shape"></div><span class="nav-dropdown-link-text">Cummins 配件</span></a>
                      <a href="/products/deutz-parts/" class="nav-dropdown-link-block"><div class="nav-dropdown-shape"></div><span class="nav-dropdown-link-text">DEUTZ 配件</span></a>
                      <a href="/products/" class="nav-dropdown-link-block"><div class="nav-dropdown-shape"></div><span class="nav-dropdown-link-text">全部配件</span></a>
                  </div>
                </div>
              </div>
            </li>

            <li class="nav-menu-list mobile-none"><div class="dot"></div></li>
            <li class="nav-menu-list">
              <div class="nav-menu-link-wrapper">
                <a href="/capabilities/" class:list={['nav-menu-link', { active: supportActive }]}>服务与支持</a>
                <div class="nav-link-line-shape"></div>
              </div>
            </li>

            <li class="nav-menu-list mobile-none"><div class="dot"></div></li>
            <li class="nav-menu-list">
              <div class="nav-dropdown">
                <button class="nav-dropdown-toggle" aria-expanded="false" aria-haspopup="true">
                  <span class="nav-menu-link" class:list={['nav-menu-link', { active: resourcesActive }]}>目录与工具</span>
                  <svg class="nav-dropdown-icon" width="14" height="8" viewBox="0 0 14 8" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M13 1C13 1 8.581 7 7 7C5.419 7 1 1 1 1" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
                  </svg>
                  <div class="nav-link-line-shape"></div>
                </button>
                <div class="nav-dropdown-list nav-dropdown-list--grid nav-dropdown-list--systems">
                  <div class="nav-dropdown-panel">
                    <div class="nav-dropdown-col">
                      <span class="nav-dropdown-group-label">按系统</span>
                      <a href="/part-products/catalog/mtu-injectors/" class="nav-dropdown-link-block"><div class="nav-dropdown-shape"></div><span class="nav-dropdown-link-text">喷油器与喷嘴</span></a>
                      <a href="/part-products/catalog/mtu-fuel-pumps/" class="nav-dropdown-link-block"><div class="nav-dropdown-shape"></div><span class="nav-dropdown-link-text">燃油泵</span></a>
                      <a href="/part-products/catalog/mtu-filters/" class="nav-dropdown-link-block"><div class="nav-dropdown-shape"></div><span class="nav-dropdown-link-text">滤清器</span></a>
                      <a href="/part-products/catalog/mtu-turbocharger-parts/" class="nav-dropdown-link-block"><div class="nav-dropdown-shape"></div><span class="nav-dropdown-link-text">涡轮增压</span></a>
                      <a href="/part-products/catalog/mtu-cooling-system/" class="nav-dropdown-link-block"><div class="nav-dropdown-shape"></div><span class="nav-dropdown-link-text">冷却系统</span></a>
                      <a href="/part-products/catalog/mtu-gasket-kits/" class="nav-dropdown-link-block"><div class="nav-dropdown-shape"></div><span class="nav-dropdown-link-text">垫片与密封件</span></a>
                      <a href="/part-products/catalog/mtu-sensors/" class="nav-dropdown-link-block"><div class="nav-dropdown-shape"></div><span class="nav-dropdown-link-text">传感器与电气</span></a>
                      <a href="/part-products/catalog/mtu-starter-motors-alternators/" class="nav-dropdown-link-block"><div class="nav-dropdown-shape"></div><span class="nav-dropdown-link-text">起动机与发电机</span></a>
                      <a href="/part-products/catalog/mtu-cylinder-heads/" class="nav-dropdown-link-block"><div class="nav-dropdown-shape"></div><span class="nav-dropdown-link-text">气缸盖与缸盖罩</span></a>
                      <a href="/products/mtu-spare-parts/mtu-overhaul-kits/" class="nav-dropdown-link-block"><div class="nav-dropdown-shape"></div><span class="nav-dropdown-link-text">大修包</span></a>
                    </div>
                    <div class="nav-dropdown-col">
                      <span class="nav-dropdown-group-label">按发动机系列</span>
                      <a href="/part-products/" class="nav-dropdown-link-block"><div class="nav-dropdown-shape"></div><span class="nav-dropdown-link-text">全部 MTU 零件号</span></a>
                      <a href="/part-products/catalog/mtu-2000-series/" class="nav-dropdown-link-block"><div class="nav-dropdown-shape"></div><span class="nav-dropdown-link-text">MTU 2000 目录</span></a>
                      <a href="/part-products/catalog/mtu-4000-series/" class="nav-dropdown-link-block"><div class="nav-dropdown-shape"></div><span class="nav-dropdown-link-text">MTU 4000 目录</span></a>
                      <a href="/series/mtu-396/" class="nav-dropdown-link-block"><div class="nav-dropdown-shape"></div><span class="nav-dropdown-link-text">MTU 396 系列汇总</span></a>
                      <a href="/series/mtu-1163/" class="nav-dropdown-link-block"><div class="nav-dropdown-shape"></div><span class="nav-dropdown-link-text">MTU 1163 系列汇总</span></a>
                      <a href="/series/mtu-2000-variants/" class="nav-dropdown-link-block"><div class="nav-dropdown-shape"></div><span class="nav-dropdown-link-text">MTU 2000 变型说明</span></a>
                      <a href="/series/mtu-4000-variants/" class="nav-dropdown-link-block"><div class="nav-dropdown-shape"></div><span class="nav-dropdown-link-text">MTU 4000 变型解码</span></a>
                    </div>
                    <div class="nav-dropdown-col">
                      <span class="nav-dropdown-group-label">指南与工具</span>
                      <a href="/guides/" class="nav-dropdown-link-block"><div class="nav-dropdown-shape"></div><span class="nav-dropdown-link-text">配件选型指南</span></a>
                      <a href="/engine-models/" class="nav-dropdown-link-block"><div class="nav-dropdown-shape"></div><span class="nav-dropdown-link-text">按型号查零件清单</span></a>
                      <a href="/cross-reference/" class="nav-dropdown-link-block"><div class="nav-dropdown-shape"></div><span class="nav-dropdown-link-text">零件号交叉引用</span></a>
                      <a href="/part-number-index/" class="nav-dropdown-link-block"><div class="nav-dropdown-shape"></div><span class="nav-dropdown-link-text">零件号总索引</span></a>
                      <a href="/products/mtu-spare-parts/mtu-1600-series-parts/" class="nav-dropdown-link-block"><div class="nav-dropdown-shape"></div><span class="nav-dropdown-link-text">1600 系列与 F 构型</span></a>
                      <a href="/products/mtu-spare-parts/mtu-legacy-gas-engine-parts/" class="nav-dropdown-link-block"><div class="nav-dropdown-shape"></div><span class="nav-dropdown-link-text">经典系列与燃气机</span></a>
                      <a href="/products/mtu-spare-parts/mtu-genset-parts-by-power/" class="nav-dropdown-link-block"><div class="nav-dropdown-shape"></div><span class="nav-dropdown-link-text">按功率查发电机组配件</span></a>
                      <a href="/standing-parts/" class="nav-dropdown-link-block"><div class="nav-dropdown-shape"></div><span class="nav-dropdown-link-text">在售系列清单</span></a>
                    </div>
                  </div>
                </div>
              </div>
            </li>

            <li class="nav-menu-list mobile-none"><div class="dot"></div></li>
            <li class="nav-menu-list">
              <div class="nav-dropdown">
                <button class="nav-dropdown-toggle" aria-expanded="false" aria-haspopup="true">
                  <span class="nav-menu-link" class:list={['nav-menu-link', { active: companyActive }]}>关于我们</span>
                  <svg class="nav-dropdown-icon" width="14" height="8" viewBox="0 0 14 8" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M13 1C13 1 8.581 7 7 7C5.419 7 1 1 1 1" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
                  </svg>
                  <div class="nav-link-line-shape"></div>
                </button>
                <div class="nav-dropdown-list">
                  <div class="nav-dropdown-panel">
                    <a href="/about/" class="nav-dropdown-link-block"><div class="nav-dropdown-shape"></div><span class="nav-dropdown-link-text">公司介绍</span></a>
                    <a href="/certifications/" class="nav-dropdown-link-block"><div class="nav-dropdown-shape"></div><span class="nav-dropdown-link-text">质量政策</span></a>
                    <a href="/contact/" class="nav-dropdown-link-block"><div class="nav-dropdown-shape"></div><span class="nav-dropdown-link-text">配件询价</span></a>
                  </div>
                </div>
              </div>
            </li>

            <li class="nav-menu-list mobile-none"><div class="dot"></div></li>
            <li class="nav-menu-list">
              <div class="nav-menu-link-wrapper">
                <a href="/contact/" class:list={['nav-menu-link', 'nav-menu-link--cta', { active: isActive('/contact') }]}>联系询价</a>
                <div class="nav-link-line-shape"></div>
              </div>
            </li>
          </ul>
        </div>

        <PartSearch />

        <a href={phoneHref} class="contact-number-block contact-number-block--compact" aria-label={`拨打询价热线 ${site.phoneDisplay}`}>
          <div class="contact-icon-block">
            <div class="contact-icon-circle-one"></div>
            <div class="contact-icon-circle-two"></div>
            <div class="contact-icon">
              <svg width="18" height="18" viewBox="0 0 18 18" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M6.158 2.712L5.756 1.806C5.492 1.214 5.361.918 5.164.691C4.917.407 4.595.198 4.236.088C3.949 0 3.624 0 2.976 0C2.028 0 1.554 0 1.156.182C.687.397.263.863.095 1.351C-.048 1.764.075 3.04.948 12.09C1.948 14.91 3.09 16.052 5.91 17.052C8.73 18.052 10.641 17.925 14.96 17.925C15.811 18.008 16.649 17.905 17.137 17.737C17.603 17.313 17.818 16.844 18 16.446V15.024C18 14.376 18 14.051 17.912 13.764C17.802 13.405 17.593 13.083 17.309 12.836C17.082 12.639 16.786 12.508 16.194 12.244L15.288 11.842C14.646 11.557 14.326 11.414 14 11.383C13.688 11.353 13.373 11.397 13.081 11.511C12.776 11.63 12.506 11.854 11.967 12.304C11.43 12.751 10.834 13.095 10.543 13.201C10.159 13.24 9.852 13.195 9.507 13.144C9.242 13.003 8.713 12.72 8.713 12.72C7.067 11.841 6.16 10.933 5.28 9.287C4.997 8.758 4.856 8.493 4.805 8.148C4.76 7.841 4.799 7.457 4.905 7.166C5.025 6.838 5.249 6.57 5.696 6.033C6.146 5.494 6.37 5.224 6.489 4.919C6.603 4.627 6.647 4.312 6.617 4C6.586 3.675 6.443 3.354 6.158 2.712Z" fill="currentColor"></path>
              </svg>
            </div>
          </div>
          <div class="contact-text-block contact-text-block--desktop">
            <p class="contact-text">询价热线</p>
            <span class="contact-text hover">{site.phoneDisplay}</span>
          </div>
        </a>
        <button class="menu-button" aria-label="打开菜单" id="menu-toggle">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M3 12h18M3 6h18M3 18h18" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path>
          </svg>
        </button>
      </div>
    </nav>
  </div>
</header>

<script>
  import '../scripts/nav.ts';
</script>
