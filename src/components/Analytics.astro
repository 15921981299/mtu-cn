---
import { site } from '../data/site';

const { gaMeasurementId, enableGa4, baiduAnalyticsId } = site;
---

{baiduAnalyticsId && (
  <script is:inline define:vars={{ baiduAnalyticsId }}>
    var _hmt = _hmt || [];
    (function () {
      var hm = document.createElement('script');
      hm.src = 'https://hm.baidu.com/hm.js?' + baiduAnalyticsId;
      var s = document.getElementsByTagName('script')[0];
      s.parentNode.insertBefore(hm, s);
    })();
  </script>
)}

{enableGa4 && gaMeasurementId && (
  <>
    <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${gaMeasurementId}`}></script>
    <script is:inline define:vars={{ gaMeasurementId }}>
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        dataLayer.push(arguments);
      }
      gtag('js', new Date());
      gtag('config', gaMeasurementId, {
        send_page_view: true,
        allow_google_signals: true,
      });
      window.gtag = gtag;
    </script>
  </>
)}
