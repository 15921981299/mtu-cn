---
import { site } from '../data/site';
---
<footer class="footer-section">
  <div class="container">
    <div class="footer-wrapper">
      <div class="footer-content-block">
        <a href="/" class="footer-logo-link-block">
          <img src={site.logo.default} srcset={`${site.logo.compact} 440w, ${site.logo.default} 660w`} sizes="220px" alt={site.logo.alt} class="footer-logo" width={site.logo.width} height={site.logo.height} loading="lazy" decoding="async" />
        </a>
        <p class="footer-title">配件核验<br />快速全球交付</p>
        <a href="/contact/" class="primary-button footer">
          <div class="button-content-block">
            <div class="button-text">发起询价</div>
            <div class="button-text">发起询价</div>
          </div>
        </a>
      </div>
    </div>
    <div class="footer-bottom-block">
      <nav class="footer-nav-grid" aria-label="页脚导航">
        <div class="footer-nav-col">
          <p class="footer-nav-label">配件</p>
          <a href="/products/mtu-spare-parts/" class="footer-link">MTU 配件</a>
          <a href="/products/mtu-2000-series-parts/" class="footer-link">MTU 2000 系列配件</a>
          <a href="/products/mtu-4000-series-parts/" class="footer-link">MTU 4000 系列配件</a>
          <a href="/products/mtu-2000-series-parts/16v-2000-engine-parts/" class="footer-link">MTU 16V 2000 配件</a>
          <a href="/products/mtu-4000-series-parts/12v-4000-engine-parts/" class="footer-link">MTU 12V 4000 配件</a>
          <a href="/products/mtu-4000-series-parts/16v-4000-engine-parts/" class="footer-link">MTU 16V 4000 配件</a>
          <a href="/products/mtu-series-8000-engines/" class="footer-link">MTU 8000 系列配件</a>
          <a href="/products/mtu-spare-parts/mtu-engine-series-guide/" class="footer-link">MTU 柴油发动机选型指南</a>
          <a href="/series/mtu-396/" class="footer-link">MTU 396 系列汇总</a>
          <a href="/series/mtu-2000/" class="footer-link">MTU 2000 系列汇总</a>
          <a href="/series/mtu-1163/" class="footer-link">MTU 1163 系列汇总</a>
          <a href="/series/mtu-4000-variants/" class="footer-link">MTU 4000 变型解码</a>
          <a href="/series/mtu-396-variants/" class="footer-link">MTU 396 变型说明</a>
          <a href="/series/mtu-2000-variants/" class="footer-link">MTU 2000 变型说明</a>
          <a href="/part-products/" class="footer-link">MTU 零件号总目录</a>
          <a href="/catalog/" class="footer-link">MTU 目录 PDF 下载</a>
          <a href="/cross-reference/" class="footer-link">零件号交叉引用</a>
          <a href="/part-number-index/" class="footer-link">零件号总索引</a>
          <a href="/products/mtu-spare-parts/mtu-genset-parts-by-power/" class="footer-link">按功率查发电机组配件</a>
          <a href="/products/mtu-spare-parts/mtu-overhaul-kits/" class="footer-link">大修包</a>
          <a href="/products/mtu-spare-parts/mtu-1600-series-parts/" class="footer-link">1600 系列与 F 构型</a>
          <a href="/products/mtu-spare-parts/mtu-legacy-gas-engine-parts/" class="footer-link">经典系列与燃气机</a>
          <a href="/part-products/catalog/mtu-cylinder-heads/" class="footer-link">气缸盖与缸盖罩</a>
          <a href="/part-products/catalog/mtu-fasteners-retaining-rings/" class="footer-link">紧固件与卡环</a>
          <a href="/part-products/catalog/mtu-tools-service-supplies/" class="footer-link">专用工具与耗材</a>
          <a href="/engine-models/" class="footer-link">按型号查零件清单</a>
          <a href="/guides/" class="footer-link">发动机配件指南</a>
          <a href="/guides/how-to-read-mtu-parts-diagram/" class="footer-link">零件图识读</a>
          <a href="/how-to-source-mtu-parts/" class="footer-link">经销商与独立供应商对比</a>
          <a href="/part-products/catalog/mtu-injectors/" class="footer-link">MTU 喷油器</a>
          <a href="/part-products/catalog/mtu-fuel-pumps/" class="footer-link">MTU 燃油泵</a>
          <a href="/part-products/catalog/mtu-filters/" class="footer-link">MTU 滤清器</a>
          <a href="/part-products/catalog/mtu-gasket-kits/" class="footer-link">MTU 垫片包</a>
          <a href="/part-products/catalog/mtu-turbocharger-parts/" class="footer-link">MTU 涡轮增压配件</a>
          <a href="/part-products/catalog/mtu-starter-motors-alternators/" class="footer-link">MTU 起动机与发电机</a>
          <a href="/products/detroit-diesel-parts/" class="footer-link">Detroit Diesel 配件</a>
          <a href="/products/cummins-parts/" class="footer-link">Cummins 配件</a>
          <a href="/products/deutz-parts/" class="footer-link">DEUTZ 配件</a>
          <a href="/standing-parts/" class="footer-link">在售系列清单</a>
        </div>
        <div class="footer-nav-col">
          <p class="footer-nav-label">服务与支持</p>
          <a href="/capabilities/mtu-engine-parts/" class="footer-link">MTU 发动机配件</a>
          <a href="/capabilities/industrial-engine-service/" class="footer-link">工业发动机服务</a>
          <a href="/capabilities/marine-engine-service/" class="footer-link">船用服务</a>
          <a href="/capabilities/genuine-oem-parts/" class="footer-link">原厂配套核验采购</a>
          <a href="/capabilities/" class="footer-link">全部服务</a>
        </div>
        <div class="footer-nav-col">
          <p class="footer-nav-label">应用领域</p>
          <a href="/industries/marine/" class="footer-link">船用</a>
          <a href="/industries/industrial-engines/" class="footer-link">工业发动机</a>
          <a href="/industries/power-generation/" class="footer-link">发电</a>
          <a href="/industries/rail/" class="footer-link">轨交</a>
          <a href="/industries/shipyards-repair/" class="footer-link">船厂与维修</a>
        </div>
        <div class="footer-nav-col">
          <p class="footer-nav-label">公司</p>
          <a href="/about/" class="footer-link">关于国晁动力</a>
          <a href="/certifications/" class="footer-link">质量政策</a>
          <a href="/contact/" class="footer-link">联系我们</a>
          <a href="/privacy/" class="footer-link">隐私政策</a>
          <a href="/sitemap/" class="footer-link">网站地图</a>
        </div>
      </nav>
      <div class="footer-nav-meta">
        <a href={`mailto:${site.email}`} class="footer-link footer-link--email">{site.email}</a>
        <a href={`tel:${site.phone.replace(/\s/g, '')}`} class="footer-link footer-link--email">{site.phoneDisplay}</a>
        <button type="button" class="footer-link footer-link--email footer-link--wechat" id="footer-wechat-btn">微信：{site.wechat}</button>
      </div>
    </div>
  </div>
</footer>

<script>
  // 微信入口：通知 ContactDock 打开弹层（跨组件用 window 自定义事件通信）
  document.getElementById('footer-wechat-btn')?.addEventListener('click', () => {
    window.dispatchEvent(new CustomEvent('gc:open-wechat'));
  });
</script>
